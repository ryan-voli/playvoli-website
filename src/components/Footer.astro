<style>
    .footer {
        padding: 3rem 2rem;
        padding-bottom: calc(3rem + env(safe-area-inset-bottom));
        text-align: center;
        border-top: 1px solid var(--glass-border);
    }

    .footer-columns {
        display: flex;
        justify-content: center;
        gap: 4rem;
        margin-bottom: 2rem;
        text-align: left;
    }

    .footer-col {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .footer-col-title {
        color: var(--text-primary);
        font-size: 0.8rem;
        font-weight: 650;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        margin-bottom: 0.25rem;
    }

    .footer-col-title-link {
        text-decoration: none;
        transition: opacity 0.2s;
    }

    .footer-col-title-link:hover {
        opacity: 0.8;
    }

    .footer-col a {
        color: var(--text-muted);
        font-size: 0.85rem;
        text-decoration: none;
        transition: color 0.2s;
    }

    .footer-col a:hover {
        color: var(--text-secondary);
    }

    .social-icons {
        display: flex;
        justify-content: center;
        gap: 1.25rem;
        margin-bottom: 1.5rem;
    }

    .social-icons a {
        color: var(--text-muted);
        transition: color 0.2s;
    }

    .social-icons a:hover {
        color: var(--text-primary);
    }

    .social-icons svg {
        width: 22px;
        height: 22px;
    }

    .footer-copyright {
        color: var(--text-muted);
        font-size: 0.75rem;
    }

    @media (max-width: 480px) {
        .footer-columns {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 1.5rem 2rem;
        }

        .footer-col-title {
            font-size: 0.75rem;
        }

        .footer-col a {
            font-size: 0.8rem;
        }
    }
</style>
