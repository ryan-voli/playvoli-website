---
// Keeps the Bracket Challenge's status line right between deploys. The pages
// print the build day's line; this re-reads the calendar (Central Time, the
// contest's clock) on each visit, rewrites every [data-bracket-status] node,
// stamps the phase on <html>, and once picks lock swaps in each
// [data-bracket-after] line and takes the promos down.
// Include it once per page, after the markup it updates.
import { BRACKET_CLOCK } from '../lib/bracket-facts';
---
<script is:inline define:vars={{ clock: BRACKET_CLOCK }}>
(function () {
    var day;
    try {
        day = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Chicago', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date());
    } catch (e) { return; }
    if (!/^\d{4}-\d{2}-\d{2}$/.test(day)) return;
    var phase = day < clock.fieldOn ? 'soon'
        : day === clock.fieldOn ? 'today'
        : day < clock.firstMatchOn ? 'open'
        : day === clock.firstMatchOn ? 'lockday'
        : day <= clock.finalOn ? 'locked' : 'over';
    if (clock.lockAt && day <= clock.finalOn && Date.now() >= Date.parse(clock.lockAt)) phase = 'locked';
    document.documentElement.setAttribute('data-bracket-phase', phase);
    document.querySelectorAll('[data-bracket-status]').forEach(function (el) {
        var line = clock.status[phase][el.getAttribute('data-bracket-status')];
        if (line && el.textContent !== line) el.textContent = line;
    });
    var after = phase === 'locked' || phase === 'over';
    if (after) {
        document.querySelectorAll('[data-bracket-after]').forEach(function (el) {
            el.textContent = el.getAttribute('data-bracket-after');
            el.removeAttribute('data-bracket-after');
        });
        document.querySelectorAll('[data-bracket-promo]').forEach(function (el) { el.hidden = true; });
        document.querySelectorAll('[data-bracket-promo-host]').forEach(function (el) { el.removeAttribute('data-bracket-promo-host'); });
    }
})();
</script>
