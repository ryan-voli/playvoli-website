---
// Steps: numbered, each with a short title in the display face and a
// sentence or two, stepping down the slope. It goes straight into a Band (it
// levels its own steps). Two to four steps.
//
//   <Steps items={BRACKET_STEPS} />              items: { title, text }
import { emWidth } from '../../lib/designer-metrics';

interface Props {
  items: { title: string; text: string }[];
  /** The step titles' heading tag: one level under the band's title. Default h3. */
  as?: 'h3' | 'h4';
  class?: string;
}
const { items, as: Tag = 'h3', class: cls } = Astro.props;
if (items.length < 2 || items.length > 4) throw new Error('Steps: two to four steps (use two Steps for more)');
items.forEach((i) => emWidth(i.title));
const n = items.length;
const style = `--cols:repeat(${n}, minmax(0, 1fr));${Array.from({ length: n }, (_, i) => `--f${i + 1}:${Math.round(1000 / n) / 1000}`).join(';')}`;
---
<ol class:list={['cols', 'steps', cls]} data-n={n} style={style}>
    {items.map((s, i) => (
        <li>
            <span class="steps__n" aria-hidden="true">{i + 1}</span>
            <Tag class="steps__t">{s.title}</Tag>
            <p>{s.text}</p>
        </li>
    ))}
</ol>
