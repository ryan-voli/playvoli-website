---
// Small figures set big: Pearl's .minis, a figure and what it counts.
//
//   <Minis items={[{ value: '18,000+', label: 'honors, back to 1979' }, ...]} />
import Nb from './Nb.astro';
import { fig } from './util';
interface Props {
  items: { value: string; label: string }[];
  class?: string;
}
const { items, class: cls } = Astro.props;
---
<ul class:list={['minis', cls]}>
    {items.map((i) => <li class="stat"><strong class="stat__n" set:html={fig(i.value)} />{' '}<span class="stat__l"><Nb text={i.label} /></span></li>)}
</ul>
