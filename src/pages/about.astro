---
// About VOLI: who makes the app, what it holds, who it works with, what is
// next, the questions people ask and how to reach the team. One page in six
// sections; the old /faq, /contact, /whats-next and /partners addresses
// redirect to #faq, #contact, #whats-next and #partners, so those ids stay.
// Every number and answer comes from lib/voli-facts and lib/bracket-facts.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/about.css';
import Arrow from '../components/pearl/kit/Arrow.astro';
import Badge from '../components/pearl/kit/Badge.astro';
import Band from '../components/pearl/kit/Band.astro';
import Btn from '../components/pearl/kit/Btn.astro';
import Card from '../components/pearl/kit/Card.astro';
import Cell from '../components/pearl/kit/Cell.astro';
import Cols from '../components/pearl/kit/Cols.astro';
import Copy from '../components/pearl/kit/Copy.astro';
import Dates from '../components/pearl/kit/Dates.astro';
import Faq from '../components/pearl/kit/Faq.astro';
import GetApp from '../components/pearl/kit/GetApp.astro';
import LinkList from '../components/pearl/kit/LinkList.astro';
import Note from '../components/pearl/kit/Note.astro';
import PageHero from '../components/pearl/kit/PageHero.astro';
import Phone from '../components/pearl/kit/Phone.astro';
import Split from '../components/pearl/kit/Split.astro';
import Stack from '../components/pearl/kit/Stack.astro';
import Sticker from '../components/pearl/kit/Sticker.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import Tickets from '../components/pearl/kit/Tickets.astro';
import { DOWNLOADS, DOWNLOADS_AS_OF, FACTS, FACTS_AS_OF, FAQS, faqSchema } from '../lib/voli-facts';
import { BRACKET, BRACKET_DATES, BRACKET_STATUS, bracketPhase } from '../lib/bracket-facts';
import { INDEPENDENCE, SITE_URL, SOCIAL_LINKS } from '../lib/site';
import { SCREENS } from '../lib/screens';
import { emWidth } from '../lib/designer-metrics';

const PAGE_URL = `${SITE_URL}/about`;
const TITLE = 'About VOLI: The Volleyball App Built by Fans, for Fans';
const DESCRIPTION =
  'Meet the fans who make VOLI, the free volleyball app for NCAA, MLV and LOVB on iPhone and Android: the numbers, partners, what is next, FAQ and how to reach us.';

const subnav = {
  label: 'About VOLI',
  items: [
    { href: '#story', label: 'Our story', short: 'Story' },
    { href: '#numbers', label: 'Numbers' },
    { href: '#partners', label: 'Partners' },
    { href: '#whats-next', label: "What's next", short: 'Next' },
    { href: '#faq', label: 'FAQ' },
    { href: '#contact', label: 'Contact' },
  ],
};

// VOLI by the numbers. Each figure is said again in a sentence that can be
// quoted on its own, so the figure itself is hidden from screen readers.
// The FACTS figures come first in their own words; the rest are the counts
// already published on the site. Fantasy leads, as it does wherever the
// app's features are listed.
const fact = (label: string) => FACTS.find((f) => f.label === label)!.value;
const FIGURES = [
  { value: '10', text: 'An NCAA fantasy volleyball season on VOLI runs in 10 rounds, each from Wednesday to Sunday.' },
  { value: DOWNLOADS, text: `VOLI has ${DOWNLOADS} downloads on iPhone and Android, as of ${DOWNLOADS_AS_OF}.` },
  { value: fact('college and pro matches since 2023'), text: 'VOLI covers more than 18,700 college and pro volleyball matches played since 2023.' },
  { value: fact('NCAA player box-score lines'), text: 'VOLI holds nearly 500,000 NCAA player box-score lines.' },
  { value: fact('of Division I matches since 2023 with a box score'), text: "VOLI has a box score for 99.8% of completed NCAA Division I women's matches since 2023." },
  { value: '445', text: 'All 445 MLV and LOVB matches in VOLI have play-by-play, with each rally, substitution and the rotation on court.' },
  { value: fact('honors in the Volleyball Encyclopedia, back to 1979'), text: 'The Volleyball Encyclopedia in VOLI holds more than 18,000 honors, back to 1979.' },
  { value: '3,000+', text: 'The Volleyball Encyclopedia lists more than 3,000 AVCA All-America selections since 1981.' },
  { value: '45', text: 'The Volleyball Encyclopedia has all 45 NCAA champions.' },
  { value: '13', text: 'VOLI carries 13 volleyball podcasts to stream or download.' },
  { value: '900+', text: 'The podcasts in VOLI have more than 900 episodes, with your place saved across devices.' },
  { value: '20', text: 'VOLI gathers volleyball news from 20 outlets, with each story linked to its source.' },
].map((f) => {
  // Designer has no tilde: a leading "~" is set in the text face.
  const pre = f.value.startsWith('~') ? '~' : '';
  return { ...f, pre, rest: f.value.slice(pre.length) };
});
const FIG_EM = Math.max(...FIGURES.map((f) => emWidth(f.rest) + (f.pre ? 0.45 : 0)));

// The roadmap. The Bracket Challenge row is marked from the contest's own
// calendar on the day the page is built.
const phase = bracketPhase();
const ROADMAP = [
  {
    iso: '2024-03', when: 'March 2024', what: 'FantasyVB begins', tag: 'Done',
    detail: 'FantasyVB started as a test bed for one question: could a real fantasy volleyball game work? It compared fantasy formats to find the one that fits volleyball, shaped a scoring system that is fair to every position and settled the technology, with classes in full-stack development alongside. The answer was yes, with a plan for what shipping it would take.',
  },
  {
    iso: '2025-01', when: 'January 2025', what: 'VOLI app begins', tag: 'Done',
    detail: 'The project grew beyond fantasy. The stats, player profiles and schedules that fantasy needed became a full hub for U.S. pro volleyball, simplest parts first. Fantasy came next, tested in simulations against two years of MLV data and one year of LOVB data. Podcast discovery and support tools came just before launch, so fans could find and back the creators growing the sport.',
  },
  {
    iso: '2026-01', when: 'January 2026', what: 'App beta launch', tag: 'Done',
    detail: 'VOLI went public with MLV fantasy for the 2026 pro season, with real managers instead of simulations. Partnerships with Major League Minute, Volley Talk and Court Captains brought in the fans most likely to put the app through its paces. The season closed with 1,300+ downloads and lessons on scoring, contract rules and the fantasy week that shaped everything after, starting with a scoring system rebuilt for the college game.',
  },
  {
    iso: '2026-08', when: 'August 2026', what: 'NCAA fantasy launch', tag: 'Done', href: '/fantasy',
    detail: "Fantasy came to NCAA Division I women's volleyball, tuned for the college game with simpler scoring. The 2026 season ran in ten rounds, each Wednesday to Sunday, with Monday and Tuesday as the signing window.",
  },
  {
    iso: '2026-11', when: 'November 2026', what: BRACKET.name, tag: phase === 'over' ? 'Done' : 'On now', href: BRACKET.path,
    detail: "A free bracket game for the NCAA Division I women's volleyball tournament: pick the winner of all 63 matches and follow a live leaderboard, against everyone or in a group with your friends.",
  },
  {
    iso: '2027-01', when: 'January 2027', what: 'LOVB fantasy launch', tag: 'Next',
    detail: "LOVB joins VOLI's fantasy game, so managers can run teams in both pro leagues. VOLI has carried LOVB stats, schedules and player profiles from the start: fantasy is the piece still to come.",
  },
];

// Contact: one address, and a link per topic that starts an email to it with
// the subject filled in. There is no form: every link opens the visitor's mail app.
const EMAIL = 'support@playvoli.com';
const mailto = (subject: string, body?: string) =>
  `mailto:${EMAIL}?subject=${encodeURIComponent(subject)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;
const TOPICS = [
  { href: mailto('General question'), label: 'General question' },
  { href: mailto('App support', 'Phone and model:\nWhat happened:\n'), label: 'App support' },
  { href: mailto('Feature request'), label: 'Feature request' },
  { href: mailto('Partnership'), label: 'Partnership' },
  { href: mailto('Press'), label: 'Press' },
  { href: mailto('Investor inquiry'), label: 'Investor inquiry' },
];
const [MAIL_A, MAIL_B] = [EMAIL.slice(0, EMAIL.indexOf('@') + 1), EMAIL.slice(EMAIL.indexOf('@') + 1)];
const HANDLES: Record<string, string> = {
  Instagram: '@playvoli',
  TikTok: '@playvoli',
  YouTube: '@watchvoli',
  Facebook: 'thevolleyballhub',
  Reddit: 'r/playvoli',
};

// Of the ten questions shown here, these two are marked up on this page; the
// others are marked up on the pages that answer them in full.
const marked = ['leagues', 'bracket'].map((id) => FAQS.find((f) => f.id === id)!);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${PAGE_URL}#webpage`,
    url: PAGE_URL,
    name: TITLE,
    description: DESCRIPTION,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    about: { '@id': `${SITE_URL}/#organization` },
    mainEntity: { '@id': `${SITE_URL}/#organization` },
    inLanguage: 'en-US',
  },
  faqSchema(marked, PAGE_URL),
];
---

<Pearl title={TITLE} description={DESCRIPTION} section="about" subnav={subnav} schema={schema}>
    <link rel="preload" as="image" href={SCREENS.games.src} type="image/webp" fetchpriority="high" slot="head" />

    <PageHero color="rose" label={['About VOLI:', 'The Volleyball Hub.']} lines={[{ text: 'For fans,', hollow: true }, 'by fans.']}>
        <p class="lede">VOLI: The Volleyball Hub is made by two volleyball fans, Ryan and Max, for everyone who follows NCAA <span class="nb">Division I</span> women's volleyball, MLV and LOVB. Free on iPhone and Android.</p>
        <Stores />
        {/* Two phones, the downloads chip over the second, and a chat card
            lifted in front of both. */}
        <Stack slot="art" ratio="100/106">
            <Badge value={DOWNLOADS} label="downloads" x={66} xm={60} y={46} ym={44} z={3} shadow="lime" />
            <Phone screen="games" x={4} xm={2} y={0} w={44} wm={46} r={-3.75} z={2} priority />
            <Phone screen="encyclopedia" x={52} y={10} w={44} wm={46} r={7.5} eager />
            <Sticker cut="float-chat" x={10} xm={4} y={72} w={66} wm={80} r={-3.75} z={3} shadow="white" />
        </Stack>
    </PageHero>

    {/* 1. Who makes VOLI, and what it is. */}
    <Band color="lime" id="story" kicker="The fans" title="behind VOLI" pt={5}>
        <Cols ratio="40:52" drop={[0, 2]}>
            <Copy>
                <p class="lede">VOLI is a free volleyball app for iPhone and Android with <a class="link" href="/fantasy">fantasy volleyball</a>, live scores and box scores, stats, <a class="link" href="/rankings">the VOLI Top 100</a>, volleyball history, news and podcasts in one place. VOLI is made for fans of NCAA <span class="nb">Division I</span> women's volleyball, Major League Volleyball (MLV) and LOVB.</p>
                <p class="body">Every part of the app, feature by feature, is on <a class="link" href="/">the VOLI home page</a>. VOLI also makes the <a class="link" href="/discordbot">VOLI Discord Bot</a>, which brings fantasy leaderboards, live scores, stat leaders and transaction tracking to Discord servers.</p>
            </Copy>
            <div>
                <div class="abt-founders">
                    <Card name="Ryan" kicker="Founder" ratio="1 / 1" img={{ src: '/images/founders/ryan.webp', width: 384, height: 384, alt: 'Ryan, founder of VOLI' }}>
                        <p>Ryan built VOLI from the ground up, teaching himself full-stack development to do it, and works full-time in cybersecurity and software engineering. He fell in love with volleyball watching his sister play in college. She graduated just as the U.S. pro leagues launched, and he saw a sport with the talent and the fans, but without the digital tools to match. VOLI is his answer.</p>
                    </Card>
                    <Card name="Max" kicker="Co-founder" ratio="1 / 1" shadow="blue" img={{ src: '/images/founders/max.webp', width: 384, height: 384, alt: 'Max, co-founder of VOLI' }}>
                        <p>Max runs the business and operations side of VOLI, drawing on project management and server administration from his day job. He and Ryan met in the Air Force a decade ago and have been close friends since: they live on opposite sides of the world, and Max stood in Ryan's wedding. When VOLI grew bigger than one person could handle, Max stepped in so Ryan could stay focused on building the app. He believes in his friend, and that a sport this good deserves software to match.</p>
                    </Card>
                </div>
            </div>
        </Cols>
        <Cols ratio="1:1" drop={[0, 2]}>
            <div class="abt-point">
                <h3 class="h3">Where VOLI's numbers come from</h3>
                <p class="body">VOLI's stats, scores and its own ratings are built from publicly available facts about games, players and teams, with VOLI's own software. <a class="link" href="/methods">How VOLI's numbers work</a> explains where the data comes from, how often it updates, and how the VOLI Top 100 and each match's chance to win are worked out.</p>
            </div>
            <div class="abt-point">
                <h3 class="h3">Independent of the leagues</h3>
                <p class="body">{INDEPENDENCE} VOLI is made by volleyball fans, for volleyball fans. Leagues and teams that want to work with VOLI can <a class="link" href="#contact">write to the team</a>.</p>
            </div>
        </Cols>
    </Band>

    {/* 2. The counts, each in a sentence of its own. */}
    <Band color="ink" id="numbers" kicker="VOLI by" title="the numbers" tone="lime" stamp={`As of ${FACTS_AS_OF}`}>
        <Cols ratio="1:1:1" as="ul" class="abt-figs" style={`--em:${FIG_EM}`}>
            {FIGURES.map((f) => (
                <li>
                    <strong class="abt-fig" aria-hidden="true">{f.pre && <span class="abt-tilde">{f.pre}</span>}{f.rest}</strong>
                    <p class="abt-fact">{f.text}</p>
                </li>
            ))}
        </Cols>
    </Band>

    {/* 3. Partners: their work is in the app. */}
    <Band color="blue" id="partners" title="Our partners">
        <Cols max="38rem">
            <p class="lede">Four partners bring their work into VOLI: two volleyball podcasts, college volleyball analytics from EVOLLVE and transfer news from College Volleyball Transfers.</p>
        </Cols>
        {/* Two pairs: the podcasts, then analytics and transfers. Four across on
            a wide screen, two by two on a tablet, one under another on a phone. */}
        <Cols ratio="1:1" drop={[0, 2]} class="abt-partners">
            <div class="cardgrid">
                <Card name="Volley Talk" kicker="Podcast partner" href="/volleytalk" cta="Volley Talk on VOLI" track="partner_card:volleytalk" logo img={{ src: '/images/partners/volleytalk-cover-sm.webp', width: 160, height: 160, alt: 'Volley Talk with Sarah Pavan podcast cover' }}>
                    <p>Volley Talk is a podcast on NCAA and international volleyball, hosted by Sarah Pavan, an Olympian, World Champion and former Nebraska All-American, and her husband Adam Schulz, an international volleyball coach and stats wizard. Each week: highlights, feature match breakdowns and hot takes from decades at the highest level.</p>
                </Card>
                <Card name="Major League Minute" kicker="Podcast partner" href="/mlm" cta="MLM on VOLI" track="partner_card:mlm" logo ground="white" img={{ src: '/images/partners/mlm-cover-sm.webp', width: 160, height: 160, alt: 'Major League Minute podcast logo' }}>
                    <p>Major League Minute is a quick-hitting podcast on Major League Volleyball with Nick Prososki (Doc) and Gina <span class="nb">Mancuso-Prososki</span> (GMP), a former Nebraska and Omaha Supernovas player. They break down the biggest games, key performances and headlines, and host exclusive player Ask Me Anythings with VOLI in the app.</p>
                </Card>
            </div>
            <div class="cardgrid">
                <Card name="EVOLLVE" kicker="Analytics partner" href="/evollve" cta="EVOLLVE on VOLI" track="partner_card:evollve" logo img={{ src: '/images/partners/evollve-ball.webp', width: 256, height: 256, alt: 'The EVOLLVE logo, a volleyball' }}>
                    <p>EVOLLVE builds advanced analytics for college volleyball. Its nightly ratings for every <span class="nb">Division I</span> team, player impact numbers like RAPM and match predictions are built into VOLI, from the Stats page to every team, player and game.</p>
                </Card>
                <Card name="College Volleyball Transfers" kicker="Transfer portal partner" href="/cvt" cta="CVT on VOLI" track="partner_card:cvt" logo ground="white" img={{ src: '/images/partners/cvt-mark-light.svg', width: 254, height: 260, alt: 'The College Volleyball Transfers mark' }}>
                    <p>College Volleyball Transfers tracks moves in women's college volleyball across the divisions: who enters the portal, where they commit, and the full transfer list each season. Every move their desk verifies lands in VOLI's Transfer Portal, with the player, the school and where they are headed.</p>
                </Card>
            </div>
        </Cols>
        <Cols max="44rem">
            <p class="body abt-leagues">Both podcasts run a public fantasy league on VOLI that anyone can join: <a class="link" href="/volleytalk">the Volley Talk league</a> and <a class="link" href="/mlm">the Major League Minute league</a>. You can also listen to <a class="link" href="/courtcaptains">Court Captains</a>, a podcast on MLV with Kelly, Nikki and Ian, in VOLI.</p>
        </Cols>
    </Band>

    {/* 4. The roadmap, and what is on right now. */}
    <Split ground="rose">
        <Cell color="ink" id="whats-next" lines={["What's", 'next', { text: 'for VOLI', size: 'sm', hollow: true }]} em="next" tone="lime">
            <p class="body">VOLI began as a fantasy volleyball test bed in 2024. The dates below are where it has been and where it goes next.</p>
            <Dates narrow class="abt-roadmap" items={ROADMAP} />
            <p class="small">New dates go on this list as they are set.</p>
        </Cell>
        <Cell color="rose" as="h3" lines={[{ text: 'College Volleyball', size: 'sm', hollow: true }, 'Bracket', 'Challenge']}>
            <Note><span data-bracket-status="long">{BRACKET_STATUS[phase].long}</span></Note>
            <p class="lede">Pick the winner of all 63 matches of the NCAA <span class="nb">Division I</span> women's volleyball tournament in the free VOLI app, and follow your bracket on a live leaderboard.</p>
            <Tickets class="abt-tickets" size={3.5} label="The Bracket Challenge at a glance" items={[
              { value: BRACKET.prize, label: 'cash to the top eligible bracket' },
              { value: String(BRACKET.matches), label: 'matches to pick, free to play' },
            ]} />
            <p class="fine">No purchase necessary. 50 U.S. states &amp; D.C., 18+ (19+ AL/NE, 21+ MS). <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
            <div class="btns">
                <Btn href={BRACKET.path} track="bracket_promo:about">The Bracket Challenge</Btn>
            </div>
            <Dates narrow items={[BRACKET_DATES[0], BRACKET_DATES[1], BRACKET_DATES[BRACKET_DATES.length - 1]]} />
        </Cell>
    </Split>

    {/* 5. Every question about VOLI. Only "leagues" and "bracket" are marked up here. */}
    <Band color="lime" id="faq" title="Questions" sub="about VOLI">
        <Faq items={FAQS}>
            <LinkList slot="more" label="More answers" items={[
              { href: '/fantasy#faq', label: 'Fantasy questions' },
              { href: '/bracket#faq', label: 'Bracket Challenge questions' },
              { href: '/methods', label: "How VOLI's numbers work" },
            ]} />
        </Faq>
    </Band>

    {/* 6. How to reach the team. Email only: there is no form. */}
    <Band color="ink" id="contact" lines={[{ text: 'Contact the VOLI team', size: 'sm' }]}>
        <p class="abt-mail" style={`--em:${emWidth(EMAIL)};--em-m:${Math.max(emWidth(MAIL_A), emWidth(MAIL_B))}`}><a href={`mailto:${EMAIL}`}><span>{MAIL_A}</span><span>{MAIL_B}</span></a></p>
        <Cols ratio="52:40" drop={[0, 2]}>
            <Copy>
                <p class="lede">Email the VOLI team at <a class="link" href={`mailto:${EMAIL}`}>{EMAIL}</a> about anything: the app, a partnership, press or investing. Pick a topic to start an email with the subject filled in.</p>
                <LinkList label="Email us about" items={TOPICS} />
                <p class="body">For app support, tell us which phone you use (iPhone or Android, and the model) and what happened, step by step.</p>
            </Copy>
            <div class="abt-follow">
                <p class="label">Follow VOLI</p>
                <ul class="abt-social">
                    {SOCIAL_LINKS.map((s) => (
                        <li><a href={s.href} target="_blank" rel="noopener"><span class="abt-social__n">{s.name}</span>{' '}<span class="abt-social__h">{HANDLES[s.name]}</span><Arrow /></a></li>
                    ))}
                </ul>
            </div>
        </Cols>
    </Band>

    <GetApp color="blue" links={[
      { href: '/', label: 'Everything in VOLI' },
      { href: '/fantasy', label: 'Fantasy volleyball' },
      { href: '/bracket', label: 'Bracket Challenge' },
      { href: '/rankings', label: 'VOLI Top 100' },
      { href: '/methods', label: "How VOLI's numbers work" },
    ]} />
</Pearl>
