---
// /get — the PAID SEARCH landing page.
//
// Deliberately separate from /download. That page server-side 302s
// straight to the store, which is perfect for an Instagram bio link and
// unusable for ads on two counts: Google prohibits off-domain redirects
// in the Final URL field (and a UA-sniffing auto-redirect can read as
// cloaking), and the redirect fires before any JavaScript runs, so a
// conversion tag on it could never report anything.
//
// This page renders, makes the case, and fires the conversion on an
// explicit store tap — which is a better measurement point anyway: a
// deliberate tap, not a page load.
import Layout from '../layouts/Layout.astro';

const APP_STORE = 'https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982';
const PLAY_STORE = 'https://play.google.com/store/apps/details?id=com.playvoli.app';

// Google Ads conversion label. Create the "Store tap" conversion action
// in Google Ads (count: ONE, not Every) and paste its label here — the
// AW- account id is already loaded sitewide by Layout.astro.
// Until this is set, taps still navigate; they just aren't counted.
const CONVERSION_LABEL = '';
const CONVERSION_SEND_TO = CONVERSION_LABEL
  ? `AW-17868194042/${CONVERSION_LABEL}`
  : '';

// Fantasy Round 1 opens Wed 9 Sep 2026 (Pacific). Monday and Tuesday
// before it are the signing window, so the honest deadline for having a
// team that scores in round 1 is the end of Tue 8 Sep, Pacific.
const SIGNING_DEADLINE_ISO = '2026-09-09T07:00:00Z'; // Wed 9 Sep 00:00 PT
---

<Layout
  title="Get VOLI — NCAA Volleyball Scores, Stats & Fantasy"
  description="Live NCAA women's volleyball scores, box scores, team and player stats, AVCA rankings — and the only fantasy college volleyball league. Free on iOS and Android."
  ogUrl="https://playvoli.com/get"
  showFooter={false}
  skipSupabase
  skipNavAuth
  bodyClass="ad-landing"
>
  <main class="lp">

    <div class="top">
      <header class="brand">
        <div class="brand-lockup">
          <img src="/images/logo_dark_sm.webp" alt="" width="52" height="52" class="brand-mark" />
          <span class="brand-word">VOLI</span>
        </div>
        <p class="brand-tag">The Volleyball Hub</p>
      </header>

      <p class="deadline" id="deadline" hidden>
        <span class="dot" aria-hidden="true"></span>
        <span id="deadline-text"></span>
      </p>

      <h1>Every NCAA volleyball score, live.</h1>

      <p class="sub">
        Box scores, team and player stats, the AVCA Top&nbsp;25 —
        plus fantasy college volleyball. Free.
      </p>

      <div class="cta">
        <a href={APP_STORE} class="btn btn-primary" data-store="ios" id="btn-ios">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
          </svg>
          <span>Download for iPhone</span>
        </a>

        <a href={PLAY_STORE} class="btn btn-primary" data-store="android" id="btn-android">
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
          </svg>
          <span>Download for Android</span>
        </a>
      </div>

      <p class="trust">Free · No subscription · iOS &amp; Android</p>
    </div>

    <!-- Proof, not content. These are allowed to run off the bottom
         edge: nothing below the fold has to be read, so the crop is a
         composition choice rather than hidden information. -->
    <div class="proof" aria-hidden="true">
      <img src="/images/ad-live.webp" alt="" width="700" height="1400" fetchpriority="low" decoding="async" />
      <img src="/images/ad-rankings.webp" alt="" width="700" height="1400" fetchpriority="low" decoding="async" />
    </div>

  </main>

  <script is:inline slot="scripts" define:vars={{ CONVERSION_SEND_TO, SIGNING_DEADLINE_ISO }}>
    (function () {
      // ---- Platform-aware ordering (NOT a redirect) -------------------
      // The page must render for everyone; detection only decides which
      // button leads. iPadOS 13+ reports a desktop Safari UA, so the
      // plain iPad test misses modern iPads — they identify as Macintosh
      // with touch support.
      var ua = navigator.userAgent || '';
      var isIOS = /iPad|iPhone|iPod/i.test(ua) ||
        (/Macintosh/i.test(ua) && 'ontouchend' in document);
      var isAndroid = /android/i.test(ua);

      var ios = document.getElementById('btn-ios');
      var android = document.getElementById('btn-android');
      if (isAndroid && ios && android) {
        android.parentNode.insertBefore(android, ios);
        ios.classList.remove('btn-primary');
        ios.classList.add('btn-secondary');
      } else if (isIOS && android) {
        android.classList.remove('btn-primary');
        android.classList.add('btn-secondary');
      }

      // ---- Deadline line ----------------------------------------------
      // Real deadline, not manufactured urgency: fantasy round 1 opens
      // Wed 9 Sep, and the signing window closes the night before.
      // Hidden entirely once it passes so the page never reads stale.
      var deadline = new Date(SIGNING_DEADLINE_ISO);
      var msLeft = deadline.getTime() - Date.now();
      if (msLeft > 0) {
        var days = Math.ceil(msLeft / 86400000);
        var el = document.getElementById('deadline');
        var txt = document.getElementById('deadline-text');
        if (el && txt) {
          txt.textContent = days <= 1
            ? 'Fantasy round 1 opens tomorrow — sign your team tonight'
            : 'Fantasy round 1 opens in ' + days + ' days';
          el.hidden = false;
        }
      }

      // ---- Store tap -> Google Ads conversion ---------------------------
      // Fired on the TAP, never on page load: a page-load conversion
      // counts bounces and inflates everything.
      //
      // The callback matters. A bare gtag() call can be killed by the
      // page unload before the beacon leaves, so navigation waits for
      // the callback — but if gtag is blocked (ad blockers are common on
      // exactly this audience) the callback never fires and the visitor
      // is stranded on a dead button. Hence the timeout: measurement
      // must never cost us the download.
      function go(url) { window.location.href = url; }

      document.querySelectorAll('a[data-store]').forEach(function (a) {
        a.addEventListener('click', function (e) {
          var url = a.getAttribute('href');
          var store = a.getAttribute('data-store');

          if (typeof plausible === 'function') {
            plausible('Ad Landing Store Tap', { props: { store: store } });
          }
          if (typeof gtag === 'function') {
            gtag('event', 'click', {
              event_category: 'download',
              event_label: store === 'ios' ? 'app_store' : 'play_store',
              source: 'ad_landing'
            });
          }

          if (!CONVERSION_SEND_TO || typeof gtag !== 'function') return; // let the link work normally

          e.preventDefault();
          var done = false;
          var fire = function () { if (!done) { done = true; go(url); } };
          setTimeout(fire, 900); // hard fallback — never strand the visitor
          gtag('event', 'conversion', {
            send_to: CONVERSION_SEND_TO,
            event_callback: fire
          });
        });
      });
    })();
  </script>
</Layout>

<style is:global>
  /* A PAID LANDING PAGE, NOT A SITE PAGE. One screen, one job, no
     scroll. Every exit path and every second screenful is a place the
     visitor can go that isn't the App Store. */

  /* The whole nav goes, not just the links — keeping a nav bar would
     eat viewport height we need and hand back the exit paths. The app
     icon in the page is the brand mark. */
  body.ad-landing .nav-container { display: none !important; }

  body.ad-landing {
    overflow: hidden;
    height: 100dvh;
  }

  body.ad-landing .lp {
    height: 100dvh;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: max(20px, env(safe-area-inset-top)) 20px 0;
    overflow: hidden;
  }

  body.ad-landing .top {
    width: 100%;
    max-width: 460px;
    flex: 0 0 auto;
  }

  /* Brand header. The store listing is "VOLI - The Volleyball Hub", and
     naming it identically here keeps the ad -> page -> store chain
     reading as one thing; a visitor who lands on a differently-named
     page is a visitor deciding whether they're in the right place. */
  body.ad-landing .brand { margin-bottom: clamp(10px, 2.4vh, 18px); }

  body.ad-landing .brand-lockup {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  body.ad-landing .brand-mark {
    width: clamp(40px, 11vw, 52px);
    height: auto;
    display: block;
  }
  body.ad-landing .brand-word {
    /* Brand lockup ratio from the nav: wordmark at 0.70x the mark. */
    font-family: 'Designer', sans-serif;
    font-size: clamp(1.75rem, 4.8vw, 2.275rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: var(--text-primary);
    /* Designer's caps sit high in the line box — nudge onto the
       optical centre of the mark beside it. */
    transform: translateY(2px);
  }
  body.ad-landing .brand-tag {
    font-size: clamp(0.72rem, 2.8vw, 0.82rem);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin: 8px 0 0;
  }

  body.ad-landing .deadline {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    background: var(--accent-subtle);
    border: 1px solid rgba(200, 255, 0, 0.28);
    color: var(--accent);
    font-size: 0.78rem;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: 999px;
    margin: 0 0 clamp(10px, 2.2vh, 16px);
  }
  body.ad-landing .deadline .dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: var(--accent); flex-shrink: 0;
  }

  body.ad-landing h1 {
    font-size: clamp(1.7rem, 7.4vw, 2.35rem);
    line-height: 1.08;
    letter-spacing: -0.028em;
    font-weight: 800;
    text-wrap: balance;
    margin: 0 0 clamp(8px, 1.6vh, 12px);
  }

  body.ad-landing .sub {
    color: var(--text-secondary);
    font-size: clamp(0.92rem, 3.6vw, 1rem);
    line-height: 1.45;
    text-wrap: pretty;
    margin: 0 auto clamp(16px, 3vh, 24px);
    max-width: 30em;
  }

  body.ad-landing .cta {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  body.ad-landing .btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: 15px 22px;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
  }
  body.ad-landing .btn svg { width: 19px; height: 19px; flex-shrink: 0; }

  body.ad-landing .btn-primary {
    background: var(--accent);
    color: #000;
    box-shadow: 0 4px 24px var(--accent-glow);
  }
  body.ad-landing .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 8px 32px var(--accent-glow); }
  body.ad-landing .btn-primary:active { transform: translateY(0); }

  body.ad-landing .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 1px solid var(--glass-border);
  }
  body.ad-landing .btn-secondary:hover { background: rgba(255, 255, 255, 0.06); }

  body.ad-landing .trust {
    color: var(--text-muted);
    font-size: 0.78rem;
    margin: clamp(10px, 2vh, 14px) 0 0;
  }

  /* Takes whatever height is left and no more. min-height 0 is what
     lets a flex child actually shrink instead of forcing a scrollbar. */
  body.ad-landing .proof {
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    justify-content: center;
    align-items: flex-end;
    gap: clamp(10px, 3vw, 20px);
    width: 100%;
    max-width: 460px;
    margin-top: clamp(12px, 2.4vh, 22px);
  }
  body.ad-landing .proof img {
    height: 100%;
    width: auto;
    max-width: 47%;
    object-fit: contain;
    object-position: top center;
    /* Device-framed transparent art: the frame supplies the rounding,
       so shadow only — a border would draw a box around a phone. */
    filter: drop-shadow(0 12px 28px rgba(0, 0, 0, 0.55));
  }

  /* Very short viewports (landscape phones): the proof art is the first
     thing to go. The buttons must never be pushed off screen. */
  @media (max-height: 620px) {
    body.ad-landing .proof { display: none; }
    body.ad-landing .lp { justify-content: center; }
  }

  @media (prefers-reduced-motion: reduce) {
    body.ad-landing .btn { transition: none; }
    body.ad-landing .btn:hover { transform: none; }
  }
</style>
