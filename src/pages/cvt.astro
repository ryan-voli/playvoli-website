---
// College Volleyball Transfers partner page (owner, 23 Nov 2026: "the cvt
// partner page … similar to the podcast ones, it will deep link into the apps
// transfer portal and link to the site and cvts instagram and x account").
// Same v-stub card as the podcast landers. The pair shows their ball mark
// (public/images/partners/cvt-mark.svg: his cvt_mark.svg, white letters for the dark card, 23 Nov 2026).
// Handles and links match the app's CvtPartner constants
// (lib/universal/widgets/cvt_info_modal.dart).
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="College Volleyball Transfers - VOLI"
  description="College Volleyball Transfers is the desk behind VOLI's college volleyball Transfer Portal: every verified portal entry and commit, in the app as it lands. Open the portal, report a move, or follow the desk."
  ogUrl="https://playvoli.com/cvt"
  skipSupabase
  skipNavAuth
  bodyClass="landing-card-page"
>
    <script is:inline slot="scripts">
        // Track page source
        gtag('event', 'page_view', {
            'source': 'cvt',
            'partner': 'College Volleyball Transfers'
        });

        // Smart deep link handler with popup fallback
        function handleDeepLink(event, deepLink) {
            event.preventDefault();
            window.location.href = deepLink;

            setTimeout(function() {
                if (!document.hidden) {
                    showAppDownloadPopup();
                }
            }, 2000);
        }

        function showAppDownloadPopup() {
            const overlay = document.createElement('div');
            overlay.className = 'popup-overlay';

            const popup = document.createElement('div');
            popup.className = 'popup';
            popup.innerHTML = '\
                <h2>Download VOLI</h2>\
                <p>Get the VOLI app and open the Transfer Portal under Stats to follow every move College Volleyball Transfers verifies.</p>\
                <button id="close-popup">Got it</button>\
            ';

            overlay.appendChild(popup);
            document.body.appendChild(overlay);

            overlay.addEventListener('click', function(e) {
                if (e.target === overlay || e.target.id === 'close-popup') {
                    document.body.removeChild(overlay);
                }
            });

            setTimeout(function() {
                const storeButtons = document.querySelector('.store-buttons');
                if (storeButtons) {
                    storeButtons.scrollIntoView({ behavior: 'smooth', block: 'center' });
                }
            }, 300);
        }
    </script>

    <main class="v-page v-page--center">
        <div class="v-stub">
            <div class="v-stub__pair">
                <img src="/images/appicon.webp" alt="VOLI" width="64" height="64">
                <span class="v-stub__pair-x" aria-hidden="true">×</span>
                <img src="/images/partners/cvt-mark.svg" alt="College Volleyball Transfers" width="64" height="64">
            </div>

            <h1 class="v-stub__heading">College Volleyball Transfers</h1>
            <p class="v-body v-stub__sub">The desk behind VOLI's Transfer Portal. Every portal entry and commit College Volleyball Transfers verifies lands in the VOLI app, with the player, the school and where they are headed.</p>

            <div class="v-actions">
                <a href="voli://transfer-portal"
                   id="open-portal-btn"
                   onclick="handleDeepLink(event, 'voli://transfer-portal'); plausible('CVT Open Portal'); gtag('event', 'click', {'event_category': 'transfer_portal_open', 'event_label': 'cvt_lander', 'source': 'cvt'});"
                   class="v-pill v-pill--cta v-pill--action v-pill--block">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                        <polyline points="10 17 15 12 10 7"/>
                        <line x1="15" y1="12" x2="3" y2="12"/>
                    </svg>
                    Open the Transfer Portal
                </a>
                <a href="https://cvt.playvoli.com/report"
                   onclick="plausible('CVT Report'); gtag('event', 'click', {'event_category': 'transfer_portal_report', 'event_label': 'cvt_report', 'source': 'cvt'});"
                   class="v-pill v-pill--block lander-secondary">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20h9"/>
                        <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
                    </svg>
                    Report a transfer
                </a>
            </div>

            <div class="v-rule-label v-stub__divider">
                <span>Follow the desk</span>
            </div>

            <div class="cvt-links">
                <a href="https://cvt.playvoli.com" target="_blank" rel="noopener"
                   onclick="plausible('CVT Website'); gtag('event', 'click', {'event_category': 'partner_link', 'event_label': 'cvt_website', 'source': 'cvt'});"
                   class="v-pill cvt-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/>
                        <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
                    </svg>
                    Website
                </a>
                <a href="https://www.instagram.com/collegevbtransfers/" target="_blank" rel="noopener"
                   onclick="plausible('CVT Instagram'); gtag('event', 'click', {'event_category': 'partner_link', 'event_label': 'cvt_instagram', 'source': 'cvt'});"
                   class="v-pill cvt-link">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="3" width="18" height="18" rx="5"/>
                        <circle cx="12" cy="12" r="4"/>
                        <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>
                    </svg>
                    Instagram
                </a>
                <a href="https://x.com/CVBTransfers" target="_blank" rel="noopener"
                   onclick="plausible('CVT X'); gtag('event', 'click', {'event_category': 'partner_link', 'event_label': 'cvt_x', 'source': 'cvt'});"
                   class="v-pill cvt-link">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                        <path d="M18.2 2.5h3.3l-7.2 8.2 8.5 10.8h-6.7l-5.2-6.6-6 6.6H1.6l7.7-8.8L1.2 2.5H8l4.7 6.1 5.5-6.1zm-1.2 17h1.8L7.1 4.4H5.1l11.9 15.1z"/>
                    </svg>
                    X
                </a>
            </div>

            <div class="v-rule-label v-stub__divider">
                <span>Don't have the app?</span>
            </div>

            <div class="store-buttons v-stores v-stores--stack">
                <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982"
                   onclick="plausible('CVT App Store'); gtag('event', 'click', {'event_category': 'download', 'event_label': 'app_store', 'source': 'cvt'});"
                   class="v-store">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                    </svg>
                    <div>
                        <span class="v-store__small">Download on the</span>
                        <span class="v-store__big">App Store</span>
                    </div>
                </a>

                <a href="https://play.google.com/store/apps/details?id=com.playvoli.app"
                   onclick="plausible('CVT Google Play'); gtag('event', 'click', {'event_category': 'download', 'event_label': 'play_store', 'source': 'cvt'});"
                   class="v-store">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                    </svg>
                    <div>
                        <span class="v-store__small">Get it on</span>
                        <span class="v-store__big">Google Play</span>
                    </div>
                </a>
            </div>
        </div>
    </main>
</SiteLayout>

<style is:global>
    /* Partner lander: shared v-stub markup; page CSS for the three follow
       pills, the 44px secondary pill and the JS-built popup (handleDeepLink).
       The pair's mark is a transparent ball, so the shared tile rounding
       never shows; object-fit contain keeps it whole. */
    body.landing-card-page .v-stub__pair img[src$="cvt-mark.svg"] {
        object-fit: contain;
    }

    body.landing-card-page .cvt-links {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    body.landing-card-page .cvt-link {
        height: 36px;
        padding: 0 16px;
        gap: 8px;
        font-size: 14px;
        font-weight: 600;
    }

    body.landing-card-page .cvt-link svg {
        width: 18px;
        height: 18px;
        flex: none;
    }

    body.landing-card-page .lander-secondary {
        height: 44px;
        border-radius: 22px;
        font-size: 16px;
        font-weight: 600;
    }

    body.landing-card-page .popup-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 16px;
        background: rgba(0, 0, 0, 0.5);
    }

    body.landing-card-page .popup {
        width: min(100%, 360px);
        background: var(--glass-d80);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        border-radius: 24px;
        padding: 24px;
        text-align: center;
        box-shadow: var(--shadow-float);
    }

    body.landing-card-page .popup h2 {
        font: 700 clamp(20px, 1.8vw, 24px)/1.2 var(--font-body);
        color: #fff;
        margin: 0 0 8px;
    }

    body.landing-card-page .popup p {
        font: 400 var(--fs-body)/1.5 var(--font-body);
        color: var(--ink-body);
        margin: 0 0 20px;
    }

    body.landing-card-page .popup button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        height: 36px;
        padding: 0 18px;
        border-radius: 18px;
        border: 0;
        background: var(--glass-15);
        -webkit-backdrop-filter: var(--blur);
        backdrop-filter: var(--blur);
        color: #fff;
        font: 500 15px/1 var(--font-body);
        cursor: pointer;
        transition: background-color 150ms, opacity 100ms;
    }

    body.landing-card-page .popup button:active { opacity: 0.72; }

    @media (hover: hover) {
        body.landing-card-page .popup button:hover { background: var(--glass-15); }
    }
</style>
