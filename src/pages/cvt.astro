---
// College Volleyball Transfers: the desk behind VOLI's Transfer Portal. The
// page opens the portal in the app (voli://transfer-portal, with a download
// prompt when the app does not open), links to the desk's report form, site,
// Instagram and X, and shows their ball mark. Handles and links match the
// app's CvtPartner constants.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/cvt.css';
import Band from '../components/pearl/kit/Band.astro';
import Btn from '../components/pearl/kit/Btn.astro';
import Cols from '../components/pearl/kit/Cols.astro';
import Copy from '../components/pearl/kit/Copy.astro';
import GetApp from '../components/pearl/kit/GetApp.astro';
import Mark from '../components/pearl/kit/Mark.astro';
import PageHero from '../components/pearl/kit/PageHero.astro';
import Steps from '../components/pearl/kit/Steps.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import { pageSchema } from '../components/products/schema';

const title = 'College Volleyball Transfer Portal, Verified by CVT | VOLI';
const description =
  'Every college volleyball portal entry and commit College Volleyball Transfers verifies, in the free VOLI app for iPhone and Android. Open it, or report a move.';

const subnav = {
  label: 'College Volleyball Transfers',
  items: [
    { href: '#portal', label: 'The portal', short: 'Portal' },
    { href: '#report', label: 'Report a move', short: 'Report' },
    { href: '#about', label: 'About' },
  ],
};

const schema = pageSchema({
  path: '/cvt',
  name: 'College Volleyball Transfer Portal in VOLI, by College Volleyball Transfers',
  description,
  crumbs: [
    { name: 'VOLI', path: '/' },
    { name: 'About VOLI', path: '/about' },
    { name: 'College Volleyball Transfers', path: '/cvt' },
  ],
});
---

<Pearl title={title} description={description} section="about" subnav={subnav} schema={schema}>
    <PageHero
      color="rose"
      label={['College volleyball', 'Transfer Portal in VOLI']}
      lines={[{ text: 'Entered.', hollow: true }, 'Committed.']}
    >
        <p class="lede">The Transfer Portal in VOLI follows NCAA women's volleyball transfers: every portal entry and commit that College Volleyball Transfers verifies, with the player, the school and where they are headed.</p>
        <div class="btns">
            <Btn
              href="voli://transfer-portal"
              id="open-portal-btn"
              onclick="handleDeepLink(event, 'voli://transfer-portal');"
              track="transfer_portal_open:cvt_lander"
              variant="primary"
            >Open the Transfer Portal</Btn>
        </div>
        <p class="label">No app yet? VOLI is free on iPhone and Android</p>
        <Stores />
        <div slot="art" class="cvt-art">
            <div class="cvt-pair" role="img" aria-label="VOLI and College Volleyball Transfers">
                <span class="cvt-pair__m"><img src="/images/appicon_opt.webp" width="280" height="280" alt="" class="cvt-icon" decoding="async"></span>
                <span class="cvt-pair__x" aria-hidden="true">&times;</span>
                <span class="cvt-pair__m"><img src="/images/partners/cvt-icon.webp" width="560" height="560" alt="" class="cvt-icon" decoding="async"></span>
            </div>
        </div>
    </PageHero>

    <Band color="ink" id="portal" pb={4} title="The portal" sub="in VOLI" tone="lime" em="portal">
        <Cols ratio="50:42">
            <Copy>
                <p class="lede">College Volleyball Transfers tracks the moves in women's college volleyball: who has entered the portal, where they commit, and the full transfer list each season.</p>
                <p class="body">Every move the desk verifies lands in the Transfer Portal in VOLI, with the player, the school and where they are headed. Find it in Player Transactions on the Stats page, next to <a class="link" href="/">live scores, box scores and stats</a> for every <span class="nb">Division I</span> team and the weekly <a class="link" href="/rankings">VOLI Top 100</a>.</p>
            </Copy>
            <ul class="cvt-moves" aria-label="What each move in the portal shows">
                <li><strong>The player</strong> <span>who entered the portal</span></li>
                <li><strong>The school</strong> <span>they are leaving</span></li>
                <li><strong>Where to</strong> <span>once they commit</span></li>
            </ul>
        </Cols>
        <Steps items={[
          { title: 'Get VOLI', text: 'The app is free on iPhone and Android.' },
          { title: 'Open Player Transactions', text: 'On the Stats page, open Player Transactions and pick NCAA.' },
          { title: 'Follow the moves', text: 'Every entry and commit College Volleyball Transfers verifies, in the app as it lands.' },
        ]} />
    </Band>

    <Band color="blue" id="report" title="Report a move">
        <Cols ratio="50:42">
            <Copy>
                <p class="lede">Know of a portal entry or a commit? Report a transfer to the College Volleyball Transfers desk.</p>
                <p class="body">Moves appear in the Transfer Portal in VOLI once the desk has verified them.</p>
                <div class="btns">
                    <Btn href="https://cvt.playvoli.com/report" track="transfer_portal_report:cvt_report" variant="primary">Report a transfer</Btn>
                </div>
            </Copy>
            <div class="cvt-mark"><Mark on="blue" /></div>
        </Cols>
    </Band>

    <Band color="lime" id="about" title={['About', 'the desk']}>
        <Cols ratio="50:42">
            <Copy>
                <p class="lede">College Volleyball Transfers is the desk behind the Transfer Portal in VOLI. It tracks the moves in women's college volleyball across the divisions and verifies each one.</p>
                <p class="body">Follow the desk on its own site and on social media.</p>
                <div class="btns cvt-follow">
                    <Btn href="https://cvt.playvoli.com" target="_blank" rel="noopener" arrow={false} track="partner_link:cvt_website">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <circle cx="12" cy="12" r="9"/>
                            <path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>
                        </svg>
                        Website
                    </Btn>
                    <Btn href="https://www.instagram.com/collegevbtransfers/" target="_blank" rel="noopener" arrow={false} track="partner_link:cvt_instagram">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="3" width="18" height="18" rx="5"/>
                            <circle cx="12" cy="12" r="4"/>
                            <circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none"/>
                        </svg>
                        Instagram
                    </Btn>
                    <Btn href="https://x.com/CVBTransfers" target="_blank" rel="noopener" arrow={false} track="partner_link:cvt_x" aria-label="College Volleyball Transfers on X">
                        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d="M18.2 2.5h3.3l-7.2 8.2 8.5 10.8h-6.7l-5.2-6.6-6 6.6H1.6l7.7-8.8L1.2 2.5H8l4.7 6.1 5.5-6.1zm-1.2 17h1.8L7.1 4.4H5.1l11.9 15.1z"/>
                        </svg>
                        X
                    </Btn>
                </div>
            </Copy>
            <div class="cvt-logo">
                <img src="/images/partners/cvt-icon.webp" width="560" height="560" alt="The College Volleyball Transfers mark: a blue volleyball with the letters CVT on navy" class="cvt-icon" loading="lazy" decoding="async">
            </div>
        </Cols>
    </Band>

    <GetApp color="rose" lede="Get VOLI, then open Player Transactions on the Stats page." links={[
      { href: '/', label: 'Everything in VOLI' },
      { href: '/fantasy', label: 'Fantasy volleyball' },
      { href: '/rankings', label: 'VOLI Top 100' },
      { href: '/about', label: 'About VOLI' },
    ]} />

    {/* The portal button tries the app first. If the page is still showing two
        seconds later, the app is not installed: say how to get it and bring the
        store buttons into view. */}
    <script is:inline slot="scripts">
        function handleDeepLink(event, deepLink) {
            event.preventDefault();
            window.location.href = deepLink;

            setTimeout(function() {
                if (!document.hidden) {
                    showAppDownloadPopup();
                }
            }, 2000);
        }

        function showAppDownloadPopup() {
            const overlay = document.createElement('div');
            overlay.className = 'cvt-dlg';

            const popup = document.createElement('div');
            popup.className = 'cvt-dlg__box';
            popup.setAttribute('role', 'dialog');
            popup.setAttribute('aria-modal', 'true');
            popup.setAttribute('aria-labelledby', 'pr-pop-h');
            popup.innerHTML = '\
                <h2 id="pr-pop-h">Download VOLI</h2>\
                <p>Get the VOLI app and open Player Transactions on the Stats page to follow every move College Volleyball Transfers verifies.</p>\
                <button id="close-popup" class="btn btn--primary kbtn" type="button">Got it</button>\
            ';

            overlay.appendChild(popup);
            document.body.appendChild(overlay);
            const close = document.getElementById('close-popup');
            close.focus();

            function dismiss() {
                if (overlay.parentNode) document.body.removeChild(overlay);
                document.removeEventListener('keydown', onKey);
                const opener = document.getElementById('open-portal-btn');
                if (opener) opener.focus({ preventScroll: true });
            }
            function onKey(e) {
                if (e.key === 'Escape') dismiss();
            }
            document.addEventListener('keydown', onKey);

            overlay.addEventListener('click', function(e) {
                if (e.target === overlay || e.target.id === 'close-popup') {
                    dismiss();
                }
            });

            setTimeout(function() {
                const storeButtons = document.querySelector('.stores');
                if (storeButtons) {
                    const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
                    storeButtons.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
                }
            }, 300);
        }
    </script>
</Pearl>
