---
import SiteLayout from '../../layouts/SiteLayout.astro';
// Styles: styles/pearl/pages/account.css (loaded by SiteLayout).
---

<SiteLayout
  title="Redirecting to VOLI App..."
  description="Opening the VOLI app to reset your password."
>
    <main class="acct">
        <div class="acct-card acct-card--center acct-stub">
            <div class="spinner-wrap acct-spin-wrap">
                <div class="acct-spinner"></div>
            </div>
            <h1 class="acct-title">Redirecting to VOLI <em>App...</em></h1>
            <p class="acct-sub rp-sub">Opening the VOLI app to reset your password.</p>
            <p class="manual-link">If you're not redirected automatically, <a href="#" id="manual-link" class="link">click here</a>.</p>

            <div class="fallback hidden" id="fallback">
                <p class="fallback-title">Don't have the VOLI app installed?</p>
                <p class="acct-meta fallback-text">Download it from:</p>
                <div class="store-links">
                    <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982" class="btn btn--secondary">App Store</a>
                    <a href="https://play.google.com/store/apps/details?id=com.playvoli.app" class="btn btn--secondary">Google Play</a>
                </div>
                <a href="#" id="open-app-btn" class="btn btn--primary acct-wide">Open VOLI App</a>
            </div>
        </div>
    </main>

    <script is:inline slot="scripts">
        var hash = window.location.hash;
        var appDeepLink = 'voli://auth/reset-password' + hash;

        document.getElementById('manual-link').href = appDeepLink;
        document.getElementById('open-app-btn').href = appDeepLink;

        setTimeout(function() {
            window.location.href = appDeepLink;

            setTimeout(function() {
                document.getElementById('fallback').classList.remove('hidden');
            }, 3000);
        }, 500);
    </script>
</SiteLayout>
