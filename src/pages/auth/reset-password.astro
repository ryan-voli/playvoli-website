---
import SiteLayout from '../../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Redirecting to VOLI App..."
  description="Opening the VOLI app to reset your password."
>
    <main class="v-page v-page--center">
        <div class="v-stub">
            <div class="spinner-wrap">
                <div class="v-spinner"></div>
            </div>
            <h1 class="v-h1 v-stub__title">Redirecting to VOLI App...</h1>
            <p class="v-body v-stub__sub rp-sub">Opening the VOLI app to reset your password.</p>
            <p class="v-path manual-link">If you're not redirected automatically, <a href="#" id="manual-link" class="v-link">click here</a>.</p>

            <div class="fallback hidden" id="fallback">
                <p class="v-q fallback-title">Don't have the VOLI app installed?</p>
                <p class="v-meta fallback-text">Download it from:</p>
                <div class="v-stores store-links">
                    <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982" class="v-store">App Store</a>
                    <a href="https://play.google.com/store/apps/details?id=com.playvoli.app" class="v-store">Google Play</a>
                </div>
                <a href="#" id="open-app-btn" class="v-pill v-pill--cta v-pill--action v-pill--block">Open VOLI App</a>
            </div>
        </div>
    </main>

    <script is:inline slot="scripts">
        var hash = window.location.hash;
        var appDeepLink = 'voli://auth/reset-password' + hash;

        document.getElementById('manual-link').href = appDeepLink;
        document.getElementById('open-app-btn').href = appDeepLink;

        setTimeout(function() {
            window.location.href = appDeepLink;

            setTimeout(function() {
                document.getElementById('fallback').classList.remove('hidden');
            }, 3000);
        }, 500);
    </script>
</SiteLayout>

<style>
    .spinner-wrap { display: flex; justify-content: center; margin-bottom: 24px; }
    .rp-sub { margin-bottom: 12px; }
    .manual-link { margin: 0; }

    .hidden { display: none !important; }

    .fallback {
        margin-top: 24px;
        padding-top: 24px;
        border-top: 1px solid var(--line);
    }
    .fallback-title { margin: 0 0 4px; }
    .fallback-text { margin: 0 0 16px; }
    .store-links { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 12px; }
    .store-links .v-store { justify-content: center; padding: 0 12px; font: 600 16px/1.2 var(--font-body); }
</style>
