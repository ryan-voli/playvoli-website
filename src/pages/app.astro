---
import SiteLayout from '../layouts/SiteLayout.astro';

import { DOWNLOADS, FACTS, FACTS_AS_OF, NEWS_OUTLETS, PODCASTS, appSchemaWithReviews } from '../lib/voli-facts';

// The app entity (with the testimonials as reviews). The questions live on
// /faq and the splash, where they are shown.
const appSchema = [appSchemaWithReviews];---

<SiteLayout
  title="VOLI App - The Volleyball Hub"
  description="Free volleyball app for NCAA women's volleyball, MLV and LOVB: fantasy leagues, live scores and box scores, stats, rankings, history, news and podcasts."
  activePage="app"
  ogUrl="https://playvoli.com/app"
  schema={appSchema}
>
    <div class="v-page">
    <section class="hero">
        <img src="/images/appicon.webp" alt="VOLI" class="hero-logo">
        <h1 class="hero-title">
            <span class="hero-title-mark">VOLI</span>
            <span class="hero-title-rule" aria-hidden="true"></span>
            <span class="hero-title-hub">The Volleyball Hub</span>
        </h1>
        <p class="hero-tagline v-lede">Fantasy. Stats. Community.</p>

        <div class="hero-stars" aria-label="5 stars">
            <svg viewBox="0 0 24 24" fill="#F0FF1E" width="16" height="16"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg viewBox="0 0 24 24" fill="#F0FF1E" width="16" height="16"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg viewBox="0 0 24 24" fill="#F0FF1E" width="16" height="16"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg viewBox="0 0 24 24" fill="#F0FF1E" width="16" height="16"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg viewBox="0 0 24 24" fill="#F0FF1E" width="16" height="16"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <span class="hero-downloads">{DOWNLOADS} downloads</span>
        </div>

        <p class="hero-description v-body">Fantasy volleyball, live games, stats, rankings and volleyball history for NCAA Division I women's volleyball, MLV and LOVB, with volleyball news and podcasts in one feed. Free on iPhone and Android.</p>

        <div class="store-buttons v-stores">
            <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982"
               class="v-store">
                <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                    <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                </svg>
                <div>
                    <span class="v-store__small">Download on the</span>
                    <span class="v-store__big">App Store</span>
                </div>
            </a>

            <a href="https://play.google.com/store/apps/details?id=com.playvoli.app"
               class="v-store">
                <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                    <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                </svg>
                <div>
                    <span class="v-store__small">Get it on</span>
                    <span class="v-store__big">Google Play</span>
                </div>
            </a>
        </div>

        <div class="hero-quotes" aria-label="What users say">
            <p class="is-active">"This app is everything I've been dreaming of since I've gotten into professional volleyball!"</p>
            <p>"It was already so fun to watch volleyball before but now it's a completely new experience watching for your fantasy league. LOVE IT!"</p>
            <p>"This app is gorgeous. Thanks for putting it out there. And so fun!"</p>
            <p>"Y'all are starting something huge that could be a massive growth factor for U.S. volleyball."</p>
        </div>
    </section>

    <section class="screenshots">
        <div class="screenshots-container">
            <div class="screenshot-wrapper">
                <img src="/images/screenshots/home-stats.webp" alt="VOLI Stats: a player's analytics card" class="screenshot" width="640" height="1280">
            </div>
            <div class="screenshot-wrapper">
                <img src="/images/screenshots/home-fantasy.webp" alt="VOLI Fantasy: your teams and leagues" class="screenshot" width="640" height="1280">
            </div>
            <div class="screenshot-wrapper">
                <img src="/images/screenshots/home-games.webp" alt="VOLI Games: the day's schedule" class="screenshot" width="640" height="1280">
            </div>
        </div>
    </section>

    <section class="facts" aria-labelledby="facts-h">
        <h2 class="facts-label v-label v-label--sans" id="facts-h">What's in VOLI <span>· as of {FACTS_AS_OF}</span></h2>
        <ul class="facts-band">
            {FACTS.map((f) => (
                <li><strong>{f.value}</strong><span>{f.label}</span></li>
            ))}
        </ul>
    </section>

    <section class="features" aria-label="What you can do in VOLI">
        <div class="features-grid v-grid v-grid--2">
            <article class="feature-card" id="fantasy">
                <img src="/images/icons/fantasy_opt.png" alt="" class="feature-icon">
                <h2 class="feature-title v-h3-plain">Fantasy leagues</h2>
                <p class="feature-description v-meta">Build a team from real college and pro players and play the season against your friends. Leagues use a salary cap and multi-round contracts, for NCAA Division I women's volleyball and MLV, and the NCAA season runs in ten rounds, Wednesday to Sunday. Join a public league run by a volleyball podcast, or start a private one.</p>
            </article>
            <article class="feature-card" id="games">
                <img src="/images/icons/games_opt.png" alt="" class="feature-icon">
                <h2 class="feature-title v-h3-plain">Live games</h2>
                <p class="feature-description v-meta">Scores and box scores for college and pro matches as they happen, with a lead chart for each set, and play-by-play with the rotation on court for MLV and LOVB matches. On iPhone, keep the score on your lock screen with Live Activities.</p>
            </article>
            <article class="feature-card" id="stats">
                <img src="/images/icons/statistics_opt.png" alt="" class="feature-icon">
                <h2 class="feature-title v-h3-plain">Stats and box scores</h2>
                <p class="feature-description v-meta">Nearly 500,000 NCAA player box-score lines since 2023, covering 99.8% of completed Division I matches, and set-by-set player stats for all 445 MLV and LOVB matches. Leaderboards sort by season, conference, position and class, in totals or per set.</p>
            </article>
            <article class="feature-card" id="rankings">
                <svg class="feature-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 21h8M12 17v4M7 4h10v5a5 5 0 0 1-10 0V4zM17 5h3v2a3 3 0 0 1-3 3M7 5H4v2a3 3 0 0 0 3 3"/></svg>
                <h2 class="feature-title v-h3-plain">Rankings and predictions</h2>
                <p class="feature-description v-meta">The VOLI Top 100, VOLI's own ranking of Division I teams from match results and strength of schedule, published each Monday. Before first serve, each upcoming college match shows each team's chance to win and the most likely set score, and the chance to win updates after every set. All next to the AVCA Coaches Poll and EVOLLVE's ratings.</p>
                <div class="feature-links">
                    <a href="/rankings" class="feature-link v-link">The VOLI Top 100 <span aria-hidden="true">→</span></a>
                    <a href="/methods" class="feature-link v-link">How it works <span aria-hidden="true">→</span></a>
                </div>
            </article>
            <article class="feature-card" id="encyclopedia">
                <svg class="feature-svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V3H6.5A2.5 2.5 0 0 0 4 5.5v14zM4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5"/></svg>
                <h2 class="feature-title v-h3-plain">The Volleyball Encyclopedia</h2>
                <p class="feature-description v-meta">More than 18,000 honors back to 1979: 3,000+ AVCA All-America selections since 1981, the AVCA Coaches Poll since 1982, all 45 NCAA champions, ACC, Big 12, Big Ten and SEC honors, record books, the MLV Draft and pro league honors.</p>
            </article>
            <article class="feature-card" id="news">
                <img src="/images/icons/content_opt.png" alt="" class="feature-icon">
                <h2 class="feature-title v-h3-plain">News and podcasts</h2>
                <p class="feature-description v-meta">Volleyball news from 19 outlets, from league and conference sites to independent writers, each story linked to its source. And 12 volleyball podcasts with more than 800 episodes to stream or download, with your place saved across devices.</p>
            </article>
            <article class="feature-card" id="community">
                <img src="/images/icons/community_opt.png" alt="" class="feature-icon">
                <h2 class="feature-title v-h3-plain">Community</h2>
                <p class="feature-description v-meta">A chat room for every match, rooms for NCAA, MLV and LOVB fans, and a private chat for each fantasy league. Partner podcasts host AMAs with players and creators right in the app.</p>
            </article>
            <a href="/evollve" class="feature-card feature-card--more">
                <img src="/images/partners/evollve-ball.webp" alt="" class="feature-icon" width="32" height="32">
                <h2 class="feature-title v-h3-plain">Analytics by EVOLLVE</h2>
                <p class="feature-description v-meta">EVOLLVE's college volleyball analytics are built in: nightly team ratings for every Division I team, player impact numbers like RAPM, and match predictions.</p>
            </a>
        </div>
    </section>

    <section class="sources" aria-label="Where VOLI's news and podcasts come from">
        <div class="sources-grid v-grid v-grid--2">
            <div class="sources-card">
                <h2 class="v-h3-plain">Where the news comes from</h2>
                <ul class="outlets">
                    {NEWS_OUTLETS.map((o) => <li>{o}</li>)}
                </ul>
                <p class="v-meta">Coverage spans NCAA women's volleyball, MLV and LOVB: results, previews, transfers, rankings and awards. Every story opens on its publisher's site.</p>
            </div>
            <div class="sources-card">
                <h2 class="v-h3-plain">Volleyball podcasts on VOLI</h2>
                <ul class="pods">
                    {PODCASTS.map((p) => (
                        <li>
                            <span class="pod-name">{p.name}</span>
                            <span class="pod-meta">{p.by} · {p.episodes} {p.episodes === 1 ? 'episode' : 'episodes'}{p.partner && <span class="v-chip v-chip--lime pod-tag">Partner</span>}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <nav class="more" aria-label="More about VOLI">
        <a href="/rankings" class="v-pill">VOLI Top 100</a>
        <a href="/faq" class="v-pill">Questions about VOLI</a>
        <a href="/methods" class="v-pill">How VOLI's numbers work</a>
        <a href="/about" class="v-pill">About VOLI</a>
    </nav>

    <section class="leagues">
        <p class="leagues-label v-label">Leagues We Cover</p>
        <div class="leagues-logos">
            <a class="league-mark" href="https://lovb.com" target="_blank" rel="noopener">
                <span class="league-mark__name">LOVB</span>
                <span class="league-mark__full">League One<br>Volleyball</span>
            </a>
            <a class="league-mark" href="https://provolleyball.com" target="_blank" rel="noopener">
                <span class="league-mark__name">MLV</span>
                <span class="league-mark__full">Major League<br>Volleyball</span>
            </a>
            <a class="league-mark" href="https://www.ncaa.com/sports/volleyball-women" target="_blank" rel="noopener">
                <span class="league-mark__name">NCAA</span>
                <span class="league-mark__full">Women's<br>Division I</span>
            </a>
        </div>
        <p class="leagues-disclaimer v-path">VOLI is an independent fan platform, not affiliated with or endorsed by these leagues.</p>
    </section>
</div>
</SiteLayout>

<script is:inline>
    /* Quotes: the next one every 7s. Pauses under the pointer and while the
       tab is hidden; with no JS the first stays up. */
    (function () {
        var box = document.querySelector('.hero-quotes');
        if (!box) return;
        var qs = box.querySelectorAll('p');
        if (qs.length < 2) return;
        var i = 0, paused = false;
        function show(k) {
            qs.forEach(function (q, n) {
                q.classList.toggle('is-active', n === k);
                q.setAttribute('aria-hidden', n === k ? 'false' : 'true');
            });
        }
        show(0);
        box.addEventListener('mouseenter', function () { paused = true; });
        box.addEventListener('mouseleave', function () { paused = false; });
        setInterval(function () {
            if (paused || document.hidden) return;
            i = (i + 1) % qs.length;
            show(i);
        }, 7000);
    })();
</script>


<style>
    /* Hero: calm Aurora hero */
    .hero {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
        padding-top: 24px;
    }


    .hero-logo {
        width: 100px;
        height: auto;
        border-radius: 22px;
        margin-bottom: 24px;
    }

    /* Restored from the live site (owner, 5 Oct 2026): the refresh's stacked
       lime descriptor is gone; the brand lockup is back exactly as it was. */
    /* THE LOCKUP, NOT A SENTENCE. The brand wordmark is
       "VOLI | THE VOLLEYBALL HUB" — two faces separated by a rule, not one
       string with a colon in it. VOLI carries the display face; the descriptor
       is a wide-tracked label in the body face, which is what makes the two
       read as different things rather than as one long headline. */
    /* ALIGNED ON THE BASELINE, NOT THE BOX — and that choice is load-bearing.
       align-items:center centres each item's LINE BOX, and a line box is built
       from the font's ascent and descent. Designer's are 752/-200 against a
       700 cap on a 1000 em, so its caps sit well above its box centre and the
       wordmark rode high against the rule and the descriptor.

       Correcting that with a translateY tuned to ascent/descent would have
       been right on macOS and wrong on Windows: Designer does not set
       USE_TYPO_METRICS, so Windows lays it out on usWin (1026/273) instead of
       hhea (752/-200) — a ~0.1em disagreement.

       Baseline alignment depends on NONE of that. Both items sit on their
       shared baseline, and the only numbers used below are CAP HEIGHTS, which
       every platform agrees on. */
    .hero-title {
        display: flex;
        align-items: baseline;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0 1.15rem;
        margin-bottom: 0.5rem;
        line-height: 1;
    }

    .hero-title-mark {
        font-family: 'Designer', sans-serif;
        font-size: 4.25rem;
        line-height: 1;
        letter-spacing: 0.01em;
        color: #ffffff;
    }

    /* PROPORTIONS ARE FROM THE BRAND LOCKUP, not eyeballed. The Claude
       Design "VOLI Brand" template sets the header at VOLI 52px / rule
       1x34px at 18% white / descriptor 19px at 0.2em and 50% white — so
       the wordmark is 2.74x the descriptor and the rule is 0.65x the
       wordmark. Those ratios are kept here at hero scale. */
    /* A flex item with no text baseline aligns its BOTTOM edge to the shared
       baseline, so a rule of exactly Designer's cap height (0.70em) spans
       baseline to cap-top and needs no offset of its own. */
    .hero-title-rule {
        width: 1px;
        height: 2.975rem;  /* 0.70 x 4.25rem = Designer's cap height */
        background: rgba(255, 255, 255, 0.35);
        flex: none;
    }

    /* Lift the descriptor so its cap band centres on the wordmark's:
       -(0.70 x 2.74 - 0.72754) / 2 = -0.5952em, where 0.72754 is Inter's cap
       height and 2.74 the brand size ratio. Because that ratio is fixed, the
       figure is CONSTANT — it holds at every breakpoint without retuning. */
    .hero-title-hub {
        font-size: 1.55rem; /* 4.25rem / 2.74 */
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #ffffff;
        white-space: nowrap;
        transform: translateY(-0.5952em);
        /* letter-spacing also pads the LAST glyph, which shifts a centred
           label right by half a space. Pull it back so the lockup is
           optically centred rather than metrically. */
        margin-right: -0.2em;
    }

    .hero-tagline { color: var(--ink); margin: 0 0 12px; }
    .hero-stars { display: flex; align-items: center; gap: 4px; margin-bottom: 16px; }
    .hero-downloads { margin-left: 8px; font: 600 14px/1 var(--font-body); color: var(--ink-2); }
    .hero-description { max-width: 500px; margin: 0 0 32px; }

    /* Quotes: straight on the background, no card (owner, 5 Oct 2026) —
       one at a time, the next bounces in every 7s. All four share one grid
       cell, so the block is always as tall as the longest and never jumps.
       Hidden on phones, as before. */
    .hero-quotes {
        display: grid;
        width: 100%;
        max-width: 560px;
        margin-top: 48px;
    }
    .hero-quotes p {
        grid-area: 1 / 1;
        margin: 0;
        padding: 0 20px;
        font: 400 15px/1.5 var(--font-body);
        color: var(--ink-2);
        text-align: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 250ms ease, visibility 250ms;
    }
    .hero-quotes p.is-active {
        opacity: 1;
        visibility: visible;
        animation: quote-bounce 700ms cubic-bezier(.34, 1.56, .64, 1) both;
    }
    @keyframes quote-bounce {
        from { opacity: 0; transform: translateY(16px) scale(.97); }
        to   { opacity: 1; transform: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .hero-quotes p.is-active { animation: none; }
    }

    /* Screenshots */
    .screenshots {
        padding: 64px 0 32px;
        overflow: hidden;
    }
    .screenshots-container {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 24px;
        max-width: 900px;
        margin: 0 auto;
    }
    .screenshot-wrapper { flex: 1; max-width: 280px; }
    .screenshot-wrapper:nth-child(2) { transform: scale(1.1); z-index: 2; }
    .screenshot { display: block; width: 100%; height: auto; border-radius: 24px; }

    /* Features: six outline cards */
    .features { max-width: 1120px; margin: 0 auto; padding-top: 64px; }
    /* Every row as tall as the tallest card, so all six match at every width */
    .features-grid { grid-auto-rows: 1fr; }
    /* Outline cards, not glass (owner, 5 Oct 2026) */
    .feature-card {
        display: flex;
        flex-direction: column;
        gap: 8px;
        padding: 20px;
        border: 1px solid var(--outline);
        border-radius: var(--r-card);
        text-decoration: none;
    }
    .feature-icon, .feature-card .learn-more-icon { width: 32px; height: 32px; flex: none; object-fit: contain; margin-bottom: 4px; }
    .feature-title { margin: 0; }
    .feature-description { margin: 0; }
    .feature-card--more .feature-title,
    .feature-card--more .learn-more-icon { color: var(--electric-blue); }
    a.feature-card { transition: background-color 150ms, opacity 100ms; }
    a.feature-card:active { opacity: .72; }
    @media (hover: hover) { a.feature-card:hover { background: var(--glass-6); } }

    /* Facts: the numbers AI and search engines quote (owner, 15 Oct 2026) */
    .facts { max-width: 1120px; margin: 0 auto; padding-top: 64px; }
    .facts-label { padding-top: 0; }
    .facts-label span { font-weight: 500; color: var(--ink-2); letter-spacing: .06em; }
    .facts-band {
        list-style: none;
        margin: 8px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 12px;
    }
    .facts-band li {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 18px 12px;
        border: 1px solid var(--outline);
        border-radius: var(--r-card);
        text-align: center;
    }
    .facts-band strong { font: 700 26px/1.1 var(--font-body); letter-spacing: -.01em; color: var(--ink); font-variant-numeric: tabular-nums; }
    .facts-band span { font: 400 13px/1.35 var(--font-body); color: var(--ink-2); }

    .feature-svg { width: 32px; height: 32px; flex: none; color: var(--electric-blue); margin-bottom: 4px; }
    .feature-link { font: 600 14px/1.3 var(--font-body); }
    .feature-links { margin-top: auto; padding-top: 4px; display: flex; flex-wrap: wrap; gap: 6px 18px; }

    /* News outlets and podcasts */
    .sources { max-width: 1120px; margin: 0 auto; padding-top: 64px; }
    .sources-grid { align-items: start; }
    .sources-card {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 20px;
        border: 1px solid var(--outline);
        border-radius: var(--r-card);
        min-width: 0;
    }
    .sources-card h2, .sources-card p { margin: 0; }
    .outlets { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .outlets li {
        padding: 6px 12px;
        border-radius: var(--r-pill);
        background: var(--glass-10);
        font: 500 13px/1.2 var(--font-body);
        color: var(--ink);
    }
    .pods { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
    .pods li { display: flex; flex-direction: column; gap: 2px; }
    .pod-name { font: 600 15px/1.3 var(--font-body); color: var(--ink); }
    .pod-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 8px; font: 400 13px/1.35 var(--font-body); color: var(--ink-2); }
    .pod-tag { height: 18px; font-size: 11px; }

    .more { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; padding-top: 48px; }

    /* Leagues */
    .leagues { padding-top: 64px; text-align: center; }
    .leagues-label { margin-bottom: 12px; }
    /* Wordmarks set in type, not league logo images (owner, 5 Oct 2026) */
    .leagues-logos {
        display: grid;
        grid-template-columns: repeat(3, 200px);
        justify-content: center;
        gap: 24px;
        padding-top: 12px;
    }
    .league-mark {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        color: var(--ink-2);
        text-decoration: none;
        transition: color 150ms;
    }
