---
// Questions about VOLI (owner, 15 Oct 2026). Ported from the ai-positioning
// branch's /faq onto the refresh's look, with numbers recounted 15 Oct. The
// same text feeds the visible answers and the FAQPage JSON-LD (lib/voli-facts),
// so the two can never drift.
import SiteLayout from '../layouts/SiteLayout.astro';
import { FAQS, STORE, faqSchema, linkify } from '../lib/voli-facts';

const schema = [faqSchema(FAQS, 'https://playvoli.com/faq')];
---

<SiteLayout
  title="VOLI FAQ: Volleyball Scores, Stats, History & Fantasy"
  description="Answers about VOLI: fantasy volleyball, NCAA box scores and stats, the VOLI Top 100, AVCA history, leagues covered, and the free app."
  activePage="faq"
  ogUrl="https://playvoli.com/faq"
  schema={schema}
>
    <main class="v-page">
        <div class="v-wrap v-wrap--read">
            <p class="v-label v-label--sans faq-eyebrow">FAQ</p>
            <h1 class="v-title-plain faq-title">Questions about VOLI</h1>
            <p class="v-lede faq-lede">Fantasy, live games, stats, rankings, history, news and podcasts: what's in the free VOLI app and how it works.</p>

            <div class="faq-list">
                {FAQS.map((f) => (
                    <section class="faq-item v-card" id={f.id}>
                        <h2 class="v-h3-plain">{f.q}</h2>
                        <p class="v-body" set:html={linkify(f.a)} />
                    </section>
                ))}
            </div>

            <div class="faq-cta">
                <p class="v-body">VOLI is free on iPhone and Android.</p>
                <div class="v-stores">
                    <a href={STORE.ios} class="v-store">
                        <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                        </svg>
                        <div>
                            <span class="v-store__small">Download on the</span>
                            <span class="v-store__big">App Store</span>
                        </div>
                    </a>
                    <a href={STORE.android} class="v-store">
                        <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                            <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                        </svg>
                        <div>
                            <span class="v-store__small">Get it on</span>
                            <span class="v-store__big">Google Play</span>
                        </div>
                    </a>
                </div>
            </div>

            <p class="faq-related v-meta">
                <a href="/app" class="v-link">Everything in VOLI</a> ·
                <a href="/methods" class="v-link">How VOLI's numbers work</a> ·
                <a href="/evollve" class="v-link">Analytics by EVOLLVE</a> ·
                <a href="/contact" class="v-link">Contact</a>
            </p>
        </div>
    </main>
</SiteLayout>

<style>
    .faq-eyebrow { padding: 0; margin: 0 0 10px; }
    .faq-title { margin: 0 0 12px; text-align: center; text-wrap: balance; }
    .faq-lede { margin: 0 auto 32px; max-width: 60ch; text-align: center; }
    .faq-list { display: grid; gap: 12px; }
    .faq-item { scroll-margin-top: 96px; }
    .faq-item h2 { margin: 0 0 8px; }
    .faq-item p { margin: 0; }
    .faq-cta { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 40px; text-align: center; }
    .faq-cta p { margin: 0; }
    .faq-related { margin: 28px 0 0; text-align: center; }
</style>
