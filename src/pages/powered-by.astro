---
// Powered by VOLI — the badge for sites that use VOLI data (owner, 24 Nov 2026:
// "an easy one line plugin … it will just auto be in the correct position …
// any of the 4 corners … the distance we use from the edges … floating and
// stay on the page, it cannot be scrolled away"). The asset itself is
// public/embed/powered-by-voli.js (the portal site's "by VOLI" pill, reading
// Powered by, linking to playvoli.com/app); public/images/powered-by-voli.svg
// is the no-script fallback. Same v-stub card as the partner landers. Not in
// the sitemap or the nav: partners get this link from us.
import SiteLayout from '../layouts/SiteLayout.astro';
const SNIPPET = '<script src="https://playvoli.com/embed/powered-by-voli.js" async></script>';
const SNIPPET_CORNER = '<script src="https://playvoli.com/embed/powered-by-voli.js" data-position="top-right" async></script>';
const SNIPPET_IMG = '<a href="https://playvoli.com/app"><img src="https://playvoli.com/images/powered-by-voli.svg" alt="Powered by VOLI" width="141" height="28"></a>';
---

<SiteLayout
  title="Powered by VOLI - VOLI"
  description="The Powered by VOLI badge for sites that use VOLI data: one line of code, a floating pill in any corner, linking to the VOLI app."
  ogUrl="https://playvoli.com/powered-by"
  skipSupabase
  skipNavAuth
  bodyClass="landing-card-page"
>
    <meta name="robots" content="noindex, follow" slot="head" />
    <script is:inline slot="scripts">
        gtag('event', 'page_view', { 'source': 'powered-by' });

        function copySnippet(button) {
            const code = button.closest('.pb-code').querySelector('code').textContent;
            const done = () => {
                button.textContent = 'Copied';
                setTimeout(() => { button.textContent = 'Copy'; }, 1600);
            };
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(code).then(done, () => fallbackCopy(code, done));
            } else {
                fallbackCopy(code, done);
            }
            plausible('Powered By Copy');
        }

        function fallbackCopy(text, done) {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.setAttribute('readonly', '');
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand('copy'); done(); } catch (e) { /* leave the text selectable */ }
            document.body.removeChild(ta);
        }
    </script>
    <!-- The badge itself, live on this page: the same one line partners add. -->
    <script is:inline slot="scripts" src="/embed/powered-by-voli.js" async></script>

    <main class="v-page v-page--center">
        <div class="v-stub pb-stub">
            <h1 class="v-stub__heading">Powered by VOLI</h1>
            <p class="v-body v-stub__sub">The badge for sites that show VOLI data. One line of code puts it in a corner of every page, 16 pixels from the edges, where it floats as the page scrolls and links to the VOLI app. It is the one on this page, bottom right.</p>

            <div class="v-rule-label v-stub__divider">
                <span>Add it</span>
            </div>

            <div class="pb-code">
                <code>{SNIPPET}</code>
                <button type="button" class="v-pill pb-copy" onclick="copySnippet(this)">Copy</button>
            </div>
            <p class="v-body pb-note">Put it anywhere in the page, on every page that uses the data. It defaults to the bottom right. For another corner, add <span class="pb-attr">data-position</span> with <span class="pb-attr">bottom-left</span>, <span class="pb-attr">top-right</span> or <span class="pb-attr">top-left</span>:</p>
            <div class="pb-code">
                <code>{SNIPPET_CORNER}</code>
                <button type="button" class="v-pill pb-copy" onclick="copySnippet(this)">Copy</button>
            </div>

            <div class="v-rule-label v-stub__divider">
                <span>The rules</span>
            </div>

            <ul class="pb-rules v-body">
                <li>It appears on every page that shows VOLI data.</li>
                <li>It sits in one of the four corners, exactly as the script places it.</li>
                <li>Nothing covers it, and it is never resized, recoloured, restyled or hidden.</li>
                <li>It links to playvoli.com/app, and stays on screen while the page scrolls.</li>
            </ul>

            <div class="v-rule-label v-stub__divider">
                <span>No scripts allowed?</span>
            </div>

            <p class="v-body pb-note">Use the image instead, fixed in a corner 16 pixels from the edges, linking to the app:</p>
            <div class="pb-code">
                <code>{SNIPPET_IMG}</code>
                <button type="button" class="v-pill pb-copy" onclick="copySnippet(this)">Copy</button>
            </div>

            <p class="v-body pb-foot">Questions about data access or the badge: <a href="/contact">contact us</a>.</p>
        </div>
    </main>
</SiteLayout>

<style is:global>
    /* Powered by VOLI: the lander card, widened a touch for the code lines. */
    body.landing-card-page .pb-stub {
        max-width: 520px;
    }

    body.landing-card-page .pb-code {
        position: relative;
        margin: 0 0 12px;
        padding: 14px 84px 14px 16px;
        border-radius: 14px;
        background: rgba(0, 0, 0, 0.35);
        box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.10);
        text-align: left;
    }

    body.landing-card-page .pb-code code {
        display: block;
        font: 500 13px/1.5 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        color: #fff;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        user-select: all;
        -webkit-user-select: all;
    }

    body.landing-card-page .pb-copy {
        position: absolute;
        top: 10px;
        right: 10px;
        height: 32px;
        padding: 0 14px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    body.landing-card-page .pb-note,
    body.landing-card-page .pb-foot {
        margin: 0 0 12px;
        font-size: 14px;
        text-align: left;
    }

    body.landing-card-page .pb-foot {
        margin: 24px 0 0;
        text-align: center;
    }

    body.landing-card-page .pb-foot a {
        color: #fff;
        text-decoration: underline;
    }

    body.landing-card-page .pb-attr {
        font: 500 13px/1 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        padding: 2px 6px;
        border-radius: 6px;
        background: rgba(255, 255, 255, 0.12);
        white-space: nowrap;
    }

    body.landing-card-page .pb-rules {
        margin: 0;
        padding: 0 0 0 20px;
        text-align: left;
        font-size: 14px;
    }

    body.landing-card-page .pb-rules li {
        margin: 0 0 8px;
    }

    /* The last card line clears the live badge in the corner. */
    body.landing-card-page .pb-stub {
        padding-bottom: 52px;
    }
</style>
