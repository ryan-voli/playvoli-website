---
// A shared podcast or episode, for someone who does not have the app yet.
//
// STATIC ROUTE, DYNAMIC PATH, like /league: only /podcast is emitted at build
// time and the rewrite in vercel.json ({ "source": "/podcast/:path*",
// "destination": "/podcast" }) serves this page for /podcast/<podcastId> and
// /podcast/<podcastId>/episode/<episodeId>. The path is read from
// location.pathname in the browser. The first script hands it to the app; the
// second names the show (and the episode) from the database, in parallel and
// never in the way of the handoff.
import Pearl from '../../layouts/Pearl.astro';
import '../../styles/pearl/pages/share.css';
import Btn from '../../components/pearl/kit/Btn.astro';
import GetApp from '../../components/pearl/kit/GetApp.astro';
import Phones from '../../components/pearl/kit/Phones.astro';
import Qr from '../../components/pearl/kit/Qr.astro';
import Stores from '../../components/pearl/kit/Stores.astro';
import WhatIsVoli from '../../components/pearl/kit/WhatIsVoli.astro';
import { SCREENS } from '../../lib/screens';

export function getStaticPaths() {
  return [{ params: { slug: undefined } }];
}

const subnav = {
  label: 'Shared podcast',
  items: [
    { href: '#open', label: 'Open in VOLI' },
    { href: '#get', label: 'Get the app' },
  ],
};
---

<Pearl
  title="Listen to This Volleyball Podcast in the Free App | VOLI"
  description="Listen to this volleyball podcast in VOLI, the free volleyball app for iPhone and Android: stream or download episodes, with your place saved across devices."
  canonical="https://playvoli.com/podcast"
  subnav={subnav}
  noindex="follow"
>
    <link rel="preload" as="image" href={SCREENS.podcast.src} type="image/webp" fetchpriority="high" slot="head" />

    <section class="hero khero ut-share" id="open" aria-labelledby="podcast-h">
        <div class="wrap hero__grid">
            <div class="hero__copy">
                <div class="ut-state">
                    <h1 class="ut-head" id="podcast-h">
                        <span class="kicker"><span>Volleyball podcast</span> <span>on VOLI</span></span>
                        {' '}
                        <span class="display" id="podcast-title" data-fit><em>Listen</em> on VOLI</span>
                    </h1>
                    <div class="ut-copy">
                        <p class="label ut-meta" id="podcast-by"></p>
                        <p class="lede ut-meta" id="podcast-episode"></p>
                        <p class="body">Open it in the VOLI app to stream or download episodes, with your place saved across devices.</p>
                        <div class="btns"><Btn id="open-app-btn" href="#" variant="primary" arrow={false}>Open in VOLI</Btn></div>
                        <div class="ut-get">
                            <p class="label">Don't have the app?</p>
                            <Stores />
                        </div>
                        <Qr />
                    </div>
                </div>
            </div>
            <div class="hero__art">
                <Phones screens={['podcast', 'news']} step eager class="ut-phones" />
            </div>
        </div>
    </section>

    <WhatIsVoli fantasy />

    <GetApp color="blue" links={[
      { href: '/', label: 'Everything in VOLI' },
      { href: '/volleytalk', label: 'Volley Talk on VOLI' },
      { href: '/mlm', label: 'Major League Minute' },
      { href: '/about#faq', label: 'Questions about VOLI' },
    ]} />

    <Fragment slot="scripts">
        {/* The Supabase browser SDK, for the show lookup below. Loaded on the
            share pages only, before the scripts that use it. */}
        <script is:inline src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
        <script>
          const path = window.location.pathname;
          const match = path.match(/^\/podcast\/(.+)/);
          const podcastId = match ? match[1] : null;
          const btn = document.getElementById('open-app-btn');

          if (podcastId && btn) {
            const deepLink = `voli://podcast/${podcastId}`;
            btn.href = deepLink;

            // Auto-attempt deep link on mobile
            const isMobile = /iPhone|iPad|iPod|Android/i.test(navigator.userAgent);
            if (isMobile) {
              window.location.href = deepLink;
            }
          } else if (btn) {
            btn.style.display = 'none';
          }
        </script>
        <script>
          import { keepFitted } from '../../components/pearl/kit/fit';
          import { SUPABASE_ANON_KEY, SUPABASE_URL } from '../../lib/voli-rankings';

          const title = document.getElementById('podcast-title');
          if (title) keepFitted(title);

          // The headline names the show, the line under it its host, and a
          // shared episode (the app's /podcast/<show>/episode/<episode> link)
          // its own title, as the app opens it: only an episode of this show
          // that has not been removed. Read-only, anon key; anything missing
          // keeps the generic copy. Titles are data: textContent only.
          const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
          const [, showId, episodeId] = window.location.pathname.match(/^\/podcast\/([^/?#]+)(?:\/episode\/([^/?#]+))?/) || [];
          const sdk = (window as any).supabase;

          if (showId && UUID.test(showId) && sdk) {
            try {
              const content = sdk.createClient(SUPABASE_URL, SUPABASE_ANON_KEY).schema('content');
              content
                .from('podcasts')
                .select('title, author')
                .eq('podcast_id', showId)
                .maybeSingle()
                .then(({ data }: { data: { title: string | null; author: string | null } | null }) => {
                  const show = data?.title?.trim();
                  if (!show) return;
                  if (title) title.textContent = show;
                  const by = document.getElementById('podcast-by');
                  if (by && data?.author?.trim()) by.textContent = data.author.trim();
                }, () => { /* keep the generic copy */ });

              if (episodeId && UUID.test(episodeId)) {
                content
                  .from('podcast_episodes')
                  .select('title, podcast_uuid, removed_at')
                  .eq('episode_id', episodeId)
                  .maybeSingle()
                  .then(({ data }: { data: { title: string | null; podcast_uuid: string | null; removed_at: string | null } | null }) => {
                    if (!data?.title?.trim() || data.podcast_uuid !== showId || data.removed_at) return;
                    const line = document.getElementById('podcast-episode');
                    if (line) line.textContent = `Episode: ${data.title.trim()}`;
                  }, () => { /* keep the generic copy */ });
              }
            } catch (e) { /* keep the generic copy */ }
          }
        </script>
    </Fragment>
</Pearl>
