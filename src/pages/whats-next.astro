---
import SiteLayout from '../layouts/SiteLayout.astro';

const timeline = [
  {
    id: 'fantasyvb', date: 'Mar 2024', dateFull: 'March 2024',
    title: 'FantasyVB Begins', status: 'past',
    body: "FantasyVB started as an experimental sandbox — a personal testbed to figure out whether a real fantasy volleyball product was even possible. The early work focused on comparing fantasy formats to find the one that fit volleyball best, iterating on a scoring system that was fair across every position, and validating the right tech stack. Alongside the build came classes to pick up the full-stack skills the real product would need. By the end, the answer was clear: it was possible — and there was a concrete plan for the knowledge, technical capabilities, and backing it would take to ship it.",
  },
  {
    id: 'voli-app', date: 'Jan 2025', dateFull: 'January 2025',
    title: 'VOLI App Begins', status: 'past',
    body: "VOLI App development began as the project's scope grew beyond fantasy alone. The data already needed to power the fantasy system — stats, player profiles, game schedules — meant those features were essentially free to build into a full hub for US pro volleyball. The simpler pieces were built first, which doubled as a way to build confidence in the tech stack before tackling fantasy. Fantasy came next, validated through extensive simulations and testing against two years of MLV data and one year of LOVB data. Just before launch, podcast discovery and support tools were added so fans could find — and back — the creators putting in serious work to grow the sport.",
  },
  {
    id: 'app-beta', date: 'Jan 2026', dateFull: 'January 2026',
    title: 'App Beta Launch', status: 'past',
    body: "The app went public with MLV fantasy for the 2026 pro season — the first time the fantasy system ran live at scale, with real managers instead of simulations. Partnerships with volleyball creators put it in front of the fans most likely to put it through its paces: Major League Minute, Volley Talk with Sarah Pavan, and Court Captains. The season closed with 1,300+ downloads, and it taught us things no amount of testing could: how the scoring held up once real managers were optimising against it, where the contract rules helped and where they got in the way, and what a fantasy week should actually feel like week to week. Those lessons are what shaped everything that followed — starting with a scoring system rebuilt from the ground up for the college game.",
  },
  {
    id: 'ncaa-fantasy', date: 'Aug 2026', dateFull: 'August 2026',
    title: 'NCAA Fantasy Launch', status: 'current', live: true,
    body: "It's here. The same fantasy experience fans enjoyed during the pro season is now running for NCAA women's volleyball, tuned for the college game — shorter seasons, simpler scoring, and a more accessible format. Leagues are open now, and the first scoring round runs September 9–13. The season is ten rounds, each running Wednesday through Sunday, with Monday and Tuesday as the signing window to set your roster for the week ahead.",
  },
  {
    id: 'ncaa-bracket', date: 'Nov 2026', dateFull: 'November 2026',
    title: 'NCAA Bracket Challenge', status: 'upcoming',
    body: "A March Madness-style bracket challenge for the NCAA women's volleyball tournament. Pick the whole field, call the upsets, and follow it round by round against everyone else. It's the format that turns college basketball's postseason into something the entire country follows together — volleyball's tournament has never had its equivalent, and that's the gap this fills.",
  },
  {
    id: 'lovb-fantasy', date: 'Jan 2027', dateFull: 'January 2027',
    title: 'LOVB Fantasy Launch', status: 'upcoming',
    body: "LOVB joins the fantasy system. The 2026 pro season proved the format works at scale, and this brings the same experience to a second professional league — so managers can run teams across both rather than picking one. VOLI has carried LOVB stats, schedules, and player profiles from the start; fantasy is the piece that has been missing.",
  },
];

const details = Object.fromEntries(timeline.map(t => [t.id, {
  date: t.dateFull,
  title: t.title,
  status: t.status,
  live: t.live === true,
  body: t.body,
}]));
---

<SiteLayout
  title="What's Next - VOLI"
  description="The VOLI roadmap: announcements, upcoming features, and what we're building next for professional and college volleyball fans."
  activePage="whats-next"
>
    <main class="v-page">
      <div class="v-wrap v-wrap--read">
        <h1 class="v-title-plain v-center wn-title">What's Next</h1>
        <p class="lead v-lede v-center">A look at what we're building, what's launching, and where VOLI is headed.</p>

        <section class="v-card v-card--plate is-labelled">
        <div class="v-label">Roadmap</div>
        <div class="timeline-wrap">
            <div class="timeline-scroll" id="timeline-scroll">
                <div class="timeline-track">
                    {timeline.map(item => (
                        <button
                            type="button"
                            class:list={['timeline-item', item.status]}
                            data-id={item.id}
                            aria-label={`${item.dateFull} — ${item.title}`}
                        >
                            <span class="timeline-date">{item.date}</span>
                            <span class="timeline-dot" aria-hidden="true"></span>
                            <span class="timeline-title">{item.title}</span>
                        </button>
                    ))}
                </div>
            </div>
        </div>

        <div class="detail-card v-tile" id="timeline-detail">
            <span class="detail-pill v-chip v-chip--verdict" id="detail-pill">Live now</span>
            <h2 class="detail-title v-h3-plain" id="detail-title">NCAA Fantasy Launch</h2>
            <p class="detail-body v-body" id="detail-body">It's here. The same fantasy experience fans enjoyed during the pro season is now running for NCAA women's volleyball, tuned for the college game — shorter seasons, simpler scoring, and a more accessible format. Leagues are open now, and the first scoring round runs September 9–13. The season is ten rounds, each running Wednesday through Sunday, with Monday and Tuesday as the signing window to set your roster for the week ahead.</p>
        </div>
        </section>

        <p class="footer-note v-path">
            <span class="footer-dot" aria-hidden="true"></span>
            More details, announcements, and feature updates will roll out here as we build.
        </p>
      </div>
    </main>
</SiteLayout>

<script define:vars={{ details }}>
(function() {
    var scroll = document.getElementById('timeline-scroll');
    if (!scroll) return;

    var items = scroll.querySelectorAll('.timeline-item');
    var pill = document.getElementById('detail-pill');
    var titleEl = document.getElementById('detail-title');
    var bodyEl = document.getElementById('detail-body');

    function pillText(status, date, live) {
        // A shipped milestone is still the CURRENT one on the timeline, so it
        // keeps status 'current' for centering and styling — but it must not
        // still be advertised as upcoming once it has launched.
        if (live) return 'Live now';
        if (status === 'current' || status === 'upcoming') return 'Coming ' + date;
        return date;
    }

    function updateDetail(id) {
        var d = details[id];
        if (!d) return;
        pill.textContent = pillText(d.status, d.date, d.live);
        titleEl.textContent = d.title;
        bodyEl.textContent = d.body;
    }

    function selectItem(item) {
        items.forEach(function(i) { i.classList.remove('selected'); });
        item.classList.add('selected');
        updateDetail(item.getAttribute('data-id'));
    }

    items.forEach(function(item) {
        item.addEventListener('click', function() { selectItem(item); });
    });

    function centerCurrent() {
        var current = scroll.querySelector('.timeline-item.current') || items[0];
        if (!current) return;
        var target = current.offsetLeft + current.offsetWidth / 2 - scroll.clientWidth / 2;
        scroll.scrollLeft = Math.max(0, target);
        current.classList.add('selected');
        updateDetail(current.getAttribute('data-id'));
    }

    // Run after layout settles
    if (document.readyState === 'complete') centerCurrent();
    else window.addEventListener('load', centerCurrent);
})();
</script>

<style>
    .wn-title { margin: 0 0 12px; }
    .lead { margin: 0 0 32px; }

    /* Timeline: scrolls inside the plate, full-bleed to its edges */
    .timeline-wrap {
        margin-inline: calc(-1 * var(--plate-pad));
        margin-bottom: 16px;
    }
    .timeline-scroll {
        position: relative;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 8px 0 12px;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        scroll-behavior: smooth;
    }
    .timeline-scroll::-webkit-scrollbar { display: none; }
    .timeline-track {
        display: inline-flex;
        align-items: flex-start;
        position: relative;
        padding: 0 calc(50% - 75px);
    }
    .timeline-item {
        flex: 0 0 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 0;
        background: transparent;
        border: none;
        cursor: pointer;
        font-family: inherit;
        position: relative;
        z-index: 1;
    }
    .timeline-item:active { opacity: .72; }
    .timeline-item:focus-visible { outline: none; }
    .timeline-item:focus-visible .timeline-dot {
        box-shadow: 0 0 0 3px var(--ground), 0 0 0 4.5px var(--electric-blue);
    }
    .timeline-date {
        font: 700 10px/1.25 var(--font-body);
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--ink-2);
        white-space: nowrap;
        transition: color 150ms;
    }
    .timeline-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--line-plate);
        transition: background-color 150ms;
    }
    .timeline-title {
        font: 600 14px/1.3 var(--font-body);
        text-align: center;
        color: var(--ink);
        max-width: 130px;
    }

    /* States */
    .timeline-item.past .timeline-dot { background: var(--ink-off); }
    .timeline-item.past .timeline-title { color: var(--ink-2); }
    .timeline-item.upcoming .timeline-dot,
    .timeline-item.current .timeline-dot { background: var(--line-plate); }
    .timeline-item.current .timeline-dot {
        box-shadow: 0 0 0 3px var(--ground), 0 0 0 4.5px var(--lemon-lime);
    }
    .timeline-item.selected .timeline-dot { background: var(--lemon-lime); }
    .timeline-item.selected .timeline-date { color: var(--lemon-lime); }
    .timeline-item.selected .timeline-title { color: var(--ink); }
    .timeline-item.current.selected .timeline-title { font-weight: 700; }

    /* Detail */
    .detail-card { padding: 16px; }
    .detail-pill { margin-bottom: 12px; }
    .detail-title { margin: 0 0 8px; }
    .detail-body { margin: 0; }

    .footer-note {
        margin: 24px 0 0;
        text-align: center;
    }
    .footer-dot {
        display: inline-block;
        vertical-align: middle;
        margin: -2px 8px 0 0;
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--lemon-lime);
        flex-shrink: 0;
    }

    @media (max-width: 480px) {
        .timeline-track { padding: 0 calc(50% - 70px); }
        .timeline-item { flex-basis: 140px; }
    }
</style>
