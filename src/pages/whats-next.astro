---
import Layout from '../layouts/Layout.astro';

const timeline = [
  {
    id: 'fantasyvb', date: 'Mar 2024', dateFull: 'March 2024',
    title: 'FantasyVB Begins', status: 'past',
    body: "FantasyVB started as an experimental sandbox: a testbed to find out whether a real fantasy volleyball product was possible. The early work compared fantasy formats to find the one that fit volleyball best, built a scoring system that was fair across every position, and settled the tech stack. By the end, the answer was clear: it was possible, with a concrete plan for what it would take to ship it.",
  },
  {
    id: 'voli-app', date: 'Jan 2025', dateFull: 'January 2025',
    title: 'VOLI App Begins', status: 'past',
    body: "Development of the full VOLI app began in January 2025, and it launched in January 2026 with live games, stats, player and team pages, news and podcasts alongside fantasy, all on one data pipeline. Fantasy was validated through extensive simulations against two years of MLV data and one year of LOVB data before launch.",
  },
  {
    id: 'app-beta', date: 'Jan 2026', dateFull: 'January 2026',
    title: 'App Launch', status: 'past',
    body: "The app went public for the 2026 pro season with live MLV and LOVB games, stats, news, podcasts and MLV fantasy, the first time the fantasy system ran live with real managers instead of simulations. Volleyball creators brought VOLI to the fans most likely to put it through its paces: Major League Minute, Volley Talk with Sarah Pavan, and Court Captains. The season shaped everything that followed, starting with a scoring system rebuilt from the ground up for the college game.",
  },
  {
    id: 'ncaa-launch', date: 'Aug 2026', dateFull: 'August 2026',
    title: 'NCAA Season Launch', status: 'past',
    body: "NCAA Division I women's volleyball arrived in full for the 2026 season. NCAA fantasy launched with a ten-round season, each round Wednesday through Sunday, with Monday and Tuesday as the signing window. Live NCAA play-by-play arrived with it: more than 360,000 rallies logged so far this season, with substitutions and rotations. The Volleyball Encyclopedia opened with more than 18,000 honors back to 1979, the AVCA Coaches Poll since 1982 and all 45 NCAA champions. iPhone Live Activities put the live score on the lock screen.",
  },
  {
    id: 'voli-top-100', date: 'Sep 2026', dateFull: 'September 2026',
    title: 'The VOLI Top 100', status: 'current', live: true,
    body: "The VOLI Top 100, VOLI's own ranking of Division I teams from match results and strength of schedule, is published each Monday. Each upcoming college match in the app shows each team's chance to win and the most likely set score.",
  },
  {
    id: 'ncaa-bracket', date: 'Nov 2026', dateFull: 'November 2026',
    title: 'NCAA Bracket Challenge', status: 'upcoming',
    body: "A bracket challenge for the NCAA women's volleyball tournament. Pick the whole field, call the upsets, and follow it round by round against everyone else.",
  },
  {
    id: 'lovb-fantasy', date: 'Jan 2027', dateFull: 'January 2027',
    title: 'LOVB Fantasy Launch', status: 'upcoming',
    body: "LOVB joins the fantasy system, so managers can run teams across both pro leagues. VOLI has carried LOVB games, stats and player profiles since the league's first season.",
  },
];

const details = Object.fromEntries(timeline.map(t => [t.id, {
  date: t.dateFull,
  title: t.title,
  status: t.status,
  live: t.live === true,
  body: t.body,
}]));
---

<Layout
  title="VOLI Milestones and What's Next"
  description="VOLI milestones: the app launch, NCAA fantasy, live NCAA play-by-play, the Volleyball Encyclopedia, the VOLI Top 100, and what's coming next for fans."
  activePage="whats-next"
>
    <main class="card">
        <h1 class="title">Milestones</h1>
        <p class="lead">What VOLI has shipped for volleyball fans, and what's coming next.</p>

        <div class="section-label">Timeline</div>
        <div class="timeline-wrap">
            <div class="timeline-scroll" id="timeline-scroll">
                <div class="timeline-track">
                    {timeline.map(item => (
                        <button
                            type="button"
                            class:list={['timeline-item', item.status]}
                            data-id={item.id}
                            aria-label={`${item.dateFull} — ${item.title}`}
                        >
                            <span class="timeline-date">{item.date}</span>
                            <span class="timeline-dot" aria-hidden="true"></span>
                            <span class="timeline-title">{item.title}</span>
                        </button>
                    ))}
                </div>
            </div>
        </div>

        <div class="detail-card" id="timeline-detail">
            <span class="detail-pill" id="detail-pill">Live now</span>
            <h2 class="detail-title" id="detail-title">The VOLI Top 100</h2>
            <p class="detail-body" id="detail-body">The VOLI Top 100, VOLI's own ranking of Division I teams from match results and strength of schedule, is published each Monday. Each upcoming college match in the app shows each team's chance to win and the most likely set score.</p>
        </div>

        <div class="section-label milestones-label">All milestones</div>
        <ol class="milestone-list">
            {timeline.map(item => (
                <li class:list={['milestone', item.status]}>
                    <h2 class="milestone-title"><span class="milestone-date">{item.dateFull}</span>{item.title}{item.status === 'upcoming' && <span class="milestone-soon"> · coming</span>}</h2>
                    <p class="milestone-body">{item.body}</p>
                </li>
            ))}
        </ol>

        <p class="footer-note">
            <span class="footer-dot" aria-hidden="true"></span>
            More details, announcements, and feature updates will roll out here as we build.
        </p>
    </main>
</Layout>

<script define:vars={{ details }}>
(function() {
    var scroll = document.getElementById('timeline-scroll');
    if (!scroll) return;

    var items = scroll.querySelectorAll('.timeline-item');
    var pill = document.getElementById('detail-pill');
    var titleEl = document.getElementById('detail-title');
    var bodyEl = document.getElementById('detail-body');

    function pillText(status, date, live) {
        // A shipped milestone is still the CURRENT one on the timeline, so it
        // keeps status 'current' for centering and styling — but it must not
        // still be advertised as upcoming once it has launched.
        if (live) return 'Live now';
        if (status === 'current' || status === 'upcoming') return 'Coming ' + date;
        return date;
    }

    function updateDetail(id) {
        var d = details[id];
        if (!d) return;
        pill.textContent = pillText(d.status, d.date, d.live);
        titleEl.textContent = d.title;
        bodyEl.textContent = d.body;
    }

    function selectItem(item) {
        items.forEach(function(i) { i.classList.remove('selected'); });
        item.classList.add('selected');
        updateDetail(item.getAttribute('data-id'));
    }

    items.forEach(function(item) {
        item.addEventListener('click', function() { selectItem(item); });
    });

    function centerCurrent() {
        var current = scroll.querySelector('.timeline-item.current') || items[0];
        if (!current) return;
        var target = current.offsetLeft + current.offsetWidth / 2 - scroll.clientWidth / 2;
        scroll.scrollLeft = Math.max(0, target);
        current.classList.add('selected');
        updateDetail(current.getAttribute('data-id'));
    }

    // Run after layout settles
    if (document.readyState === 'complete') centerCurrent();
    else window.addEventListener('load', centerCurrent);
})();
</script>

<style>
    body {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 5rem 2rem 2rem;
        padding-top: calc(5rem + env(safe-area-inset-top));
    }

    .card {
        width: 100%;
        max-width: 800px;
        background: var(--bg-card);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 3rem 2rem;
        position: relative;
        overflow: hidden;
        margin-top: 1rem;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--glass-highlight), transparent);
    }

    .title {
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.75rem;
        letter-spacing: -0.02em;
    }

    .lead {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.7;
        text-align: center;
        margin-bottom: 2rem;
    }

    .section-label {
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-align: center;
        margin-bottom: 1rem;
    }

    /* Timeline */
    .timeline-wrap {
        margin: 0 -2rem 2rem;
    }

    .timeline-scroll {
        position: relative;
        overflow-x: auto;
        overflow-y: hidden;
        padding: 0.5rem 0 0.75rem;
        -webkit-overflow-scrolling: touch;
        scrollbar-width: none;
        scroll-behavior: smooth;
    }

    .timeline-scroll::-webkit-scrollbar { display: none; }

    .timeline-track {
        display: inline-flex;
        align-items: flex-start;
        position: relative;
        padding: 0 calc(50% - 75px);
    }

    .timeline-item {
        flex: 0 0 150px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
        padding: 0;
        background: transparent;
        border: none;
        cursor: pointer;
        font-family: inherit;
        position: relative;
        z-index: 1;
        transition: transform 0.2s;
    }

    .timeline-item:hover { transform: translateY(-2px); }
    .timeline-item:focus-visible { outline: none; }
    .timeline-item:focus-visible .timeline-dot {
        box-shadow: 0 0 0 4px var(--bg-card), 0 0 0 6px var(--accent);
    }

    .timeline-date {
        font-size: 0.65rem;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        font-weight: 700;
        color: var(--text-muted);
        white-space: nowrap;
        transition: color 0.2s;
    }

    .timeline-dot {
        width: 14px;
        height: 14px;
        border-radius: 50%;
        background: var(--bg-card);
        border: 2px solid var(--text-muted);
        box-shadow: 0 0 0 4px var(--bg-card);
        transition: all 0.2s;
    }

    .timeline-title {
        font-size: 0.78rem;
        font-weight: 600;
        line-height: 1.3;
        text-align: center;
        color: var(--text-primary);
        max-width: 130px;
        transition: color 0.2s;
    }

    /* States */
    .timeline-item.past .timeline-dot {
        background: var(--text-muted);
        border-color: var(--text-muted);
    }
    .timeline-item.past .timeline-date,
    .timeline-item.past .timeline-title { opacity: 0.65; }

    .timeline-item.upcoming .timeline-dot,
    .timeline-item.current .timeline-dot {
        background: var(--bg-card);
        border-color: var(--text-muted);
    }
    .timeline-item.upcoming .timeline-date,
    .timeline-item.upcoming .timeline-title,
    .timeline-item.current .timeline-date,
    .timeline-item.current .timeline-title { opacity: 0.85; }

    /* Selected: bright accent treatment (highlight follows selection) */
    .timeline-item.selected .timeline-dot {
        background: var(--accent);
        border-color: var(--accent);
        box-shadow: 0 0 0 4px var(--bg-card), 0 0 14px var(--accent-glow);
    }
    .timeline-item.selected .timeline-date { color: var(--accent); opacity: 1; }
    .timeline-item.selected .timeline-title { opacity: 1; }

    /* Current + Selected: also pulses to signal active project */
    .timeline-item.current.selected .timeline-dot {
        box-shadow: 0 0 0 4px var(--bg-card), 0 0 18px var(--accent-glow);
        animation: timelinePulse 2.2s ease-in-out infinite;
    }
    .timeline-item.current.selected .timeline-title { font-weight: 700; }

    @keyframes timelinePulse {
        0%, 100% { box-shadow: 0 0 0 4px var(--bg-card), 0 0 14px var(--accent-glow); }
        50% { box-shadow: 0 0 0 4px var(--bg-card), 0 0 26px var(--accent); }
    }

    /* Detail card */
    .detail-card {
        padding: 1.75rem 1.75rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        border-radius: 16px;
        margin-bottom: 2rem;
    }

    .detail-pill {
        display: inline-block;
        padding: 0.25rem 0.7rem;
        background: linear-gradient(135deg, rgba(200, 255, 0, 0.18), rgba(0, 212, 255, 0.12));
        border: 1px solid rgba(200, 255, 0, 0.35);
        border-radius: 100px;
        color: var(--accent);
        font-size: 0.65rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        margin-bottom: 0.85rem;
    }

    .detail-title {
        color: var(--text-primary);
        font-size: 1.2rem;
        font-weight: 650;
        letter-spacing: -0.01em;
        margin: 0 0 0.6rem;
    }

    .detail-body {
        color: var(--text-muted);
        font-size: 0.9rem;
        line-height: 1.65;
        margin: 0;
    }

    .footer-note {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.6rem;
        color: var(--text-muted);
        font-size: 0.8rem;
        line-height: 1.5;
        margin: 0;
        text-align: center;
    }

    .footer-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 8px var(--accent);
        animation: footerDot 1.6s ease-in-out infinite;
        flex-shrink: 0;
    }

    @keyframes footerDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.55; transform: scale(0.8); }
    }

    @media (max-width: 480px) {
        body { padding: 6rem 1rem 1rem; }
        .card { padding: 2rem 1.5rem; border-radius: 20px; }
        .title { font-size: 1.5rem; }
        .lead { font-size: 0.95rem; }
        .timeline-wrap { margin: 0 -1.5rem 1.75rem; }
        .timeline-track { padding: 0 calc(50% - 70px); }
        .timeline-item { flex-basis: 140px; }
        .detail-title { font-size: 1.05rem; }
    }

    .milestones-label { margin-top: 2.5rem; }
    .milestone-list { list-style: none; padding: 0; margin: 0 0 2rem; display: flex; flex-direction: column; gap: 0.75rem; }
    .milestone { padding: 1rem 1.25rem; background: rgba(255, 255, 255, 0.03); border: 1px solid var(--glass-border); border-radius: 14px; }
    .milestone-title { font-size: 1rem; font-weight: 650; color: var(--text-primary); margin-bottom: 0.4rem; }
    .milestone-date { display: block; color: var(--accent); font-size: 0.72rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.2rem; }
    .milestone-soon { color: var(--text-muted); font-weight: 500; font-size: 0.85rem; }
    .milestone-body { color: var(--text-secondary); font-size: 0.9rem; line-height: 1.6; }
</style>
