</Layout>

<style>
    body {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 5rem 2rem 2rem;
        padding-top: calc(5rem + env(safe-area-inset-top));
    }

    .card {
        width: 100%;
        max-width: 800px;
        background: var(--bg-card);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 3rem 2rem;
        position: relative;
        overflow: hidden;
        margin-top: 1rem;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--glass-highlight), transparent);
    }

    .app-icon {
        display: block;
        width: 80px;
        height: auto;
        border-radius: 18px;
        margin: 0 auto 1.25rem;
    }

    .title {
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
    }

    .subtitle {
        text-align: center;
        color: var(--text-muted);
        font-size: 1rem;
        margin-bottom: 1.5rem;
    }

    .store-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.5rem;
    }

    .rating-stars {
        display: flex;
        gap: 2px;
    }

    .rating-stars svg {
        width: 16px;
        height: 16px;
    }


    .section {
        margin-bottom: 2.5rem;
    }

    .section:last-child {
        margin-bottom: 0;
    }

    .section-label {
        color: var(--accent);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        text-align: center;
        margin-bottom: 1rem;
    }

    .section-text {
        color: var(--text-secondary);
        font-size: 1rem;
        line-height: 1.8;
        text-align: center;
    }

    .features-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .feature-row {
        display: flex;
        align-items: center;
        gap: 1rem;
        padding: 0.75rem 1rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        border-radius: 14px;
    }

    .feature-icon {
        width: 28px;
        height: 28px;
        object-fit: contain;
        flex-shrink: 0;
    }

    .feature-row strong {
        color: var(--text-primary);
        font-size: 0.95rem;
        font-weight: 600;
        display: block;
        margin-bottom: 0.1rem;
    }

    .feature-row span {
        color: var(--text-muted);
        font-size: 0.85rem;
    }

    .testimonials {
        columns: 2;
        column-gap: 0.75rem;
    }

    .testimonial {
        padding: 1rem 1.25rem;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--glass-border);
        border-radius: 14px;
        break-inside: avoid;
        margin-bottom: 0.75rem;
    }

    .testimonial p {
        color: var(--text-secondary);
        font-size: 0.85rem;
        line-height: 1.5;
        font-style: italic;
        margin-bottom: 0.5rem;
    }

    .testimonial span {
        color: var(--text-muted);
        font-size: 0.75rem;
    }

    .store-buttons {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 1.25rem;
        margin: 0 auto 2.5rem;
    }

    .store-downloads {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        white-space: nowrap;
        padding: 1rem 0;
    }

    .store-downloads-num {
        color: var(--text-primary);
        font-size: 1.5rem;
        font-weight: 700;
        line-height: 1.1;
    }

    .store-downloads-label {
        color: var(--text-muted);
        font-size: 0.75rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .btn-store {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        background: var(--bg-card);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 14px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-store:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.15);
        transform: translateY(-2px);
    }

    .btn-store svg {
        width: 28px;
        height: 28px;
        flex-shrink: 0;
    }

    .btn-store-text {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        text-align: left;
    }

    .btn-store-label {
        font-size: 0.65rem;
        font-weight: 400;
        color: white;
        opacity: 0.7;
    }

    .btn-store-name {
        font-size: 1rem;
        font-weight: 600;
        color: white;
        line-height: 1;
        margin-top: 2px;
    }

    @media (max-width: 480px) {
        body { padding: 6rem 1rem 1rem; }
        .card { padding: 2rem 1.5rem; border-radius: 20px; }
        .title { font-size: 1.5rem; }
        .section-text { font-size: 0.95rem; }
        .testimonials { columns: 1; }
        .store-buttons { gap: 0.75rem; flex-wrap: wrap; justify-content: center; }
        .store-downloads { width: 100%; order: -1; padding: 0 0 0.25rem; }
