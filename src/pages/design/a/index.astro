---
// DESIGN OPTION A, "BROADCAST": the home page. It replaces the two-step home
// (the splash at / and the overview at /app): this page IS the overview.
// Every number and sentence comes from lib/voli-facts and lib/bracket-facts.
import OptionA from '../../../layouts/design/OptionA.astro';
import Arrow from '../../../components/design/a/Arrow.astro';
import Stores from '../../../components/design/a/Stores.astro';
import { DOWNLOADS, FACTS, FACTS_AS_OF, FAQS, NEWS_OUTLETS, PODCASTS, TESTIMONIALS, appSchemaWithReviews, linkify } from '../../../lib/voli-facts';
import { BRACKET, BRACKET_STATUS, bracketPhase, promoIsLive } from '../../../lib/bracket-facts';

const phase = bracketPhase();
const promoOn = promoIsLive(phase);
const BRACKET_PREVIEW = '/design/a/bracket';

// A figure's digits stay white and its marks (+ % ~ &) take the accent.
const numParts = (v: string) =>
  v.split(/([^0-9.,\s]+)/).filter((s) => s !== '').map((s) => ({ s, sym: /[^0-9.,\s]/.test(s) }));

// Fantasy first, wherever the parts of the app are listed.
const INDEX = [
  { id: 'fantasy', label: 'Fantasy' },
  { id: 'games', label: 'Games' },
  { id: 'stats', label: 'Stats' },
  { id: 'rankings', label: 'Rankings' },
  { id: 'encyclopedia', label: 'Encyclopedia' },
  { id: 'news', label: 'News and podcasts' },
  { id: 'community', label: 'Community' },
  { id: 'evollve', label: 'Analytics by EVOLLVE' },
];

// Four of the site's questions, word for word; the rest are on /faq.
const homeFaqs = ['what', 'fantasy', 'box-scores', 'free'].map((id) => FAQS.find((f) => f.id === id)!);

const episodes = PODCASTS.reduce((n, p) => n + p.episodes, 0);

// The app entity, with the four testimonials this page shows as its reviews
// (as /app publishes today). This page is the home, so the app's own page is
// / here and not /app: a page-specific copy, because lib/voli-facts still says
// /app. When this design ships, change the url there and send /app to /.
const appSchema = { ...appSchemaWithReviews, url: 'https://playvoli.com/' };
---

<OptionA
  page="home"
  title="VOLI App - The Volleyball Hub"
  description="Free volleyball app for NCAA women's volleyball, MLV and LOVB: fantasy leagues, live scores and box scores, stats, rankings, history, news and podcasts."
  canonical="https://playvoli.com/"
  schema={[appSchema]}
>
    {/* ------------------------------------------------------------------ the open */}
    <section class="a-band a-open" aria-labelledby="a-h1">
        <div class="a-frame">
            <div class="a-open__top">
                <h1 class="a-open__h1" id="a-h1">
                    <span class="a-open__label">VOLI, the volleyball app</span><span class="a-vh">: </span>
                    <span class="a-open__big"><span>You asked.</span> <span class="a-open__lime">We built it.</span></span>
                </h1>
                <div class="a-open__side">
                    <p class="a-open__lede">Fantasy volleyball, live games, stats, rankings and volleyball history for NCAA Division I women's volleyball, MLV and LOVB, with volleyball news and podcasts in one feed. Free on iPhone and Android.</p>
                    <Stores />
                    <p class="a-open__dl"><b>{DOWNLOADS}</b> <span>downloads on iPhone and Android</span></p>
                </div>
            </div>

            <div class="a-score">
                <div class="a-score__bar">
                    <h2 class="a-score__title" id="facts-h">What's in VOLI</h2>
                    <p class="a-score__asof">As of {FACTS_AS_OF}</p>
                </div>
                <ul class="a-score__cells" aria-labelledby="facts-h">
                    {FACTS.map((f) => (
                        <li>
                            <strong class="a-num">{numParts(f.value).map((p) => p.sym ? <i class={p.s === '~' ? 'a-num__approx' : undefined}>{p.s}</i> : p.s)}</strong>
                            <span class="a-score__what">{f.label}</span>
                        </li>
                    ))}
                </ul>
            </div>

            <div class="a-wall" role="group" aria-label="The VOLI app on iPhone" tabindex="0">
                <figure class="a-mon a-mon--pgm">
                    <span class="a-mon__tally"><i aria-hidden="true"></i>Most used</span>
                    <div class="a-mon__pic"><img src="/images/screenshots/home-fantasy.webp" alt="The Fantasy tab in VOLI on an iPhone: two fantasy teams with their points for the round and where each stands in its leagues" width="640" height="1280" fetchpriority="high" decoding="async"></div>
                    <figcaption class="a-mon__umd"><span class="a-plate">01</span><b>Fantasy</b><span class="a-mon__what">Your teams and leagues</span></figcaption>
                </figure>
                <figure class="a-mon">
                    <div class="a-mon__pic"><img src="/images/screenshots/home-games.webp" alt="The Games tab in VOLI on an iPhone: the October 2026 calendar and the day's college matches, each showing both teams' chance to win" width="640" height="1280" decoding="async"></div>
                    <figcaption class="a-mon__umd"><span class="a-plate a-plate--ink">02</span><b>Games</b><span class="a-mon__what">The day's schedule</span></figcaption>
                </figure>
                <figure class="a-mon">
                    <div class="a-mon__pic"><img src="/images/screenshots/home-stats.webp" alt="The Stats tab in VOLI on an iPhone: a setter's player card with season totals, percentile ranks and analytics by EVOLLVE" width="640" height="1280" decoding="async"></div>
                    <figcaption class="a-mon__umd"><span class="a-plate a-plate--ink">03</span><b>Stats</b><span class="a-mon__what">A player's analytics card</span></figcaption>
                </figure>
            </div>
        </div>
    </section>

    {/* ------------------------------------------- coming up: the Bracket Challenge */}
    {promoOn && (
        <section class="a-band a-next" aria-labelledby="a-next-h" data-bracket-promo>
            <div class="a-frame a-next__in">
                <div class="a-next__art">
                    <img src="/images/bracket/bracket-challenge-2026-logo.webp" alt="College Volleyball '26 Bracket Challenge, presented by VOLI" width="840" height="486" loading="lazy" decoding="async">
                </div>
                <div class="a-next__copy">
                    <p class="a-next__kicker"><i class={`a-dot a-dot--phase a-dot--${phase}`} aria-hidden="true"></i><span data-bracket-status="short">{BRACKET_STATUS[phase].short}</span><span class="a-label">Coming up in VOLI</span></p>
                    <h2 class="a-next__title" id="a-next-h">{BRACKET.name}</h2>
                    <p class="a-next__sub"><b>{BRACKET.prize} cash</b> to the top eligible bracket. Free to play.</p>
                    <p class="a-next__legal">No purchase necessary. 50 U.S. states &amp; D.C., 18+ (19+ AL/NE, 21+ MS). <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
                </div>
                <div class="a-next__go">
                    <dl>
                        <div><dt>{BRACKET.matches}</dt><dd>matches to pick</dd></div>
                        <div><dt>{BRACKET.teams}</dt><dd>teams in the field</dd></div>
                        <div><dt>{BRACKET.maxPoints}</dt><dd>points at most</dd></div>
                    </dl>
                    <a class="a-btn a-btn--lime a-btn--big" href={BRACKET_PREVIEW}>Play free <Arrow /></a>
                </div>
            </div>
        </section>
    )}

    {/* -------------------------------------------------------------- the app */}
    <section class="a-band" id="app" aria-labelledby="a-app-h">
        <div class="a-frame">
            <header class="a-head">
                <p class="a-head__kicker"><span class="a-plate">The app</span></p>
                <h2 class="a-head__title" id="a-app-h">What you can do in VOLI</h2>
                <p class="a-head__note">Eight parts of one app, for NCAA Division I women's volleyball, MLV and LOVB. Fantasy is optional: everything else works without it.</p>
            </header>

            <nav class="a-index" aria-label="What you can do in VOLI">
                <ol>
                    {INDEX.map((f, i) => (
                        <li><a href={`#${f.id}`}><span>{String(i + 1).padStart(2, '0')}</span> {f.label}</a></li>
                    ))}
                </ol>
            </nav>

            <article class="a-board" id="fantasy">
                <div class="a-board__text">
                    <p class="a-board__no"><span class="a-plate">01</span><em class="a-tag"><i class="a-dot a-dot--air" aria-hidden="true"></i>Most used</em></p>
                    <h3 class="a-board__title">Fantasy leagues</h3>
                    <p class="a-board__p">Build a team from real college and pro players and play the season against your friends. Leagues use a salary cap and multi-round contracts, for NCAA Division I women's volleyball and MLV, and the NCAA season runs in ten rounds, Wednesday to Sunday. Join a public league run by a volleyball podcast, or start a private one.</p>
                    <dl class="a-spec">
                        <div><dt>Leagues</dt><dd>NCAA Division I women's volleyball and MLV</dd></div>
                        <div><dt>Format</dt><dd>A salary cap and multi-round contracts</dd></div>
                        <div><dt>NCAA season</dt><dd>Ten rounds, Wednesday to Sunday</dd></div>
                        <div><dt>Play in</dt><dd>A public league run by a volleyball podcast, or a private one</dd></div>
                    </dl>
                </div>
                <div class="a-board__media">
                    <figure class="a-phone">
                        <img src="/images/screenshots/fantasy3.webp" alt="A fantasy roster in VOLI: $98.2K of a $100K salary cap used, and six starters with their salaries and points" width="1000" height="2000" loading="lazy" decoding="async">
                        <figcaption>Roster <span>$100K salary cap</span></figcaption>
                    </figure>
                    <div class="a-ins">
                        <figure>
                            <img src="/images/splash/card-fantasy.webp" alt="A player's fantasy card in VOLI: price $24.2K, 157.83 season points, average per round, value per $1k, the share of teams rostering her, and points by round" width="900" height="756" loading="lazy" decoding="async">
                            <figcaption>A player's fantasy card: price, points and form by round</figcaption>
                        </figure>
                    </div>
                </div>
            </article>

            <article class="a-board" id="games">
                <div class="a-board__text">
                    <p class="a-board__no"><span class="a-plate a-plate--ink">02</span></p>
                    <h3 class="a-board__title">Live games</h3>
                    <p class="a-board__p">Scores and box scores for college and pro matches as they happen, with a lead chart for each set, and play-by-play with the rotation on court for MLV and LOVB matches. On iPhone, keep the score on your lock screen with Live Activities.</p>
                    <dl class="a-spec">
                        <div><dt>Live</dt><dd>Scores and box scores, college and pro</dd></div>
                        <div><dt>Each set</dt><dd>A lead chart</dd></div>
                        <div><dt>Play-by-play</dt><dd>MLV and LOVB matches, with the rotation on court</dd></div>
                        <div><dt>iPhone</dt><dd>Live Activities on the lock screen</dd></div>
                    </dl>
                </div>
                <div class="a-board__media">
                    <figure class="a-phone">
                        <img src="/images/screenshots/games2.webp" alt="Play-by-play of a pro match in VOLI: Austin against Atlanta, each rally listed with the score" width="1000" height="2000" loading="lazy" decoding="async">
                        <figcaption>Play-by-play <span>MLV and LOVB</span></figcaption>
                    </figure>
                    <div class="a-ins">
                        <figure>
                            <img src="/images/splash/card-game.webp" alt="A game card in VOLI: LSU at Tennessee, with each team's chance to win, 6% and 94%" width="900" height="296" loading="lazy" decoding="async">
                            <figcaption>Before first serve: each team's chance to win</figcaption>
                        </figure>
                        <figure>
                            <img src="/images/splash/float-final.webp" alt="A final score in VOLI: Pitt beat SMU 3-0, with set scores 25-12, 25-21 and 26-24" width="760" height="397" loading="lazy" decoding="async">
                            <figcaption>The final, set by set</figcaption>
                        </figure>
                    </div>
                </div>
            </article>

            <article class="a-board" id="stats">
                <div class="a-board__text">
                    <p class="a-board__no"><span class="a-plate a-plate--ink">03</span></p>
                    <h3 class="a-board__title">Stats and box scores</h3>
                    <p class="a-board__p">Nearly 500,000 NCAA player box-score lines since 2023, covering 99.8% of completed Division I matches, and set-by-set player stats for all 445 MLV and LOVB matches. Leaderboards sort by season, conference, position and class, in totals or per set.</p>
                    <dl class="a-spec a-spec--num">
                        <div><dt><span>~</span>500,000</dt><dd>NCAA player box-score lines since 2023</dd></div>
                        <div><dt>99.8%</dt><dd>of completed Division I matches since 2023 have a box score</dd></div>
                        <div><dt>445</dt><dd>MLV and LOVB matches, all with set-by-set player stats</dd></div>
                    </dl>
                </div>
                <div class="a-board__media">
                    <figure class="a-phone">
                        <img src="/images/screenshots/stats1.webp" alt="A stats leaderboard in VOLI: players ranked by hitting efficiency, with position and team" width="1000" height="2000" loading="lazy" decoding="async">
                        <figcaption>Leaderboard <span>Hitting efficiency</span></figcaption>
                    </figure>
                    <div class="a-ins">
                        <figure>
                            <img src="/images/splash/card-stats.webp" alt="A player card in VOLI: Kate Duffey, UCLA setter, with a .243 team hitting efficiency, 376 assists, 3 aces, 7.5 blocks and 96 digs" width="900" height="399" loading="lazy" decoding="async">
                            <figcaption>A player's card: season totals and per-set rates</figcaption>
                        </figure>
                        <dl class="a-mini">
                            <div><dt>Sort by</dt><dd>Season, conference, position and class</dd></div>
                            <div><dt>View</dt><dd>Totals or per set</dd></div>
                        </dl>
                    </div>
                </div>
            </article>

            <div class="a-rows">
                <article class="a-row" id="rankings">
                    <div class="a-row__head">
                        <span class="a-plate a-plate--ink">04</span>
                        <h3 class="a-row__title">Rankings and predictions</h3>
                    </div>
                    <div class="a-row__body">
                        <p>The VOLI Top 100, VOLI's own ranking of Division I teams from match results and strength of schedule, published each Monday. Before first serve, each upcoming college match shows each team's chance to win and the most likely set score, and the chance to win updates after every set. All next to the AVCA Coaches Poll and EVOLLVE's ratings.</p>
                        <p class="a-board__links">
                            <a class="a-link" href="/rankings">The VOLI Top 100 <Arrow /></a>
                            <a class="a-link" href="/methods">How it works <Arrow /></a>
                        </p>
                    </div>
                    <div class="a-row__media">
                        <figure class="a-cut">
                            <img src="/images/splash/float-rank.webp" alt="A ranking row in VOLI: Nebraska at number 1, 15-0 overall and 4-0 in conference" width="760" height="132" loading="lazy" decoding="async">
                            <figcaption>A ranking row in the app</figcaption>
                        </figure>
                    </div>
                </article>

                <article class="a-row" id="encyclopedia">
                    <div class="a-row__head">
                        <span class="a-plate a-plate--ink">05</span>
                        <h3 class="a-row__title">The Volleyball Encyclopedia</h3>
                    </div>
                    <div class="a-row__body">
                        <p>More than 18,000 honors back to 1979: 3,000+ AVCA All-America selections since 1981, the AVCA Coaches Poll since 1982, all 45 NCAA champions, ACC, Big 12, Big Ten and SEC honors, record books, the MLV Draft and pro league honors.</p>
                    </div>
                    <div class="a-row__media">
                        <dl class="a-mini">
                            <div><dt>18,000<i>+</i></dt><dd>honors, back to 1979</dd></div>
                            <div><dt>3,000<i>+</i></dt><dd>AVCA All-America selections since 1981</dd></div>
                            <div><dt>45</dt><dd>NCAA champions, all of them</dd></div>
                            <div><dt>1982</dt><dd>the AVCA Coaches Poll, from then on</dd></div>
                        </dl>
                    </div>
                </article>

                <article class="a-row" id="news">
                    <div class="a-row__head">
                        <span class="a-plate a-plate--ink">06</span>
                        <h3 class="a-row__title">News and podcasts</h3>
                    </div>
                    <div class="a-row__body">
                        <p>Volleyball news from 19 outlets, from league and conference sites to independent writers, each story linked to its source. And 12 volleyball podcasts with more than 800 episodes to stream or download, with your place saved across devices.</p>
                        <p class="a-board__links">
                            <a class="a-link" href="#feed">The outlets and the podcasts <Arrow dir="down" /></a>
                        </p>
                    </div>
                    <div class="a-row__media">
                        <figure class="a-cut">
                            <img src="/images/splash/float-article.webp" alt="A news story in VOLI: 'No. 1 Nebraska Volleyball Looks to Continue Firing on All Cylinders in Week Four of Big …', by Jacob Padilla, tagged NCAA, Big Ten and UNL" width="760" height="468" loading="lazy" decoding="async">
                            <figcaption>A story in the feed, linked to its publisher</figcaption>
                        </figure>
                    </div>
                </article>

                <article class="a-row" id="community">
                    <div class="a-row__head">
                        <span class="a-plate a-plate--ink">07</span>
                        <h3 class="a-row__title">Community</h3>
                    </div>
                    <div class="a-row__body">
                        <p>A chat room for every match, rooms for NCAA, MLV and LOVB fans, and a private chat for each fantasy league. Partner podcasts host AMAs with players and creators right in the app.</p>
                    </div>
                    <div class="a-row__media">
                        <figure class="a-cut">
                            <img src="/images/splash/float-chat.webp" alt="The NCAA fan room in VOLI's chat list, with its latest message: 'yeah, Wisconsin seems like the most likely to …'" width="760" height="117" loading="lazy" decoding="async">
                            <figcaption>The NCAA room in the chat list</figcaption>
                        </figure>
                    </div>
                </article>

                <article class="a-row" id="evollve">
                    <div class="a-row__head">
                        <span class="a-plate a-plate--ink">08</span>
                        <h3 class="a-row__title">Analytics by EVOLLVE</h3>
                    </div>
                    <div class="a-row__body">
                        <p>EVOLLVE's college volleyball analytics are built in: nightly team ratings for every Division I team, player impact numbers like RAPM, and match predictions.</p>
                        <p class="a-board__links">
                            <a class="a-link" href="/evollve">EVOLLVE in VOLI <Arrow /></a>
                        </p>
                    </div>
                    <div class="a-row__media">
                        <figure class="a-cut">
                            <img src="/images/splash/float-pct.webp" alt="An EVOLLVE analytics card in VOLI: a setter's RAPM of +0.40, ranked 52 of 893 setters, in the 95th percentile" width="760" height="392" loading="lazy" decoding="async">
                            <figcaption>A setter's RAPM and percentile, by EVOLLVE</figcaption>
                        </figure>
                    </div>
                </article>
            </div>
        </div>
    </section>

    {/* ------------------------------------------------------------- the feed */}
    <section class="a-band" id="feed" aria-label="Where VOLI's news and podcasts come from">
        <div class="a-frame a-feed">
            <div class="a-feed__col">
                <header class="a-head a-head--sm">
                    <p class="a-head__kicker"><span class="a-plate">{NEWS_OUTLETS.length} outlets</span></p>
                    <h2 class="a-head__title">Where the news comes from</h2>
                </header>
                <ol class="a-outlets">
                    {NEWS_OUTLETS.map((o) => <li>{o}</li>)}
                </ol>
                <p class="a-feed__p">Coverage spans NCAA women's volleyball, MLV and LOVB: results, previews, transfers, rankings and awards. Every story opens on its publisher's site.</p>
            </div>
            <div class="a-feed__col">
                <header class="a-head a-head--sm">
                    <p class="a-head__kicker"><span class="a-plate">{PODCASTS.length} podcasts</span></p>
                    <h2 class="a-head__title">Volleyball podcasts on VOLI</h2>
                </header>
                <table class="a-table a-pods">
                    <caption class="a-vh">The {PODCASTS.length} volleyball podcasts on VOLI, who makes each one, and how many episodes it has</caption>
                    <thead>
                        <tr><th scope="col">Podcast</th><th scope="col" class="a-by">By</th><th scope="col" class="a-r">Episodes</th></tr>
                    </thead>
                    <tbody>
                        {PODCASTS.map((p) => (
                            <tr class={p.partner ? 'is-partner' : undefined}>
                                <th scope="row">{p.name}{p.partner && <em class="a-tag">Partner</em>}</th>
                                <td class="a-by">{p.by}</td>
                                <td class="a-r">{p.episodes}</td>
                            </tr>
                        ))}
                    </tbody>
                    <tfoot>
                        <tr><th scope="row">All podcasts</th><td class="a-by"></td><td class="a-r">{episodes}</td></tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </section>

    {/* ------------------------------------------------------- what users say */}
    <section class="a-band" aria-labelledby="a-say-h">
        <div class="a-frame a-say">
            <h2 class="a-say__h" id="a-say-h"><span class="a-plate">What users say</span></h2>
            <ul class="a-say__list">
                {TESTIMONIALS.map((t) => (
                    <li>
                        <blockquote><p>{t}</p></blockquote>
                        <p class="a-label a-say__who">VOLI app user</p>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    {/* ------------------------------------------------------------ questions */}
    <section class="a-band" id="questions" aria-labelledby="a-qa-h">
        <div class="a-frame">
            <header class="a-head">
                <p class="a-head__kicker"><span class="a-plate">Q + A</span></p>
                <h2 class="a-head__title" id="a-qa-h">Questions about VOLI</h2>
                <p class="a-head__note"><a class="a-btn" href="/faq">All questions <Arrow /></a></p>
            </header>
            <div class="a-qa">
                {homeFaqs.map((f) => (
                    <div class="a-qa__item" id={`q-${f.id}`}>
                        <h3 class="a-qa__q">{f.q}</h3>
                        <p class="a-qa__a" set:html={linkify(f.a)} />
                    </div>
                ))}
            </div>
        </div>
    </section>

    {/* -------------------------------------------------------------- leagues */}
    <section class="a-band" id="leagues" aria-labelledby="a-lg-h">
        <div class="a-frame">
            <header class="a-head">
                <p class="a-head__kicker"><span class="a-plate">Coverage</span></p>
                <h2 class="a-head__title" id="a-lg-h">Leagues we cover</h2>
            </header>
            <div class="a-leagues">
                <a class="a-league" href="https://lovb.com" target="_blank" rel="noopener">
                    <span class="a-league__mark">LOVB</span>
                    <span class="a-league__full">League One Volleyball <Arrow dir="out" size={11} /></span>
                </a>
                <a class="a-league" href="https://provolleyball.com" target="_blank" rel="noopener">
                    <span class="a-league__mark">MLV</span>
                    <span class="a-league__full">Major League Volleyball <Arrow dir="out" size={11} /></span>
                </a>
                <a class="a-league" href="https://www.ncaa.com/sports/volleyball-women" target="_blank" rel="noopener">
                    <span class="a-league__mark">NCAA</span>
                    <span class="a-league__full">Women's Division I <Arrow dir="out" size={11} /></span>
                </a>
            </div>
            <p class="a-leagues__note">VOLI is an independent fan platform, not affiliated with or endorsed by these leagues.</p>
        </div>
    </section>

    {/* ----------------------------------------------------------------- more */}
    <section class="a-band" aria-labelledby="a-more-h">
        <div class="a-frame">
            <h2 class="a-vh" id="a-more-h">More about VOLI</h2>
            <nav class="a-more" aria-labelledby="a-more-h">
                <a href="/rankings"><b>VOLI Top 100 <Arrow /></b><span>VOLI's ranking of Division I teams. It updates each Monday.</span></a>
                <a href="/faq"><b>Questions about VOLI <Arrow /></b><span>Fantasy, NCAA box scores, the VOLI Top 100, AVCA history and the leagues covered.</span></a>
                <a href="/methods"><b>How VOLI's numbers work <Arrow /></b><span>Where the stats come from, and how the VOLI Top 100 and chance to win are computed.</span></a>
                <a href="/about"><b>About VOLI <Arrow /></b><span>The mission, the two founders and the products.</span></a>
            </nav>
