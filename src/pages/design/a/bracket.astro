---
// DESIGN OPTION A, "BROADCAST": the College Volleyball Bracket Challenge.
// Same content as /bracket, from lib/bracket-facts. The prize, eligibility and
// legal wording is the reviewed text of the live page, restyled and not
// rewritten.
//
// THE LENGTH. One page, nothing behind tabs. A rundown down the left names the
// seven parts and follows you as you read (a strip across the top on a
// tablet), the facts are set as boards instead of paragraphs, and the eleven
// questions fold. On a phone the seven parts fold too, so the rundown IS the
// page: seven bars, the first one open. Every word is in the HTML and readable
// without scripts: every part and every question is open in the markup, and a
// script does the folding.
import OptionA from '../../../layouts/design/OptionA.astro';
import Arrow from '../../../components/design/a/Arrow.astro';
import Stores from '../../../components/design/a/Stores.astro';
import { faqSchema, linkify } from '../../../lib/voli-facts';
import {
  BRACKET, BRACKET_DATES, BRACKET_FAQS, BRACKET_ROUNDS, BRACKET_STATUS, BRACKET_STEPS, bracketPhase, promoIsLive,
} from '../../../lib/bracket-facts';

const HOME = '/design/a/';

// What search results and link previews say follows the calendar on each
// build, exactly as on the live page.
const phase = bracketPhase();
const live = promoIsLive(phase);
const title = live
  ? 'College Volleyball Bracket Challenge 2026: Win $500 Cash | VOLI'
  : 'College Volleyball Bracket Challenge 2026 | VOLI';
const description = live
  ? "Pick the 2026 NCAA Division I women's volleyball tournament in VOLI's free bracket game. $500 cash to the top eligible bracket. Opens Nov. 29, locks Dec. 3."
  : phase === 'locked'
    ? "The 2026 College Volleyball Bracket Challenge is under way in the VOLI app. Brackets are locked, and every pick for the NCAA Division I women's volleyball tournament is scored live."
    : "The 2026 College Volleyball Bracket Challenge, VOLI's free bracket game for the NCAA Division I women's volleyball tournament, is complete.";
const ogImage = 'https://playvoli.com/images/bracket/bracket-challenge-2026-og.png';
const afterHeadline = `Picks are in for ${BRACKET.season}. Follow the leaderboard in the VOLI app.`;

const totalMatches = BRACKET_ROUNDS.reduce((n, r) => n + r.matches, 0);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${BRACKET.url}#webpage`,
    url: BRACKET.url,
    name: 'College Volleyball Bracket Challenge 2026',
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://playvoli.com/#website' },
    publisher: { '@id': 'https://playvoli.com/#organization' },
    about: { '@type': 'Thing', name: "2026 NCAA Division I women's volleyball tournament" },
    mentions: { '@id': 'https://playvoli.com/#app' },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    breadcrumb: { '@id': `${BRACKET.url}#breadcrumb` },
    dateModified: new Date().toISOString().slice(0, 10),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${BRACKET.url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VOLI', item: 'https://playvoli.com/' },
      { '@type': 'ListItem', position: 2, name: 'College Volleyball Bracket Challenge', item: BRACKET.url },
    ],
  },
  faqSchema(BRACKET_FAQS, BRACKET.url),
];

// The rundown: the page's seven parts, in order.
const PARTS = [
  { id: 'how-it-works', label: 'How it works' },
  { id: 'scoring', label: 'Scoring' },
  { id: 'dates', label: 'Key dates' },
  { id: 'prize', label: 'The prize' },
  { id: 'groups', label: 'Friend groups' },
  { id: 'faq', label: 'Questions' },
  { id: 'voli', label: 'More in VOLI' },
];
const no = (id: string) => String(PARTS.findIndex((p) => p.id === id) + 1).padStart(2, '0');
const label = (id: string) => PARTS.find((p) => p.id === id)!.label;

// A lamp beside the two dates that open and close the game.
const lamp = (what: string) => (what === 'Brackets lock' ? 'is-lock' : what.startsWith('The field') ? 'is-open' : undefined);
---

<OptionA page="bracket" title={title} description={description} canonical={BRACKET.url} ogImage={ogImage} schema={schema}>
    {/* ------------------------------------------------------------------ hero */}
    <section class="a-band a-bk" aria-labelledby="a-bk-h1">
        <div class="a-frame">
            <nav class="a-crumb" aria-label="Breadcrumb">
                <ol>
                    <li><a href={HOME}>VOLI</a></li>
                    <li aria-current="page">{BRACKET.name}</li>
                </ol>
            </nav>

            <div class="a-bk__top">
                <div class="a-bk__copy">
                    <h1 class="a-bk__h1" id="a-bk-h1">
                        <span class="a-open__label">{BRACKET.name} {BRACKET.season}</span><span class="a-vh">: </span>
                        <span class="a-bk__big" id="bracket-heading" data-bracket-after={live ? afterHeadline : undefined}>{live
                            ? <Fragment><span class="a-bk__l1">Pick all {BRACKET.matches} matches.</span> The top eligible bracket wins <span class="a-lime">{BRACKET.prize} cash</span>.</Fragment>
                            : afterHeadline}</span>
                    </h1>

                    {/* A friend-group invite, /bracket?g=CODE. Shown only when the address carries a code. */}
                    <div class="a-bk__group" id="group-code" hidden>
                        <p class="a-bk__group-t">You're invited to a Bracket Challenge group</p>
                        <p class="a-bk__group-c"><span class="a-label">Group code</span> <span class="a-bk__group-v" id="group-code-value"></span></p>
                        <p class="a-bk__group-h">If VOLI doesn't open on its own, enter this under Bracket &rarr; Group in the app.</p>
                    </div>

                    <p class="a-bk__lede">A free bracket game for the {BRACKET.season} NCAA Division I women's volleyball tournament. Fill out your bracket in the VOLI app, then follow every pick on a live leaderboard.</p>

                    <p class="a-bk__status">
                        <span class="a-bk__status-tag"><i class={`a-dot a-dot--phase a-dot--${phase}`} aria-hidden="true"></i>Status</span>
                        <span class="a-bk__status-text" data-bracket-status="long">{BRACKET_STATUS[phase].long}</span>
                    </p>

                    <div class="a-bk__actions">
                        <a href="voli://bracket" id="open-bracket-btn" class="a-btn a-btn--lime a-btn--big a-bk__open">Open the Bracket Challenge <Arrow /></a>
                        <a href="/download" class="a-btn a-btn--lime a-btn--big a-bk__get">Get the app to play <Arrow dir="down" /></a>
                        <Stores id="get-the-app" />
                    </div>

                    <p class="a-bk__fine">No purchase necessary. 50 U.S. states &amp; D.C., 18+ (19+ AL/NE, 21+ MS). <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
                </div>

                <div class="a-bk__art">
                    <img src="/images/bracket/bracket-challenge-2026-logo.webp" alt="College Volleyball '26 Bracket Challenge, presented by VOLI" width="840" height="486" fetchpriority="high" decoding="async">
                </div>

                <ul class="a-bk__glance" aria-label="The Bracket Challenge at a glance">
                    <li><strong class="a-lime">{BRACKET.prize}</strong><span>cash to the top eligible bracket</span></li>
                    <li><strong>Free</strong><span>to enter, with no purchase necessary</span></li>
                    <li><strong>{BRACKET.matches}</strong><span>matches to pick, plus a tiebreaker</span></li>
                    <li><strong>Nov. 29</strong><span>brackets open once the field is set</span></li>
                </ul>
            </div>
        </div>
    </section>

    {/* ---------------------------------------------- the rundown and the parts */}
    <div class="a-band a-bkb">
        <div class="a-frame a-bkb__grid">
            <nav class="a-rail" aria-label="On this page">
                <div class="a-rail__in">
                    <p class="a-label a-rail__t">On this page</p>
                    <ol>
                        {PARTS.map((p, i) => (
                            <li><a href={`#${p.id}`}><span>{String(i + 1).padStart(2, '0')}</span> {p.label}</a></li>
                        ))}
                    </ol>
                    <p class="a-rail__foot"><a class="a-link" href={BRACKET.rulesPath}>Official Rules</a></p>
                </div>
            </nav>

            <div class="a-bkb__main">
                <section class="a-seg" id="how-it-works" aria-labelledby="how-h">
                    <header class="a-seg__head"><span class="a-plate">{no('how-it-works')}</span><h2 class="a-seg__title" id="how-h">How the Bracket Challenge works</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('how-it-works')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <ol class="a-steps">
                        {BRACKET_STEPS.map((s) => (
                            <li>
                                <h3>{s.title}</h3>
                                <p>{s.text}</p>
                            </li>
                        ))}
                    </ol>
                    </details>
                </section>

                <section class="a-seg" id="scoring" aria-labelledby="scoring-h">
                    <header class="a-seg__head"><span class="a-plate">{no('scoring')}</span><h2 class="a-seg__title" id="scoring-h">How a bracket is scored</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('scoring')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <div class="a-split">
                        <p class="a-split__a">Every correct pick earns points, and a correct pick is worth more in each later round. Every round adds up to 32 points, so a perfect bracket scores {BRACKET.maxPoints}.</p>
                        <div class="a-split__t">
                            <table class="a-table a-rounds">
                                <caption>Points for each round of the bracket</caption>
                                <thead>
                                    <tr><th scope="col">Round</th><th scope="col" class="a-r">Matches</th><th scope="col" class="a-r">Points per correct pick</th></tr>
                                </thead>
                                <tbody>
                                    {BRACKET_ROUNDS.map((r, i) => (
                                        <tr>
                                            <th scope="row">{r.round}</th>
                                            <td class="a-r">{r.matches}</td>
                                            <td class="a-r a-pts"><span class="a-meter" aria-hidden="true">{BRACKET_ROUNDS.map((_, k) => <i class={k <= i ? 'on' : undefined}></i>)}</span><span class="a-pts__n">{r.points}</span></td>
                                        </tr>
                                    ))}
                                </tbody>
                                <tfoot>
                                    <tr><th scope="row">Whole bracket</th><td class="a-r">{totalMatches}</td><td class="a-r">{BRACKET.maxPoints} points at most</td></tr>
                                </tfoot>
                            </table>
                        </div>
                        <p class="a-split__b"><strong>Tiebreaker:</strong> with your bracket you predict the total points scored by both teams across all sets of the championship match. The closest prediction ranks higher. No tie is broken by chance.</p>
                    </div>
                    </details>
                </section>

                <section class="a-seg" id="dates" aria-labelledby="dates-h">
                    <header class="a-seg__head"><span class="a-plate">{no('dates')}</span><h2 class="a-seg__title" id="dates-h">Key dates for brackets and the {BRACKET.season} NCAA volleyball tournament</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('dates')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <ol class="a-dates">
                        {BRACKET_DATES.map((d) => (
                            <li class={lamp(d.what)}>
                                <time datetime={d.iso}>{d.when}</time>
                                <div>
                                    <strong>{d.what}</strong>
                                    <span>{d.detail}</span>
                                </div>
                            </li>
                        ))}
                    </ol>
                    </details>
                </section>

                <section class="a-seg" id="prize" aria-labelledby="prize-h">
                    <header class="a-seg__head"><span class="a-plate">{no('prize')}</span><h2 class="a-seg__title" id="prize-h">The {BRACKET.prize} cash prize</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('prize')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <div class="a-prize">
                        <div class="a-prize__fig" aria-hidden="true">
                            <span class="a-prize__amt">{BRACKET.prize}</span>
                            <span class="a-label">Cash. One prize.</span>
                        </div>
                        <p class="a-prize__lead">One prize of {BRACKET.prize} in cash goes to the eligible entrant whose complete bracket finishes highest. VOLI funds the prize itself, and no part of it comes from entrants.</p>
                        {/* The label runs into its sentence, as on the live page: each term reads as written. */}
                        <ul class="a-terms">
                            <li><strong>Who can win:</strong> legal residents of the 50 United States and the District of Columbia who are at least 18 and have reached the age of majority where they live (19 in Alabama and Nebraska, 21 in Mississippi).</li>
                            <li><strong>How to be eligible:</strong> before brackets lock, do both. Sign up for the prize in the app with your birthdate and state, and save a complete bracket, all {BRACKET.matches} picks and the tiebreaker. The birthdate and state must match your government-issued photo ID. Your birthdate is used only to confirm eligibility and is deleted on February 1, 2027.</li>
                            <li><strong>Who cannot win:</strong> current NCAA student-athletes; staff of any NCAA school's athletics department, and staff with responsibilities within or over one; staff of any athletic conference office; VOLI's owners, officers, employees and contractors and their immediate family and household members; and anyone paid to promote the contest.</li>
                            <li><strong>The winner:</strong> is notified by email and in the app within 7 days after the championship match, and has 7 days to reply with a government-issued photo ID and a signed declaration of eligibility and liability release. If they do not, the prize passes to the next eligible bracket. Payment is by ACH bank transfer, mailed check or Venmo within 30 days of verification, and goes only to the email address on the winning VOLI account. Venmo is not available for accounts that use Apple's Hide My Email.</li>
                        </ul>
                        <p class="a-prize__end">Everything is in the <a href={BRACKET.rulesPath} class="a-link">Official Rules</a>.</p>
                    </div>
                    </details>
                </section>

                <section class="a-seg" id="groups" aria-labelledby="groups-h">
                    <header class="a-seg__head"><span class="a-plate">{no('groups')}</span><h2 class="a-seg__title" id="groups-h">Play against your friends</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('groups')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <div class="a-seg__body">
                        <p>Before picks lock, create a group in the app and share its invite link, and your group gets its own leaderboard. Everyone still plays one bracket, which counts in every group they join and on the main leaderboard. The app also lists open groups that anyone can join without a code. Groups have no prize of their own: the {BRACKET.prize} goes to the top eligible bracket overall.</p>
                    </div>
                    </details>
                </section>

                <section class="a-seg" id="faq" aria-labelledby="faq-h">
                    <header class="a-seg__head"><span class="a-plate">{no('faq')}</span><h2 class="a-seg__title" id="faq-h">Bracket Challenge questions</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('faq')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <div class="a-faq">
                        {BRACKET_FAQS.map((f) => (
                            <details class="a-faq__item" id={`faq-${f.id}`} open>
                                <summary><h3>{f.q}</h3><span class="a-faq__mark" aria-hidden="true"></span></summary>
                                <p set:html={linkify(f.a)} />
                            </details>
                        ))}
                    </div>
                    </details>
                </section>

                <section class="a-seg" id="voli" aria-labelledby="voli-h">
                    <header class="a-seg__head"><span class="a-plate">{no('voli')}</span><h2 class="a-seg__title" id="voli-h">More volleyball in VOLI</h2></header>
                    <details class="a-fold" open>
                        <summary><span class="a-vh">{label('voli')}</span><span class="a-fold__mark" aria-hidden="true"></span></summary>
                    <div class="a-seg__body a-seg__body--two">
                        <p>VOLI is a free volleyball app for NCAA Division I women's volleyball, MLV and LOVB, with fantasy leagues, live scores and box scores, stats, history, news and podcasts. <a href={HOME} class="a-link">See everything in the app</a>.</p>
                        <p>Doing your homework before you pick? The <a href="/rankings" class="a-link">VOLI Top 100</a> ranks Division I teams from match results and strength of schedule each Monday, and every college match in the app shows each team's chance to win before first serve. <a href="/methods" class="a-link">How VOLI's numbers work</a>.</p>
                    </div>
                    </details>
                </section>
            </div>
        </div>
    </div>

    <div class="a-band">
        <div class="a-frame">
            <p class="a-legal">NO PURCHASE NECESSARY TO ENTER OR WIN. A purchase will not improve your chances of winning. Open only to legal residents of the 50 United States and the District of Columbia who are at least 18 years old and have reached the age of majority in their state of residence. Void in Puerto Rico, all other U.S. territories and possessions, and where prohibited. Brackets lock at the scheduled start of the tournament's first match. One prize: {BRACKET.prize} cash. Subject to the <a href={BRACKET.rulesPath}>Official Rules</a>. Sponsor: Voli LLC, 200 S 21st St STE 400A, Lincoln, NE 68510. This contest is not sponsored, endorsed or administered by, or associated with, Apple Inc. or Google LLC, and is not affiliated with, sponsored or endorsed by the NCAA.</p>
        </div>
    </div>

    <script is:inline slot="scripts">
    /* Enhancements only: the page reads in full without any of this. */
    (function () {
        var d = document, byId = function (id) { return d.getElementById(id); };
        var open = byId('open-bracket-btn'), stores = byId('get-the-app');

        // A friend-group invite (/bracket?g=CODE): carry the code into the app link and show it.
        var g = (new URLSearchParams(location.search).get('g') || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
        if (g.length >= 4 && g.length <= 10) {
            open.href = 'voli://bracket?g=' + g;
            byId('group-code-value').textContent = g;
            byId('group-code').hidden = false;
        }
        // No app behind the link? A moment later, bring the store buttons into view.
        open.addEventListener('click', function () {
            setTimeout(function () { if (!d.hidden) stores.scrollIntoView({ block: 'center' }); }, 1800);
        });

        // FOLDING. In the markup every part and every question is open. The
        // questions fold everywhere; the seven parts fold on a phone only. The
        // first of each stays open, and so does whatever the address points at
        // (#prize, #faq-ties).
        var phone = matchMedia('(max-width: 719px)');
        var parts = d.querySelectorAll('.a-fold'), questions = d.querySelectorAll('.a-faq__item');
        function reveal() {
            var t = location.hash.length > 1 && byId(decodeURIComponent(location.hash.slice(1)));
            if (!t) return null;
            var own = t.querySelector(':scope > .a-fold');
            if (own) own.open = true;
            for (var n = t; n; n = n.parentElement) if (n.tagName === 'DETAILS') n.open = true;
            return t;
        }
        function fit() {
            parts.forEach(function (f, i) { f.open = !phone.matches || !i; });
            var t = reveal();
            if (t) t.scrollIntoView();
        }
        questions.forEach(function (q, i) { q.open = !i; });
        fit();
        phone.addEventListener('change', fit);
        addEventListener('hashchange', reveal);
        // On a phone the whole header of a part opens and closes it.
        parts.forEach(function (f) {
            f.previousElementSibling.addEventListener('click', function () { if (phone.matches) f.open = !f.open; });
        });

        // The rundown marks the part being read: the one under a line a quarter
        // of the way down the screen. Above the first part nothing is marked.
        if (!('IntersectionObserver' in window)) return;
        var links = {}, segs = d.querySelectorAll('.a-seg'), inBand = {};
        d.querySelectorAll('.a-rail a[href^="#"]').forEach(function (a) { links[a.hash.slice(1)] = a; });
        var strip = d.querySelector('.a-rail ol');
        function mark(id) {
            for (var k in links) {
                if (k === id) links[k].setAttribute('aria-current', 'location'); else links[k].removeAttribute('aria-current');
            }
            // On a tablet the rundown is a strip: keep the marked part in view.
            if (strip.scrollWidth > strip.clientWidth) strip.scrollLeft = id ? links[id].offsetLeft - 16 : 0;
        }
        var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { inBand[e.target.id] = e.isIntersecting; });
            for (var i = 0; i < segs.length; i++) if (inBand[segs[i].id]) return mark(segs[i].id);
            // No part on the line: the reader is above the first one or past the last.
            mark(segs[0].getBoundingClientRect().top > 0 ? null : segs[segs.length - 1].id);
        }, { rootMargin: '-25% 0px -65% 0px' });
        segs.forEach(function (s) { io.observe(s); });
        // The hero is watched too, so a jump from the foot of the page straight
        // back to the top is seen and clears the mark.
        io.observe(d.querySelector('.a-bk'));
    })();
    </script>
</OptionA>
