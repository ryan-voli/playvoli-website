---
// The kit: every part of the Poster system on one page, each with a caption
// that names it. For whoever builds a page from these parts, and for a look
// at the whole system at once. Not indexed.
import Poster from '../../layouts/Poster.astro';
import '../../styles/poster/pages/kit.css';
import Badge from '../../components/poster/Badge.astro';
import Band from '../../components/poster/Band.astro';
import Btn from '../../components/poster/Btn.astro';
import Card from '../../components/poster/Card.astro';
import Cell from '../../components/poster/Cell.astro';
import Chips from '../../components/poster/Chips.astro';
import Cols from '../../components/poster/Cols.astro';
import Copy from '../../components/poster/Copy.astro';
import DataTable from '../../components/poster/DataTable.astro';
import Dates from '../../components/poster/Dates.astro';
import Faq from '../../components/poster/Faq.astro';
import Field from '../../components/poster/Field.astro';
import GetApp from '../../components/poster/GetApp.astro';
import LinkList from '../../components/poster/LinkList.astro';
import Mark from '../../components/poster/Mark.astro';
import Minis from '../../components/poster/Minis.astro';
import Note from '../../components/poster/Note.astro';
import PageHero from '../../components/poster/PageHero.astro';
import Qr from '../../components/poster/Qr.astro';
import Phone from '../../components/poster/Phone.astro';
import Phones from '../../components/poster/Phones.astro';
import Quotes from '../../components/poster/Quotes.astro';
import Rows from '../../components/poster/Rows.astro';
import Sheet from '../../components/poster/Sheet.astro';
import Split from '../../components/poster/Split.astro';
import Stack from '../../components/poster/Stack.astro';
import Steps from '../../components/poster/Steps.astro';
import Sticker from '../../components/poster/Sticker.astro';
import Stores from '../../components/poster/Stores.astro';
import Tickets from '../../components/poster/Tickets.astro';
import Tower from '../../components/poster/Tower.astro';
import { FACTS, FACTS_AS_OF, FAQS, NEWS_OUTLETS, PODCASTS, TESTIMONIALS } from '../../lib/voli-facts';
import { BRACKET_DATES, BRACKET_ROUNDS, BRACKET_STEPS } from '../../lib/bracket-facts';

const subnav = {
  label: 'Parts of the kit',
  items: [
    { href: '#type', label: 'Type and buttons', short: 'Type' },
    { href: '#figures', label: 'Figures' },
    { href: '#stickers', label: 'Stickers' },
    { href: '#lists', label: 'Lists' },
    { href: '#steps', label: 'Steps' },
    { href: '#quotes', label: 'Quotes' },
    { href: '#questions', label: 'Questions' },
    { href: '#cards', label: 'Cards and forms', short: 'Cards' },
    { href: '#reading', label: 'Reading' },
  ],
};
const questions = ['fantasy', 'rankings', 'leagues', 'free'].map((id) => FAQS.find((f) => f.id === id)!);
const SNIPPET = '<script src="https://playvoli.com/embed/powered-by-voli.js" async></script>';
---

<Poster
  title="Design kit: every part of the Poster system | VOLI"
  description="The parts playvoli.com is built from, on one page: bands, fitted titles, level columns, phones and stickers, lists, questions, cards, tables, forms and the reading sheet."
  subnav={subnav}
  noindex
>
    <PageHero color="rose" label={['The Poster system.', 'Every part on one page.']} lines={[{ text: ['The', 'kit'], hollow: true }, ['in one', 'page']]} fit="same">
        <p class="kit-cap"><b>PageHero</b> color="rose" · label, lines, copy, art slot</p>
        <p class="lede">A page is a stack of colour bands cut on the logo's 15 degree slant. Titles ride the cut. Everything you read sits level. The parts below are all a page is made of.</p>
        <div class="btns">
            <Btn href="#type">Start with type</Btn>
        </div>
        <Stores />
        <Tickets slot="art" label="The system in four numbers" items={[
          { value: '4', label: 'field colours: ink, lime, blue and rose' },
          { value: '15', label: 'degrees: the one angle, and its halves' },
          { value: '2', label: 'typefaces: Designer and Inter' },
          { value: '0', label: 'gradients, glass or blur' },
        ]} />
    </PageHero>

    <Band color="lime" id="type" title="Type" sub="and buttons">
        <Cols ratio="1:1">
            <Copy>
                <p class="kit-cap"><b>Band</b> color="lime" title sub · <b>Cols</b> ratio="1:1" · <b>Copy</b> with the text classes</p>
                <p class="label">.label: a small-caps line</p>
                <p class="lede">.lede: the first paragraph of a section. It states the fact plainly, in a sentence that can be quoted alone.</p>
                <p class="body">.body: running text, on a measure of about 36rem. A <a class="link" href="#figures">.link</a> is underlined and heavier. A figure can sit in a <span class="hl">.hl chip</span> and a <span class="tag">.tag</span> marks a row.</p>
                <p class="small">.small: a note under a list or a picture.</p>
                <p class="fine">.fine: the small print. <a href="/bracket/rules">Official Rules</a> apply.</p>
                <h3 class="h3">.h3: a sub-heading in the text face</h3>
                <h3 class="h3d">.h3d: one in the display face</h3>
                <ul class="kit-swatches" aria-label="The palette">
                    <li style="background:#0F1314;color:#fff">Ink</li>
                    <li style="background:#F0FF1E">Lime</li>
                    <li style="background:#17E9FC">Blue</li>
                    <li style="background:#FF1F6D">Rose</li>
                    <li style="background:#fff">White</li>
                </ul>
            </Copy>
            <div>
                <p class="kit-cap"><b>Btn</b> · <b>Stores</b> · <b>Note</b></p>
                <div class="btns">
                    <Btn href="#figures">The field's own button</Btn>
                    <Btn href="#figures" tone="blue" shadow="ink">tone="blue"</Btn>
                    <Btn href="#figures" tone="rose" shadow="ink" arrow={false}>No arrow</Btn>
                </div>
                <div class="kit-gap"><Stores /></div>
                <div class="kit-gap"><Note>A notice: an ink slab with the mark's tick.</Note></div>
                <div class="kit-gap"><Note bad>The same, for something that went wrong.</Note></div>
            </div>
        </Cols>
    </Band>

    <Band color="ink" id="figures" kicker="Figures that" title="ride the slope" tone="lime" stamp={`As of ${FACTS_AS_OF}`}>
        <Tower items={FACTS} />
        <Cols>
            <p class="kit-cap"><b>Band</b> color="ink" kicker title tone="lime" stamp · <b>Tower</b> rides the slope · this caption is in <b>Cols</b>, so it is level</p>
        </Cols>
    </Band>

    <Band color="blue" id="stickers" title={['Stuck on', 'the poster']}>
        <Cols ratio="1:1" drop={[0, 4]}>
            <div>
                <p class="kit-cap"><b>Stack</b> ratio="100/100" · <b>Phone</b> · <b>Sticker</b> cut · <b>Badge</b>, each placed with x y w r</p>
                <Stack ratio="100/100">
                    <Phone screen="rankings" x={6} y={2} w={40} r={-7.5} />
                    <Sticker cut="float-oregon" x={38} y={12} w={60} r={3.75} shadow="rose" z={2} />
                    <Sticker cut="float-tile" x={56} y={46} w={38} r={-3.75} shadow="white" z={3} />
                    <Badge value="100" label="teams ranked each Monday" x={-2} y={78} shadow="lime" />
                </Stack>
            </div>
            <div>
                <p class="kit-cap"><b>Phones</b> screens={'{[a, b]}'} badge: a ready-made pair</p>
                <Phones screens={['news', 'podcast']} badge={{ value: '12 & 19', label: 'podcasts, and news outlets in one feed' }} badgeAt="bottom" />
            </div>
        </Cols>
        <Cols ratio="1:1:1" drop={[2, 0, 0]}>
            <div>
                <p class="kit-cap"><b>Phones</b> one screen</p>
                <Phones screens={['encyclopedia']} />
            </div>
            <div>
                <p class="kit-cap"><b>Phones</b> three screens: the hero's arrangement</p>
                <Phones screens={['gameLive', 'games', 'gameStats']} badge={{ value: '99.8%', label: 'of completed Division I matches' }} />
            </div>
            <div>
                <p class="kit-cap"><b>Mark</b> on="blue": the logo's stripes, drawn large</p>
                <Mark on="blue" />
            </div>
        </Cols>
        <Cols ratio="1:1" drop={[0, 4]}>
            <div>
                <p class="kit-cap"><b>Phones</b> step: a pair that steps down the slope, for a hero's art slot</p>
                <Phones screens={['fantasy', 'fantasyCard']} step />
            </div>
            <div>
                <p class="kit-cap"><b>Qr</b> url text: the scan card with its own words (shown where there is a mouse, 761px and up)</p>
                <Qr url="https://playvoli.com/fantasy" text="Scan with your phone to read how fantasy volleyball works." />
            </div>
        </Cols>
    </Band>

    <Split ground="ink">
        <Cell color="rose" id="lists" title="Lists" sub="in a level cell">
            <p class="kit-cap"><b>Split</b> + <b>Cell</b> color="rose" · <b>Minis</b> · <b>Chips</b> · <b>Rows</b></p>
            <p class="body">A cell's body is level. On rose, reading text is always ink.</p>
            <Minis items={[
              { value: '18,000+', label: 'honors, back to 1979' },
              { value: '445', label: 'MLV and LOVB matches with play-by-play' },
              { value: '99.8%', label: 'of completed Division I matches with a box score' },
            ]} />
            <div class="kit-gap"><Chips items={NEWS_OUTLETS.slice(0, 8)} /></div>
            <div class="kit-gap"><Rows items={PODCASTS.slice(0, 3).map((p) => ({ title: p.name, meta: `${p.by} · ${p.episodes} episodes`, tag: p.partner && 'Partner' }))} /></div>
        </Cell>
        <Cell color="ink" id="dates" title="Dates" tone="blue" note="set like tour dates">
            <p class="kit-cap"><b>Cell</b> color="ink" tone="blue" note · <b>Dates</b> narrow, for a half-width cell, one row with a tag</p>
            <Dates narrow items={BRACKET_DATES.slice(0, 4).map((d, i) => (i === 0 ? { ...d, tag: 'Next' } : d))} />
        </Cell>
    </Split>

    <Band color="lime" id="steps" kicker="Stepping down" title="the slope">
        <Steps items={BRACKET_STEPS.map((s) => ({ title: s.title, text: s.text }))} />
        <Cols>
            <p class="kit-cap"><b>Steps</b> goes straight into a Band: it levels its own items. Four across, two on a tablet, one on a phone.</p>
        </Cols>
    </Band>

    <Band color="rose" id="quotes" title={['From', 'the fans']}>
        <Quotes items={TESTIMONIALS} by="VOLI app user" />
        <Cols>
            <p class="kit-cap"><b>Band</b> color="rose" title={'{[a, b]}'} · <b>Quotes</b>: ink cards whose offsets take the field's accents in turn</p>
        </Cols>
    </Band>

    <Band color="ink" id="questions" title="Questions" sub="folded away" tone="lime">
        <Faq items={questions}>
            <Btn slot="more" href="/about#faq">All questions and answers</Btn>
        </Faq>
        <Cols>
            <p class="kit-cap"><b>Faq</b> items: open in the HTML, folded by its script. fold={'{false}'} shows every answer.</p>
        </Cols>
    </Band>

    <Band color="blue" id="cards" title="Cards" sub="and forms">
        <Cols ratio="1:1:1">
            <Card name="EVOLLVE" kicker="Analytics partner" href="/evollve" cta="EVOLLVE on VOLI" logo img={{ src: '/images/partners/evollve-ball.webp', width: 256, height: 256, alt: 'The EVOLLVE logo: a volleyball' }}>
                <p>EVOLLVE builds advanced analytics for college volleyball. Their nightly ratings for every Division I team are built into VOLI.</p>
            </Card>
            <Card name="Volley Talk" kicker="Podcast partner" href="/volleytalk" cta="Volley Talk on VOLI" ratio="1 / 1" img={{ src: '/images/partners/Volley Talk.jpeg', width: 640, height: 640, alt: 'Volley Talk with Sarah Pavan podcast cover' }}>
                <p>A card with a photograph: the picture fills its frame.</p>
            </Card>
            <Card name="College Volleyball Transfers" kicker="Transfer portal partner" logo img={{ src: '/images/partners/cvt-mark.svg', width: 254, height: 260, alt: 'The College Volleyball Transfers mark' }}>
                <p>Without an href a card is not a link. A logo is shown whole, with air round it.</p>
            </Card>
        </Cols>
        <Cols ratio="1:1" drop={[2, 2]}>
            <div>
                <p class="kit-cap"><b>Card</b> as the children of <b>Cols</b> ratio="1:1:1" · below: a form on a colour field</p>
                <form class="form" action="#cards" method="get">
                    <div class="form__row">
                        <Field label="Your name" name="kit-name" autocomplete="name" required />
                        <Field label="Your email" name="kit-email" type="email" autocomplete="email" required invalid error="Enter an email address we can reply to." value="fan@" />
                    </div>
                    <Field label="Subject" name="kit-subject" as="select" placeholder="Choose a subject" options={['General Inquiry', 'Business Partnership', 'Press Inquiry', 'App Support', 'Feature Request']} required />
                    <Field label="Message" name="kit-message" as="textarea" maxlength={1000} hint="Up to 1,000 characters." optional />
                    <div class="form__foot">
                        <Btn type="submit" arrow={false}>Send message</Btn>
                        <Note>Thanks for reaching out. We will get back to you soon.</Note>
                    </div>
                </form>
            </div>
            <div>
                <p class="kit-cap"><b>LinkList</b> · <b>Tickets</b> size</p>
                <LinkList label="More in the kit" items={[
                  { href: '#type', label: 'Type and buttons' },
                  { href: '#stickers', label: 'Phones and stickers' },
                  { href: '#reading', label: 'The reading sheet' },
                ]} />
                <div class="kit-gap">
                    <Tickets size={3.4} label="Tickets in a column" items={[
                      { value: 'Free', label: 'on iPhone and Android' },
                      { value: '3', label: 'leagues: NCAA, MLV and LOVB' },
                    ]} />
                </div>
            </div>
        </Cols>
    </Band>

    <Sheet color="lime" id="reading" as="h2" label="The reading sheet" title={['A long', 'document']} meta="Sheet · level, on ink, with a table of contents" toc>
        <p slot="lede">For a policy, terms, rules or a method: text that is read from top to bottom. Nothing on a sheet is sheared.</p>
        <p class="lead">A sheet is a flat colour field with the document on a level ink panel. This first paragraph has the class "lead".</p>
        <h2 id="kit-headings">Headings and text</h2>
        <p>An h2 with an id opens a section and is listed in the contents. Paragraphs keep to a measure of 44rem. A <a href="#kit-lists">link</a> is underlined, and <strong>strong text</strong> is white.</p>
        <h3>An h3 under it</h3>
        <p>Text under a sub-heading. The first sentence under a heading states the fact plainly, so it can be quoted alone.</p>
        <h2 id="kit-lists">Lists</h2>
        <ul>
            <li>A bullet is the mark's tick.</li>
            <li>A second point, long enough to wrap to a second line on a phone so the hanging indent shows.</li>
        </ul>
        <ol>
            <li>A numbered step.</li>
            <li>Another, with a list inside it:
                <ol type="a">
                    <li>lettered, as rules often are;</li>
                    <li>and a second letter.</li>
                </ol>
            </li>
        </ol>
        <blockquote><p>A quotation, or a clause that must stand out.</p></blockquote>
        <h2 id="kit-table">A table</h2>
        <p>A DataTable scrolls sideways inside its own box on a phone. The page never does.</p>
        <DataTable
          caption="Points for each round of the bracket"
          min="27rem"
          cols={['Round', 'Matches', { label: 'Points per correct pick', class: 'fig' }]}
          rows={BRACKET_ROUNDS.map((r) => [r.round, r.matches, r.points])}
          foot={['Whole bracket', 63, { text: '192 points at most', class: 'pop' }]}
        />
        <p>A long list takes <strong>tight</strong> rows, <strong>pin</strong> keeps its first column in place while the rest scrolls under it, and <strong>marks</strong> draws a heavy rule after a row that ends a group (here, the two partner podcasts).</p>
        <DataTable
          caption="Volleyball podcasts on VOLI"
          min="34rem"
          pin
          tight
          marks={[2]}
          cols={['Podcast', { label: 'By', class: 'l' }, { label: 'Episodes', class: 'fig' }]}
          rows={PODCASTS.map((p) => [p.name, p.by, p.episodes])}
        />
        <h2 id="kit-code">Code to copy</h2>
        <p>A pre block scrolls inside its own box.</p>
        <pre><code>{SNIPPET}</code></pre>
        <h2 id="kit-form">A form</h2>
        <p>On ink a control is an ink box with a white edge. Focus puts the hard offset under it.</p>
        <form class="form" action="#kit-form" method="get">
            <Field label="Your email" name="kit-email-2" type="email" autocomplete="email" placeholder="you@example.com" required />
            <Field label="What is it about" name="kit-about" as="select" placeholder="Choose one" options={['App Support', 'Feature Request']} />
            <Field label="Message" name="kit-message-2" as="textarea" hint="Up to 1,000 characters." />
            <div class="form__foot">
                <Btn type="submit" arrow={false}>Send message</Btn>
            </div>
            <Note bad>That did not send. Try again in a moment.</Note>
        </form>
        <hr>
        <p class="fine">The small print at the foot of a document has the class "fine".</p>
    </Sheet>

    <GetApp color="blue" links={[
      { href: '/', label: 'The home page' },
      { href: '/design/c/', label: 'The first preview' },
    ]} />
</Poster>
