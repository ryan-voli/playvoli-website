---
// Design option C, "POSTER": the College Volleyball Bracket Challenge.
// The content is the live /bracket page's, in full, from lib/bracket-facts;
// the prize, eligibility and legal wording is copied from that page as is.
// A long page, so: a bar that pins to the top and jumps to each poster, the
// questions in an accordion, and scoring next to the dates on wide screens.
// Everything is in the HTML; without scripts every answer is open.
// The layout's BracketClock keeps the status line and the headline right
// between deploys (the hooks are data-bracket-status and data-bracket-after).
import OptionC from '../../../layouts/design/OptionC.astro';
import Stores from '../../../components/design/c/Stores.astro';
import { HOME } from '../../../components/design/c/links';
import { faqSchema, linkify } from '../../../lib/voli-facts';
import {
  BRACKET, BRACKET_DATES, BRACKET_FAQS, BRACKET_ROUNDS, BRACKET_STATUS, BRACKET_STEPS, bracketPhase, promoIsLive,
} from '../../../lib/bracket-facts';

// Title and description follow the calendar, as on the live page: once picks
// lock nobody can enter, so they stop offering the prize.
const phase = bracketPhase();
const live = promoIsLive(phase);
const title = live
  ? 'College Volleyball Bracket Challenge 2026: Win $500 Cash | VOLI'
  : 'College Volleyball Bracket Challenge 2026 | VOLI';
const description = live
  ? "Pick the 2026 NCAA Division I women's volleyball tournament in VOLI's free bracket game. $500 cash to the top eligible bracket. Opens Nov. 29, locks Dec. 3."
  : phase === 'locked'
    ? "The 2026 College Volleyball Bracket Challenge is under way in the VOLI app. Brackets are locked, and every pick for the NCAA Division I women's volleyball tournament is scored live."
    : "The 2026 College Volleyball Bracket Challenge, VOLI's free bracket game for the NCAA Division I women's volleyball tournament, is complete.";
const ogImage = 'https://playvoli.com/images/bracket/bracket-challenge-2026-og.png';
const afterHeadline = `Picks are in for ${BRACKET.season}. Follow the leaderboard in the VOLI app.`;
const totalMatches = BRACKET_ROUNDS.reduce((n, r) => n + r.matches, 0);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${BRACKET.url}#webpage`,
    url: BRACKET.url,
    name: 'College Volleyball Bracket Challenge 2026',
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://playvoli.com/#website' },
    publisher: { '@id': 'https://playvoli.com/#organization' },
    about: { '@type': 'Thing', name: "2026 NCAA Division I women's volleyball tournament" },
    mentions: { '@id': 'https://playvoli.com/#app' },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    breadcrumb: { '@id': `${BRACKET.url}#breadcrumb` },
    dateModified: new Date().toISOString().slice(0, 10),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${BRACKET.url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VOLI', item: 'https://playvoli.com/' },
      { '@type': 'ListItem', position: 2, name: 'College Volleyball Bracket Challenge', item: BRACKET.url },
    ],
  },
  faqSchema(BRACKET_FAQS, BRACKET.url),
];

// The page's own index. `pre` is dropped on a phone, where all six sit in
// one row next to the Get app chip.
const index = [
  { href: '#how-it-works', pre: 'How to ', label: 'play' },
  { href: '#groups', pre: '', label: 'Friends' },
  { href: '#scoring', pre: '', label: 'Scoring' },
  { href: '#dates', pre: '', label: 'Dates' },
  { href: '#prize', pre: '', label: 'Prize' },
  { href: '#faq', pre: '', label: 'FAQ' },
];
const half = Math.ceil(BRACKET_FAQS.length / 2);
const faqCols = [BRACKET_FAQS.slice(0, half), BRACKET_FAQS.slice(half)];
---

<OptionC title={title} description={description} canonical={BRACKET.url} ogImage={ogImage} schema={schema} stickyNav={false}>
    <link rel="preload" as="image" href="/images/bracket/bracket-challenge-2026-logo.webp" type="image/webp" fetchpriority="high" slot="head" />

    {/* The page's own bar: it pins to the top and jumps to each poster. */}
    <nav class="idx" aria-label="On this page">
        <ul>
            {index.map((i) => <li><a href={i.href}><span>{i.pre && <span class="idx__x">{i.pre}</span>}{i.label}</span></a></li>)}
        </ul>
        <a class="idx__get" href="#get" data-get>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="square" aria-hidden="true"><path d="M12 4v10M7 10.5l5 5 5-5M5 20h14"/></svg>
            <span class="idx__get-t">Get<span class="idx__the"> the</span><span class="idx__app"> app</span></span>
        </a>
    </nav>

    <section class="hero bhero f-rose" aria-labelledby="bracket-heading">
        <div class="hero__in">
            {/* A friend-group invite arrives as ?g=CODE: the script below shows this. */}
            <div class="bgroup" id="group-code" hidden>
                <span class="bgroup__kick">You're invited to a Bracket Challenge group</span>
                <span class="bgroup__label">Group code</span>
                <span class="bgroup__value" id="group-code-value"></span>
                <span class="bgroup__hint">If VOLI doesn't open on its own, enter this under Bracket &rarr; Group in the app.</span>
            </div>

            <div class="bhero__top">
                <h1 id="bracket-heading">
                    <span class="hero__label"><span class="ticks" aria-hidden="true"></span>College Volleyball Bracket Challenge {BRACKET.season}</span>
                    {/* The offer, in one element. Until picks lock the after-lock
                        line rides in the attribute, not in the page text; on the
                        day BracketClock swaps it in, as on the live page. */}
                    <span class="bhero__head" data-bracket-after={live ? afterHeadline : undefined}>{live ? (
                        <Fragment>
                            <span class="hero__line bhero__l1 hollow">Pick all {BRACKET.matches}</span>
                            <span class="hero__line bhero__l2">matches.</span>
                            <span class="bhero__l3">The top eligible bracket wins <span class="hl">{BRACKET.prize} cash</span></span>
                        </Fragment>
                    ) : afterHeadline}</span>
                </h1>
                <div class="bart">
                    <img src="/images/bracket/bracket-challenge-2026-logo.webp" width="840" height="486" fetchpriority="high"
                         alt="College Volleyball '26 Bracket Challenge, presented by VOLI">
                </div>
            </div>

            <div class="hero__row bhero__row">
                <div class="hero__copy">
                    <p class="lede">A free bracket game for the {BRACKET.season} NCAA <span class="nb">Division I</span> women's volleyball tournament. Fill out your bracket in the VOLI app, then follow every pick on a live leaderboard.</p>

                    <p class="bstatus"><span class="bstatus__dot" aria-hidden="true"></span><span data-bracket-status="long">{BRACKET_STATUS[phase].long}</span></p>

                    <div class="bactions" id="get">
                        <a href="voli://bracket" id="open-bracket-btn" class="btn bopen">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M14 4h6v16h-6M3 12h12M10 7l5 5-5 5"/></svg>
                            Open the Bracket Challenge
                        </a>
                        <Stores />
                    </div>

                    <p class="bfine">No purchase necessary. 50 U.S. states &amp; D.C., 18+ (19+ AL/NE, 21+ MS). <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
                </div>

                <ul class="bfacts" aria-label="The Bracket Challenge at a glance">
                    <li><strong>{BRACKET.prize}</strong><span>cash to the top eligible bracket</span></li>
                    <li><strong>Free</strong><span>to enter, with no purchase necessary</span></li>
                    <li><strong>{BRACKET.matches}</strong><span>matches to pick, plus a tiebreaker</span></li>
                    <li><strong>Nov. 29</strong><span>brackets open once the field is set</span></li>
                </ul>
            </div>
        </div>
    </section>

    <section class="band f-lime" id="how-it-works" aria-labelledby="how-h">
        <div class="band__in">
            <h2 class="rider" id="how-h">
                <span class="rider__sm hollow">How the Bracket Challenge</span>
                <span class="rider__big" style="--em:4.425">works</span>
            </h2>
            <ol class="steps">
                {BRACKET_STEPS.map((s, i) => (
                    <li class="up">
                        <span class="steps__n" aria-hidden="true">{i + 1}</span>
                        <h3>{s.title}</h3>
                        <p>{s.text}</p>
                    </li>
                ))}
            </ol>
        </div>
    </section>

    <section class="band f-blue" id="groups" aria-labelledby="groups-h">
        <div class="band__in">
            <h2 class="rider" id="groups-h">
                <span class="rider__sm hollow">Play against</span>
                <span class="rider__big rider__big--wrap" style="--em-d:8.718;--em-m:5.043"><span>your</span> <span>friends</span></span>
            </h2>
            <div class="groups">
                <p class="lede up">Before picks lock, create a group in the app and share its invite link, and your group gets its own leaderboard. Everyone still plays one bracket, which counts in every group they join and on the main leaderboard. The app also lists open groups that anyone can join without a code. Groups have no prize of their own: the {BRACKET.prize} goes to the top eligible bracket overall.</p>
                {/* The mark's three stripes, drawn large. Decoration only. */}
                <div class="up" aria-hidden="true">
                    <svg class="mark" viewBox="60 110 1470 1390" role="presentation" focusable="false">
                        <g transform="translate(450 153) rotate(15)"><path fill="#F0FF1E" d="M0 0h832a320 320 0 0 1 320 320H320A320 320 0 0 1 0 0z"/></g>
                        <g transform="translate(138 465) rotate(15)"><path fill="#fff" d="M0 0h1121a320 320 0 0 1 320 320H320A320 320 0 0 1 0 0z"/></g>
                        <g transform="translate(107 850) rotate(15)"><path fill="#FF1F6D" d="M0 0h831a320 320 0 0 1 320 320H320A320 320 0 0 1 0 0z"/></g>
                    </svg>
                </div>
            </div>
        </div>
    </section>

    <div class="band band--split">
        <div class="band__in f-rose">
            <section class="cell f-ink" id="scoring" aria-labelledby="scoring-h">
                <h2 class="rider rider--lime" id="scoring-h">
                    <span class="rider__sm hollow">How a bracket is</span>
                    <span class="rider__big" style="--em:4.719">scored</span>
                </h2>
                <div class="cell__body up" style="--mt:6.6">
                    <p class="body">Every correct pick earns points, and a correct pick is worth more in each later round. Every round adds up to 32 points, so a perfect bracket scores {BRACKET.maxPoints}.</p>
                    <table class="score">
                        <caption>Points for each round of the bracket</caption>
                        <thead>
                            <tr><th scope="col">Round</th><th scope="col">Matches</th><th scope="col">Points per correct pick</th></tr>
                        </thead>
                        <tbody>
                            {BRACKET_ROUNDS.map((r) => (
                                <tr><th scope="row">{r.round}</th><td>{r.matches}</td><td>{r.points}</td></tr>
                            ))}
                        </tbody>
                        <tfoot>
                            <tr><th scope="row">Whole bracket</th><td>{totalMatches}</td><td>{BRACKET.maxPoints} points at most</td></tr>
                        </tfoot>
                    </table>
                    <p class="body"><strong>Tiebreaker:</strong> with your bracket you predict the total points scored by both teams across all sets of the championship match. The closest prediction ranks higher. No tie is broken by chance.</p>
                </div>
            </section>
            <section class="cell f-rose" id="dates" aria-labelledby="dates-h">
                <h2 class="rider" id="dates-h">
                    <span class="rider__big" style="--em:6.466">Key dates</span>
                    <span class="rider__note">for brackets and the {BRACKET.season} NCAA volleyball tournament</span>
                </h2>
                <ol class="dates up">
                    {BRACKET_DATES.map((d) => (
                        <li>
                            <time datetime={d.iso}>{d.when}</time>
                            <div>
                                <strong>{d.what}</strong>
                                <span>{d.detail}</span>
                            </div>
                        </li>
                    ))}
                </ol>
            </section>
        </div>
    </div>

    <section class="band f-lime" id="prize" aria-labelledby="prize-h">
        <div class="band__in">
            <h2 class="rider" id="prize-h">
                <span class="rider__sm hollow">The</span>
                {/* One line wide. On a phone the figure and the words each run edge to edge. */}
                <span class="rider__big rider__big--wrap rider__big--fit" style="--em-d:10.711;--em-m:7.038"><span style="--em-s:3.228">{BRACKET.prize}</span> <span style="--em-s:7.038">cash prize</span></span>
            </h2>
            <div class="prize">
                <p class="lede prize__lede up">One prize of {BRACKET.prize} in cash goes to the eligible entrant whose complete bracket finishes highest. VOLI funds the prize itself, and no part of it comes from entrants.</p>
                <ul class="prize__list">
                    <li class="up"><strong>Who can win:</strong> legal residents of the 50 United States and the District of Columbia who are at least 18 and have reached the age of majority where they live (19 in Alabama and Nebraska, 21 in Mississippi).</li>
                    <li class="up"><strong>How to be eligible:</strong> before brackets lock, do both. Sign up for the prize in the app with your birthdate and state, and save a complete bracket, all {BRACKET.matches} picks and the tiebreaker. The birthdate and state must match your government-issued photo ID. Your birthdate is used only to confirm eligibility and is deleted on February 1, 2027.</li>
                    <li class="up"><strong>Who cannot win:</strong> current NCAA student-athletes; staff of any NCAA school's athletics department, and staff with responsibilities within or over one; staff of any athletic conference office; VOLI's owners, officers, employees and contractors and their immediate family and household members; and anyone paid to promote the contest.</li>
                    <li class="up"><strong>The winner:</strong> is notified by email and in the app within 7 days after the championship match, and has 7 days to reply with a government-issued photo ID and a signed declaration of eligibility and liability release. If they do not, the prize passes to the next eligible bracket. Payment is by ACH bank transfer, mailed check or Venmo within 30 days of verification, and goes only to the email address on the winning VOLI account. Venmo is not available for accounts that use Apple's Hide My Email.</li>
                </ul>
                <p class="body prize__rules up">Everything is in the <a href={BRACKET.rulesPath} class="link">Official Rules</a>.</p>
            </div>
        </div>
    </section>

    <section class="band f-ink" id="faq" aria-labelledby="faq-h">
        <div class="band__in">
            <h2 class="rider rider--lime" id="faq-h">
                <span class="rider__sm hollow">Bracket Challenge</span>
                <span class="rider__big" style="--em:6.773">questions</span>
            </h2>
            <div class="faq">
                {faqCols.map((col) => (
                    <div class="up">
                        {col.map((f) => (
                            <details class="acc" id={`faq-${f.id}`} open>
                                <summary><h3>{f.q}</h3></summary>
                                <p class="body" set:html={linkify(f.a)} />
                            </details>
                        ))}
                    </div>
                ))}
            </div>
            {/* Every answer is open in the HTML. With scripts on, all but the
                first fold away, here, before the page below them is laid out;
                a link to one (#faq-ties) opens it. */}
            <script is:inline>
                (function () {
                    var qs = [].slice.call(document.querySelectorAll('.acc'));
                    function sync(first) {
                        var id = decodeURIComponent(location.hash.slice(1));
                        qs.forEach(function (d, i) { if (d.id === id) d.open = true; else if (first) d.open = i === 0; });
                    }
                    sync(true);
                    addEventListener('hashchange', function () { sync(false); });
                })();
            </script>
        </div>
    </section>

    <section class="band f-blue" id="voli" aria-labelledby="voli-h">
        <div class="band__in">
            <h2 class="rider" id="voli-h">
                <span class="rider__big rider__big--wrap" style="--em-d:11.293;--em-m:7.414"><span>More</span> <span>volleyball</span></span>
                <span class="rider__sm hollow">in VOLI</span>
            </h2>
            <div class="morev">
                <div class="up">
                    <p class="lede">VOLI is a free volleyball app for NCAA <span class="nb">Division I</span> women's volleyball, MLV and LOVB, with fantasy leagues, live scores and box scores, stats, history, news and podcasts. <a href={HOME} class="link">See everything in the app</a>.</p>
                    <Stores class="morev__stores" />
                </div>
                <div class="up">
                    <p class="lede">Doing your homework before you pick? The <a href="/rankings" class="link">VOLI Top 100</a> ranks <span class="nb">Division I</span> teams from match results and strength of schedule each Monday, and every college match in the app shows each team's chance to win before first serve. <a href="/methods" class="link">How VOLI's numbers work</a>.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="band f-ink blegal" aria-label="Contest terms">
        <div class="band__in">
            <p class="legal up">NO PURCHASE NECESSARY TO ENTER OR WIN. A purchase will not improve your chances of winning. Open only to legal residents of the 50 United States and the District of Columbia who are at least 18 years old and have reached the age of majority in their state of residence. Void in Puerto Rico, all other U.S. territories and possessions, and where prohibited. Brackets lock at the scheduled start of the tournament's first match. One prize: {BRACKET.prize} cash. Subject to the <a href={BRACKET.rulesPath}>Official Rules</a>. Sponsor: Voli LLC, 200 S 21st St STE 400A, Lincoln, NE 68510. This contest is not sponsored, endorsed or administered by, or associated with, Apple Inc. or Google LLC, and is not affiliated with, sponsored or endorsed by the NCAA.</p>
        </div>
    </section>

    <script is:inline slot="scripts">
        (function () {
            // A friend-group invite, /bracket?g=CODE: carry the code into the
            // app link and show it for anyone who has to install first.
            var code = (new URLSearchParams(location.search).get('g') || '').toUpperCase().replace(/[^A-Z0-9]/g, '');
            if (code.length < 4 || code.length > 10) code = '';
            var btn = document.getElementById('open-bracket-btn');
            if (code) {
                btn.setAttribute('href', 'voli://bracket?g=' + code);
                document.getElementById('group-code-value').textContent = code;
                document.getElementById('group-code').hidden = false;
            }
            // No app on this phone: once the link has had its chance, bring up the store buttons.
            btn.addEventListener('click', function () {
                setTimeout(function () { if (!document.hidden) document.querySelector('#get .store').focus(); }, 2000);
            });
        })();
    </script>
</OptionC>
