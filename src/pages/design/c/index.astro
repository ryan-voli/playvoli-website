---
// Design option C, "POSTER": the home page. The overview IS the home, with no
// gate in front of it. Every number and sentence comes from lib/voli-facts
// and lib/bracket-facts, or is copied from the live /app page.
import OptionC from '../../../layouts/design/OptionC.astro';
import Stores from '../../../components/design/c/Stores.astro';
import { BRACKET_HREF } from '../../../components/design/c/links';
import { APP_SCHEMA, DOWNLOADS, FACTS, FACTS_AS_OF, FAQS, NEWS_OUTLETS, PODCASTS, TESTIMONIALS, linkify } from '../../../lib/voli-facts';
import { BRACKET, BRACKET_STATUS, bracketPhase, promoIsLive } from '../../../lib/bracket-facts';

const phase = bracketPhase();
// This page takes over from /app, so the app entity names this address.
// (APP_SCHEMA still says /app: change it there when /app redirects here.)
const appSchema = { ...APP_SCHEMA, url: 'https://playvoli.com/' };
const questions = ['what', 'fantasy', 'box-scores', 'free'].map((id) => FAQS.find((f) => f.id === id)!);
// Designer has no tilde: a leading "~" is set in Inter.
const split = (v: string) => (v.startsWith('~') ? { pre: '~', rest: v.slice(1) } : { pre: '', rest: v });
---

<OptionC
  title="VOLI App - The Volleyball Hub"
  description="Free volleyball app for NCAA women's volleyball, MLV and LOVB: fantasy leagues, live scores and box scores, stats, rankings, history, news and podcasts."
  canonical="https://playvoli.com/"
  schema={[appSchema]}
>
    <link rel="preload" as="image" href="/images/screenshots/home-fantasy.webp" type="image/webp" fetchpriority="high" slot="head" />

    {/* The Bracket Challenge, first thing on the page (owner, 26 Nov 2026). It
        comes down by itself once picks lock: a build after the lock leaves it
        out, and between deploys the layout's BracketClock rewrites the status
        line and then hides the strip (the data-bracket-* hooks). */}
    {promoIsLive(phase) && (
        <aside class="promo f-rose" aria-label={BRACKET.name} data-bracket-promo>
            <a class="promo__link" href={BRACKET_HREF}>
                <span class="promo__status"><span class="ticks" aria-hidden="true"></span><span data-bracket-status="short">{BRACKET_STATUS[phase].short}</span></span>
                <strong class="promo__name">{BRACKET.name}</strong>
                <span class="promo__sub"><b>{BRACKET.prize} cash</b> to the top eligible bracket. Free to play.</span>
                <span class="promo__go">Play free
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
                </span>
            </a>
            <p class="promo__legal">No purchase necessary. 50 U.S. states &amp; D.C., 18+ (19+ AL/NE, 21+ MS). <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
        </aside>
    )}

    <section class="hero f-lime" aria-labelledby="hero-h">
        <div class="hero__in">
            <h1 id="hero-h">
                {/* The slogan has no search words, so the same h1 names the app
                    as the stores do, and says what it is. */}
                <span class="hero__label"><span class="ticks" aria-hidden="true"></span><span class="hero__label-t"><span>VOLI: The Volleyball Hub.</span> <span>A free volleyball app.</span></span></span>
                <span class="hero__line hero__line--ask hollow"><span>You</span> <span>asked.</span></span>
                <span class="hero__line hero__line--built"><span>We</span> <span>built it.</span></span>
            </h1>
            <div class="hero__row">
                <div class="hero__copy">
                    <p class="lede">Fantasy volleyball, live games, stats, rankings and volleyball history for NCAA <span class="nb">Division I</span> women's volleyball, MLV and LOVB, with volleyball news and podcasts in one feed. Free on iPhone and Android.</p>
                    <Stores />
                </div>
                {/* Three phones stepping down with the slope they stand on; --ym is the phone layout. */}
                <div class="stack hero__stack">
                    <img class="stk" style="--x:27;--y:4;--ym:7;--w:46;--r:-3.75;--z:2" src="/images/screenshots/home-fantasy.webp" width="640" height="1280" alt="VOLI Fantasy: your teams and the leagues they play in" fetchpriority="high">
                    <img class="stk" style="--x:0;--y:1;--ym:-2;--w:40;--r:-15" src="/images/screenshots/home-games.webp" width="640" height="1280" alt="VOLI Games: the day's schedule, with each match's chance to win">
                    <img class="stk" style="--x:59;--y:14;--ym:21;--w:40;--r:7.5" src="/images/screenshots/home-stats.webp" width="640" height="1280" alt="VOLI Stats: a player's analytics card">
                    <p class="badge" style="--x:72;--y:68;--xm:50;--ym:84"><strong>{DOWNLOADS}</strong> <span>downloads</span></p>
                </div>
            </div>
        </div>
    </section>

    <section class="band f-ink" id="numbers" aria-labelledby="numbers-h">
        <div class="band__in">
            <div class="rider">
                <h2 class="rider__sm" id="numbers-h">What's in VOLI</h2>
                <p class="label asof">As of {FACTS_AS_OF}</p>
            </div>
            <ul class="tower">
                {FACTS.map((f) => {
                    const v = split(f.value);
                    return (
                        <li>
                            <strong class="tower__n">{v.pre && <span class="tilde">{v.pre}</span>}{v.rest}</strong>
                            <span class="tower__l">{f.label}</span>
                        </li>
                    );
                })}
            </ul>
        </div>
    </section>

    {/* The feature set. Fantasy is first, wherever features are listed. */}
    <section class="band f-blue feat" id="fantasy" aria-labelledby="fantasy-h">
        <div class="band__in">
            <h2 class="rider" id="fantasy-h">
                <span class="rider__big" style="--em:5.303">Fantasy</span>
                <span class="rider__sm hollow">leagues</span>
            </h2>
            <div class="feat__grid">
                <div class="feat__copy up">
                    <p class="lede">Build a team from real college and pro players and play the season against your friends.</p>
                    <p class="body">Leagues use a salary cap and multi-round contracts, for NCAA <span class="nb">Division I</span> women's volleyball and MLV, and the NCAA season runs in ten rounds, Wednesday to Sunday. Join a public league run by a volleyball podcast, or start a private one.</p>
                    <div class="stack feat__fig" style="--ar:100/80">
                        <img class="stk" style="--x:1;--y:5;--w:86;--r:-3.75;--stk-sh:var(--rose);--rad:4.8% / 5.7%" src="/images/splash/card-fantasy.webp" width="900" height="756" loading="lazy" decoding="async" alt="A fantasy player card in VOLI: price, season points and points by round">
                    </div>
                </div>
                <div class="stack feat__stack up">
                    <img class="stk" style="--x:3;--y:2;--w:44;--r:-7.5" src="/images/screenshots/fantasy3.webp" width="640" height="1280" loading="lazy" decoding="async" alt="A fantasy roster in VOLI, with the salary cap bar above the starters">
                    <img class="stk" style="--x:53;--y:10;--w:44;--r:7.5" src="/images/screenshots/fantasy1.webp" width="640" height="1280" loading="lazy" decoding="async" alt="A player's fantasy page in VOLI: salary and points for each round">
                    <p class="badge" style="--x:-4;--y:-13;--xm:2;--ym:-12;--r:-7.5"><strong>10</strong> <span>rounds, Wednesday to Sunday</span></p>
                </div>
            </div>
        </div>
    </section>

    <section class="band f-ink feat feat--flip" id="games" aria-labelledby="games-h">
        <div class="band__in">
            <h2 class="rider rider--rose" id="games-h">
                <span class="rider__big" style="--em:7.169">Live games</span>
            </h2>
            <div class="feat__grid">
                <div class="feat__copy up">
                    <p class="lede">Scores and box scores for college and pro matches as they happen, with a lead chart for each set, and play-by-play with the rotation on court for MLV and LOVB matches.</p>
                    <p class="body">On iPhone, keep the score on your lock screen with Live Activities.</p>
                    <div class="stack feat__fig" style="--ar:100/66">
                        <img class="stk" style="--x:0;--y:4;--w:90;--r:3.75;--stk-sh:var(--lime);--rad:5.8% / 17.6%" src="/images/splash/card-game.webp" width="900" height="296" loading="lazy" decoding="async" alt="A VOLI game card: LSU at Tennessee, with each team's chance to win">
                        <img class="stk" style="--x:22;--y:38;--w:74;--r:-3.75;--stk-sh:var(--blue);--z:2;--rad:4.75% / 9.1%" src="/images/splash/float-final.webp" width="760" height="397" loading="lazy" decoding="async" alt="A final score in VOLI: Pitt beat SMU in three sets">
                    </div>
                </div>
                <div class="stack feat__stack up" style="--shadow:var(--rose)">
                    <img class="stk" style="--x:3;--y:2;--w:44;--r:-7.5" src="/images/screenshots/games1.webp" width="640" height="1280" loading="lazy" decoding="async" alt="A box score in VOLI for a pro match between Atlanta and Indy">
                    <img class="stk" style="--x:53;--y:10;--w:44;--r:3.75" src="/images/screenshots/games2.webp" width="640" height="1280" loading="lazy" decoding="async" alt="Play-by-play in VOLI for a pro match between Austin and Atlanta">
                    <p class="badge" style="--x:58;--y:92;--xm:44;--ym:86;--r:-7.5;--badge-sh:var(--lime)"><strong>445</strong> <span>MLV and LOVB matches with play-by-play</span></p>
                </div>
            </div>
        </div>
    </section>

    <section class="band f-lime feat feat--sub" id="stats" aria-labelledby="stats-h">
        <div class="band__in">
            <h2 class="rider" id="stats-h">
                <span class="rider__big" style="--em:3.665">Stats</span>
                <span class="rider__sm hollow">and box scores</span>
            </h2>
            <div class="feat__grid">
                <div class="feat__copy up">
                    <p class="lede">Nearly 500,000 NCAA player box-score lines since 2023, covering 99.8% of completed <span class="nb">Division I</span> matches, and set-by-set player stats for all 445 MLV and LOVB matches.</p>
                    <p class="body">Leaderboards sort by season, conference, position and class, in totals or per set.</p>
                    <div class="stack feat__fig" style="--ar:100/52">
                        <img class="stk" style="--x:0;--y:6;--w:92;--r:-3.75;--stk-sh:var(--rose);--rad:5.8% / 13.1%" src="/images/splash/card-stats.webp" width="900" height="399" loading="lazy" decoding="async" alt="A player card in VOLI with season efficiency, assists, aces, blocks and digs">
                    </div>
                </div>
                <div class="stack feat__stack up">
                    <img class="stk" style="--x:3;--y:2;--w:44;--r:-3.75" src="/images/screenshots/stats1.webp" width="640" height="1280" loading="lazy" decoding="async" alt="The player leaderboard in VOLI, sorted by efficiency">
                    <img class="stk" style="--x:53;--y:10;--w:44;--r:7.5" src="/images/screenshots/stats3.webp" width="640" height="1280" loading="lazy" decoding="async" alt="A player's performance charts in VOLI: attack, block and dig">
                    <p class="badge" style="--x:-6;--y:-15;--xm:2;--ym:-13;--r:-7.5"><strong>99.8%</strong> <span>of completed Division I matches</span></p>
                </div>
            </div>
        </div>
    </section>

    <div class="band band--split">
        <div class="band__in f-ink">
            <section class="cell f-rose" id="rankings" aria-labelledby="rankings-h">
                <h2 class="rider" id="rankings-h">
                    <span class="rider__big" style="--em:6.07">Rankings</span>
                    <span class="rider__sm hollow">and predictions</span>
                </h2>
                <div class="cell__body up" style="--mt:6">
                    <p class="lede">The VOLI Top 100, VOLI's own ranking of <span class="nb">Division I</span> teams from match results and strength of schedule, published each Monday.</p>
                    <p class="body">Before first serve, each upcoming college match shows each team's chance to win and the most likely set score, and the chance to win updates after every set. All next to the AVCA Coaches Poll and EVOLLVE's ratings.</p>
                    <div class="btns">
                        <a class="btn" href="/rankings" style="--btn-sh:#fff">The VOLI Top 100
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
                        </a>
                        <a class="btn" href="/methods" style="--btn-sh:#fff">How it works
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
                        </a>
                    </div>
                    <div class="stack cell__stack" style="--ar:100/24">
                        <img class="stk" style="--x:0;--y:10;--w:90;--r:-3.75;--rad:4.75% / 27.3%" src="/images/splash/float-rank.webp" width="760" height="132" loading="lazy" decoding="async" alt="A team ranking row in VOLI: Nebraska, ranked first">
                    </div>
                </div>
            </section>
            <section class="cell f-ink" id="encyclopedia" aria-labelledby="encyclopedia-h">
                <h2 class="rider rider--lime" id="encyclopedia-h">
                    <span class="rider__sm hollow">The Volleyball</span>
                    <span class="rider__big" style="--em:8.705">Encyclopedia</span>
                </h2>
                <div class="cell__body up" style="--mt:6.4">
                    <p class="lede">More than 18,000 honors back to 1979: 3,000+ AVCA All-America selections since 1981, the AVCA Coaches Poll since 1982, all 45 NCAA champions, ACC, Big 12, Big Ten and SEC honors, record books, the MLV Draft and pro league honors.</p>
                    <ul class="minis">
                        <li><strong>18,000+</strong><span>honors, back to 1979</span></li>
                        <li><strong>3,000+</strong><span>AVCA All-America selections since 1981</span></li>
                        <li><strong>45</strong><span>NCAA champions</span></li>
                    </ul>
                </div>
            </section>
        </div>
    </div>

    <section class="band f-blue" id="news" aria-labelledby="news-h">
        <div class="band__in">
            <h2 class="rider" id="news-h">
                <span class="rider__big rider__big--wrap" style="--em-d:13.227;--em-m:6.473"><span>News and</span> <span>podcasts</span></span>
            </h2>
            <div class="src__grid">
                <div class="up">
                    <p class="lede">Volleyball news from 19 outlets, from league and conference sites to independent writers, each story linked to its source.</p>
                    <p class="body">And 12 volleyball podcasts with more than 800 episodes to stream or download, with your place saved across devices.</p>
                    <div class="src__out">
                        <h3 class="h3">Where the news comes from</h3>
                        <ul class="chips">
                            {NEWS_OUTLETS.map((o) => <li>{o}</li>)}
                        </ul>
                        <p class="src__note">Coverage spans NCAA women's volleyball, MLV and LOVB: results, previews, transfers, rankings and awards. Every story opens on its publisher's site.</p>
                    </div>
                    <div class="stack src__fig" style="--ar:100/60">
                        <img class="stk" style="--x:6;--y:6;--w:82;--r:-3.75;--stk-sh:var(--rose);--rad:4.1% / 6.6%" src="/images/splash/float-article.webp" width="760" height="468" loading="lazy" decoding="async" alt="A volleyball news story in the VOLI feed">
                    </div>
                </div>
                <div class="up">
                    <h3 class="h3">Volleyball podcasts on VOLI</h3>
                    <ul class="pods">
                        {PODCASTS.map((p) => (
                            <li>
                                <span class="pods__n">{p.name}</span>
                                <span class="pods__m">{p.by} · {p.episodes} {p.episodes === 1 ? 'episode' : 'episodes'}{p.partner && <span class="tag">Partner</span>}</span>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>
    </section>

    <div class="band band--split">
        <div class="band__in f-ink">
            <section class="cell f-lime" id="community" aria-labelledby="community-h">
                <h2 class="rider" id="community-h">
                    <span class="rider__big" style="--em:6.965">Community</span>
                </h2>
                <div class="cell__body duo up" style="--mt:7">
                    <div class="duo__copy">
                        <p class="lede">A chat room for every match, rooms for NCAA, MLV and LOVB fans, and a private chat for each fantasy league.</p>
                        <p class="body">Partner podcasts host AMAs with players and creators right in the app.</p>
                        <div class="stack duo__strip" style="--ar:100/20">
                            <img class="stk" style="--x:0;--y:10;--w:100;--r:-3.75;--stk-sh:var(--rose);--z:3;--rad:4.9% / 31.6%" src="/images/splash/float-chat.webp" width="760" height="117" loading="lazy" decoding="async" alt="A message in VOLI's NCAA chat room">
                        </div>
                    </div>
                    <div class="stack duo__phone" style="--ar:100/196">
                        <img class="stk" style="--x:6;--y:0;--w:88;--r:7.5" src="/images/screenshots/more1.webp" width="640" height="1280" loading="lazy" decoding="async" alt="A match chat room in VOLI">
                    </div>
                </div>
            </section>
            <section class="cell f-ink" id="analytics" aria-labelledby="analytics-h">
                <h2 class="rider rider--blue" id="analytics-h">
                    <span class="rider__sm hollow">Analytics by</span>
                    <span class="rider__big" style="--em:5.132">EVOLLVE</span>
                </h2>
                <div class="cell__body up" style="--mt:6.4">
                    <p class="lede">EVOLLVE's college volleyball analytics are built in: nightly team ratings for every <span class="nb">Division I</span> team, player impact numbers like RAPM, and match predictions.</p>
                    <div class="btns">
                        <a class="btn" href="/evollve" style="--btn-bg:var(--blue);--btn-fg:var(--ink);--btn-sh:#fff">EVOLLVE on VOLI
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
                        </a>
                    </div>
                    <div class="stack cell__stack" style="--ar:100/46">
                        <img class="stk" style="--x:0;--y:8;--w:78;--r:3.75;--stk-sh:var(--blue);--rad:4.75% / 9.2%" src="/images/splash/float-pct.webp" width="760" height="392" loading="lazy" decoding="async" alt="An EVOLLVE analytics card in VOLI: a setter's RAPM and percentile">
                    </div>
                </div>
            </section>
        </div>
    </div>

    <section class="band f-rose" id="fans" aria-labelledby="fans-h">
        <div class="band__in">
            <h2 class="rider" id="fans-h">
                <span class="rider__big rider__big--wrap" style="--em-d:9.683;--em-m:5.827"><span>From</span> <span>the fans</span></span>
            </h2>
            <div class="quotes">
                {TESTIMONIALS.map((t) => (
                    <blockquote class="quote up">
                        <span class="ticks" aria-hidden="true"></span>
                        <p>{t}</p>
                        <footer>VOLI app user</footer>
                    </blockquote>
                ))}
            </div>
        </div>
    </section>

    <section class="band f-ink" id="questions" aria-labelledby="questions-h">
        <div class="band__in">
            <h2 class="rider rider--lime" id="questions-h">
                <span class="rider__big" style="--em:6.773">Questions</span>
                <span class="rider__sm hollow">about VOLI</span>
            </h2>
            <div class="qa">
                <div class="up">
                    {questions.slice(0, 2).map((f) => (
                        <div class="qa__item">
                            <h3>{f.q}</h3>
                            <p class="body" set:html={linkify(f.a)} />
                        </div>
                    ))}
                </div>
                <div class="up">
                    {questions.slice(2).map((f) => (
                        <div class="qa__item">
                            <h3>{f.q}</h3>
                            <p class="body" set:html={linkify(f.a)} />
                        </div>
                    ))}
                    <p class="qa__more">
                        <a class="btn" href="/faq" style="--btn-bg:var(--lime);--btn-fg:var(--ink);--btn-sh:var(--rose)">All questions and answers
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg>
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </section>

    <section class="band f-blue" id="leagues" aria-labelledby="leagues-h">
        <div class="band__in">
            <h2 class="rider" id="leagues-h"><span class="rider__sm">Leagues we cover</span></h2>
            <ul class="leagues">
                <li><a href="https://www.ncaa.com/sports/volleyball-women" target="_blank" rel="noopener"><strong>NCAA</strong><span>Women's Division I</span></a></li>
                <li><a href="https://provolleyball.com" target="_blank" rel="noopener"><strong>MLV</strong><span>Major League Volleyball</span></a></li>
                <li><a href="https://lovb.com" target="_blank" rel="noopener"><strong>LOVB</strong><span>League One Volleyball</span></a></li>
            </ul>
            <p class="leagues__note body up">VOLI is an independent fan platform, not affiliated with or endorsed by these leagues.</p>
        </div>
    </section>

    <section class="band f-lime" id="get" aria-labelledby="get-h">
        <div class="band__in">
            <h2 class="rider" id="get-h">
                <span class="rider__big" style="--em:10.017">Free on iPhone</span>
                <span class="rider__big hollow" style="--em:8.215">and Android</span>
            </h2>
            <div class="get__grid">
                <div class="get__copy up">
                    {/* The app as its store listing shows it: icon, name, line, count. In the flow at every width. */}
                    <div class="lockup">
                        <img class="lockup__icon" src="/images/appicon.webp" width="1000" height="1000" loading="lazy" decoding="async" alt="The VOLI app icon">
                        <p class="lockup__t">
                            <strong class="lockup__name"><span>VOLI<span class="vh">:</span></span> <span>The Volleyball Hub</span></strong>
                            <span class="lockup__tag">Fantasy. Stats. Community.</span>
                            <span class="lockup__dl"><b>{DOWNLOADS}</b> downloads</span>
                        </p>
                    </div>
                    <p class="lede">Get VOLI from the <span class="nb">App Store</span> or <span class="nb">Google Play</span>.</p>
                    <Stores />
                </div>
                <nav class="more up" aria-label="More about VOLI">
                    <p class="label">More about VOLI</p>
                    <ul>
                        <li><a href="/rankings">VOLI Top 100 <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a></li>
                        <li><a href="/faq">Questions about VOLI <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a></li>
                        <li><a href="/methods">How VOLI's numbers work <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a></li>
                        <li><a href="/about">About VOLI <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="square" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"/></svg></a></li>
                    </ul>
                </nav>
            </div>
