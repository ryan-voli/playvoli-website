---
// /rankings — the current published VOLI Top 100, rendered at build.
//
// Data: vbdata.voli_current_ranking (the newest published week, checked
// against max(week) in vbdata.voli_rankings), plus "This week's matchups"
// from vbdata.games + vbdata.voli_match_predictions. Public vbdata only;
// nothing here reads the fantasy schema. An empty ranking fails the build.
import Layout from '../layouts/Layout.astro';
import {
  vb, fetchAll, chunk, currentTop100, teamsById, teamName, teamColor,
  weekdayDate, shortDay, pacificDay, pacificTime, pacificStamp, longDate,
  seasonYear, BUILD_TIME, GAME_COLS, type Game,
} from '../lib/data';

const top = await currentTop100();
if (top.length < 25) throw new Error(`[rankings] only ${top.length} ranked teams`);
const { season, week, published_at } = top[0];
const year = seasonYear(season);
const published = weekdayDate(published_at);

function move(r: (typeof top)[number]) {
  if (r.prev_rank == null) return { cls: 'mv-new', text: 'NEW', label: 'new to the Top 100' };
  const d = r.movement ?? r.prev_rank - r.rank;
  if (d > 0) return { cls: 'mv-up', text: `▲${d}`, label: `up ${d}` };
  if (d < 0) return { cls: 'mv-down', text: `▼${-d}`, label: `down ${-d}` };
  return { cls: 'mv-flat', text: '–', label: 'no change' };
}
const fmtRating = (x: number) => (x >= 0 ? '+' : '') + Number(x).toFixed(1);
const record = (r: (typeof top)[number]) => (r.wins != null && r.losses != null ? `${r.wins}-${r.losses}` : '—');

// ---- This week's matchups: Top 100 vs Top 100 in the next 7 days ----------
const ranked = new Map(top.map((r) => [r.team_uuid, r]));
const teams = await teamsById();
const now = BUILD_TIME;
const horizon = new Date(now.getTime() + 7 * 864e5);

const upcoming = (await fetchAll<Game>('upcoming NCAA games', (from, to) =>
  vb().from('games').select(GAME_COLS)
    .eq('league', 'NCAA').eq('game_status', 'pre')
    .gt('date', now.toISOString()).lte('date', horizon.toISOString())
    .order('date').order('game_id').range(from, to),
  { allowEmpty: true },
)).filter((g) => ranked.has(g.home_uuid) && ranked.has(g.away_uuid));

interface Pred {
  game_uuid: string; computed_at: string; as_of: string; home_win_prob: number;
  p_3_0: number; p_3_1: number; p_3_2: number; p_2_3: number; p_1_3: number; p_0_3: number;
}
const preds: Pred[] = [];
for (const ids of chunk(upcoming.map((g) => g.game_id), 40)) {
  preds.push(...await fetchAll<Pred>('voli_match_predictions', (from, to) =>
    vb().from('voli_match_predictions')
      .select('game_uuid,computed_at,as_of,home_win_prob,p_3_0,p_3_1,p_3_2,p_2_3,p_1_3,p_0_3')
      .in('game_uuid', ids)
      .order('game_uuid').order('computed_at', { ascending: false }).range(from, to),
    { allowEmpty: true },
  ));
}
// Latest prediction made before first serve (as_of on or before match day).
const bestPred = new Map<string, Pred>();
for (const g of upcoming) {
  const day = pacificDay(g.date);
  const p = preds
    .filter((p) => p.game_uuid === g.game_id && p.as_of <= day && new Date(p.computed_at) < new Date(g.date))
    .sort((a, b) => b.computed_at.localeCompare(a.computed_at))[0];
  if (p) bestPred.set(g.game_id, p);
}
if (upcoming.length && !bestPred.size) {
  throw new Error('[rankings] Top 100 matchups exist but none has a pre-match prediction');
}

const SCORES: [keyof Pred, number, number][] = [
  ['p_3_0', 3, 0], ['p_3_1', 3, 1], ['p_3_2', 3, 2], ['p_2_3', 2, 3], ['p_1_3', 1, 3], ['p_0_3', 0, 3],
];
const matchups = upcoming.filter((g) => bestPred.has(g.game_id)).map((g) => {
  const p = bestPred.get(g.game_id)!;
  const home = teams.get(g.home_uuid);
  const away = teams.get(g.away_uuid);
  const homePct = Math.round(Number(p.home_win_prob) * 100);
  const [key, hs, as] = SCORES.reduce((a, b) => (Number(p[b[0]]) > Number(p[a[0]]) ? b : a));
  const winner = hs > as ? home : away;
  return {
    day: pacificDay(g.date),
    time: pacificTime(g.date),
    away: { name: teamName(away), rank: ranked.get(g.away_uuid)!.rank, color: teamColor(away), pct: 100 - homePct },
    home: { name: teamName(home), rank: ranked.get(g.home_uuid)!.rank, color: teamColor(home), pct: homePct },
    likely: `${teamName(winner)} ${Math.max(hs, as)}-${Math.min(hs, as)}`,
    likelyPct: Math.round(Number(p[key]) * 100),
    computed_at: p.computed_at,
  };
});
const predStamp = matchups.length
  ? pacificStamp(matchups.map((m) => m.computed_at).sort().at(-1)!)
  : pacificStamp(now);

const title = 'The VOLI Top 100: Division I Volleyball Rankings';
const description = "VOLI's weekly ranking of Division I women's volleyball teams, computed from match results and strength of schedule. Published each Monday.";
const url = 'https://playvoli.com/rankings';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: `The VOLI Top 100, ${year} Week ${week}`,
  description: `VOLI's ranking of NCAA Division I women's volleyball teams, published ${longDate(published_at)}.`,
  url,
  numberOfItems: top.length,
  itemListOrder: 'https://schema.org/ItemListOrderAscending',
  dateModified: published_at,
  itemListElement: top.map((r) => ({
    '@type': 'ListItem',
    position: r.rank,
    item: { '@type': 'SportsTeam', name: r.team_name, sport: 'Volleyball' },
  })),
};
---

<Layout title={title} description={description} ogUrl={url} canonical={url} schema={schema}>
  <meta slot="head" name="voli:rankings-week" content={`${season}|${week}|${published_at}`} />
  <main class="dp-main">
    <header class="dp-head">
      <p class="dp-kicker">NCAA Division I women's volleyball · {year}</p>
      <h1 class="dp-title">The VOLI Top 100</h1>
      <p class="dp-lead">Where Division I teams stand, ranked by how they've played.</p>
      <p class="dp-stamp"><strong>Week {week} · published {published}.</strong></p>
    </header>

    <section aria-labelledby="list-h">
      <h2 id="list-h" class="dp-h2">Week {week} rankings</h2>
      <p class="dp-note">
        Rating = points per set the team would beat an average Division I team by
        (for example, <strong>+4.2</strong> beats an average Division I team by about 4 points a set).
        Movement is against the previous published week.
      </p>
      <div class="dp-table-wrap">
        <table class="dp-table">
          <thead>
            <tr>
              <th scope="col" class="num">Rank</th>
              <th scope="col">Team</th>
              <th scope="col" class="hide-sm">Conference</th>
              <th scope="col" class="num">Record</th>
              <th scope="col" class="num">Rating</th>
              <th scope="col" class="num">Move</th>
            </tr>
          </thead>
          <tbody>
            {top.map((r) => {
              const m = move(r);
              return (
                <tr>
                  <td class="num rank">{r.rank}</td>
                  <th scope="row" class="team">
                    <span class="spine" style={`background:${teamColor(teams.get(r.team_uuid))}`}></span>
                    {r.team_name}
                  </th>
                  <td class="hide-sm muted">{r.conference ?? ''}</td>
                  <td class="num">{record(r)}</td>
                  <td class="num">{fmtRating(r.rating)}</td>
                  <td class={`num mv ${m.cls}`} aria-label={m.label}>{m.text}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="how-h" class="dp-section">
      <h2 id="how-h" class="dp-h2">How it works</h2>
      <p class="dp-body">
        The VOLI Top 100 is computed from match results and strength of schedule. Each team's
        rating (AMR, Adjusted Margin Rating) is the number of points per set it would beat an
        average Division I team by. Ratings update after every match; the published list is set
        each Monday and doesn't change afterwards. The Top 100 has been published each Monday
        since September 2026.
      </p>
      <p class="dp-body">
        Looking for the coaches' view? The AVCA Coaches Poll archive, back to 1982, is in
        <a class="dp-link" href="/encyclopedia">the Volleyball Encyclopedia</a>.
      </p>
    </section>

    <section aria-labelledby="mu-h" class="dp-section">
      <h2 id="mu-h" class="dp-h2">This week's matchups</h2>
      <p class="dp-note">
        Top 100 vs Top 100 matches in the next seven days, with each side's pre-match chance to
        win from VOLI's model and the most likely set score. Pre-match, as of {predStamp}.
        Times are Pacific.
      </p>
      {matchups.length ? (
        <div class="dp-table-wrap">
          <table class="dp-table">
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Matchup</th>
                <th scope="col" class="num">Chance to win</th>
                <th scope="col" class="hide-sm">Most likely</th>
              </tr>
            </thead>
            <tbody>
              {matchups.map((m) => (
                <tr>
                  <td class="muted nowrap">{shortDay(m.day)}<br /><span class="small">{m.time}</span></td>
                  <td>
                    <span class="mu-line"><span class="rk">#{m.away.rank}</span> {m.away.name}</span>
                    <span class="mu-line"><span class="at">at</span> <span class="rk">#{m.home.rank}</span> {m.home.name}</span>
                  </td>
                  <td class="num">
                    <span class="mu-line">{m.away.pct}%</span>
                    <span class="mu-line">{m.home.pct}%</span>
                  </td>
                  <td class="hide-sm">{m.likely} <span class="muted small">({m.likelyPct}%)</span></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="dp-body">No Top 100 vs Top 100 matches are scheduled in the next seven days.</p>
      )}
    </section>

    <section class="dp-section dp-cta">
      <h2 class="dp-h2">Every team, every match, in the app</h2>
      <p class="dp-body">
        The full ratings, every match's chance to win, live scores, box scores and play-by-play are
        in the free VOLI app, alongside fantasy leagues, news and podcasts.
      </p>
      <p class="dp-links">
        <a class="dp-link" href="/ncaa-volleyball">College volleyball on VOLI</a>
        <a class="dp-link" href="/ncaa-volleyball/leaders">Division I stat leaders</a>
        <a class="dp-link" href="/mobileapp">Get the VOLI app</a>
      </p>
    </section>
  </main>
</Layout>

<style>
  .dp-main { max-width: 980px; margin: 0 auto; padding: calc(5rem + env(safe-area-inset-top)) 1.5rem 5rem; }
  .dp-head { margin-bottom: 2.25rem; }
  .dp-kicker { color: var(--text-muted); font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 0.6rem; }
  .dp-title { font-family: 'Designer', 'Inter', -apple-system, sans-serif; font-size: clamp(2.1rem, 5.5vw, 3.2rem); line-height: 1.02; margin: 0; text-transform: uppercase; }
  .dp-lead { margin: 1rem 0 0; color: var(--text-secondary); font-size: 1.05rem; line-height: 1.65; max-width: 62ch; }
  .dp-stamp { margin: 0.6rem 0 0; color: var(--accent); font-size: 0.95rem; }
  .dp-section { margin-top: 3rem; }
  .dp-h2 { font-size: 1.3rem; font-weight: 700; margin: 0 0 0.75rem; }
  .dp-note { color: var(--text-muted); font-size: 0.88rem; line-height: 1.55; margin: 0 0 1rem; max-width: 70ch; }
  .dp-body { color: var(--text-secondary); font-size: 1rem; line-height: 1.7; margin: 0 0 1rem; max-width: 68ch; }
  .dp-link { color: var(--accent); font-weight: 600; }
  .dp-link:hover { text-decoration: underline; }
  .dp-links { display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; }
  .dp-table-wrap { background: var(--bg-card); border: 1px solid var(--glass-border); border-radius: 18px; overflow-x: auto; }
  .dp-table { width: 100%; border-collapse: collapse; font-size: 0.92rem; }
  .dp-table th, .dp-table td { padding: 0.62rem 0.85rem; text-align: left; border-bottom: 1px solid var(--glass-border); vertical-align: middle; }
  .dp-table thead th { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--text-muted); font-weight: 700; }
  .dp-table tbody tr:last-child > * { border-bottom: none; }
  .dp-table .num { text-align: right; font-variant-numeric: tabular-nums; }
  .dp-table .rank { font-weight: 800; color: var(--text-primary); }
  .dp-table .team { font-weight: 600; white-space: nowrap; }
  .spine { display: inline-block; width: 4px; height: 1.1em; border-radius: 2px; margin-right: 0.6rem; vertical-align: -0.15em; }
  .muted { color: var(--text-muted); }
  .small { font-size: 0.8rem; }
  .nowrap { white-space: nowrap; }
  .mv { font-weight: 700; font-size: 0.82rem; }
  .mv-up { color: var(--accent); }
  .mv-down { color: var(--rose); }
  .mv-new { color: var(--electric-blue); }
  .mv-flat { color: var(--text-muted); }
  .mu-line { display: block; line-height: 1.6; }
  .rk { color: var(--text-muted); font-size: 0.8rem; font-weight: 700; margin-right: 0.2rem; }
  .at { color: var(--text-muted); font-size: 0.8rem; }
  @media (max-width: 640px) {
    .dp-main { padding: calc(5rem + env(safe-area-inset-top)) 1rem 4rem; }
    .hide-sm { display: none; }
    .dp-table th, .dp-table td { padding: 0.55rem 0.6rem; }
  }
</style>
