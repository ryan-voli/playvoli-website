---
// The VOLI Top 100 (owner, 15 Oct 2026): rendered on each request with the
// newest published week, so it is never stale and crawlers get the full list
// in the HTML. A short CDN cache (60 s) keeps a traffic burst off the database;
// a failed fetch is never cached.
import SiteLayout from '../layouts/SiteLayout.astro';
import { STORE } from '../lib/voli-facts';
import { currentNcaaRanking, type PublishedRanking } from '../lib/voli-rankings';

export const prerender = false;

let ranking: PublishedRanking | null = null;
try {
  ranking = await currentNcaaRanking();
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
} catch (e) {
  console.error('[rankings]', e);
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const year = ranking ? ranking.season.slice(0, 4) : '';
const published = ranking
  ? new Date(`${ranking.publishedAt}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : '';
const rating = (v: number | null) => (v === null ? '—' : `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const record = (w: number | null, l: number | null) => (w === null || l === null ? '—' : `${w}–${l}`);
const move = (rank: number, prev: number | null) => {
  if (prev === null) return { text: 'New', cls: 'is-new' };
  const d = prev - rank;
  if (d > 0) return { text: `▲${d}`, cls: 'is-up' };
  if (d < 0) return { text: `▼${-d}`, cls: 'is-down' };
  return { text: '–', cls: 'is-same' };
};

const schema = ranking
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': 'https://playvoli.com/rankings#top-100',
      name: `VOLI Top 100, ${year} NCAA Division I women's volleyball, week ${ranking.week}`,
      description: "VOLI's own ranking of NCAA Division I women's volleyball teams from match results and strength of schedule, published each Monday.",
      url: 'https://playvoli.com/rankings',
      datePublished: ranking.publishedAt,
      numberOfItems: ranking.teams.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: ranking.teams.map((t) => ({
        '@type': 'ListItem',
        position: t.rank,
        item: { '@type': 'SportsTeam', name: t.name, sport: 'Volleyball' },
      })),
    }
  : null;

const description = ranking
  ? `The VOLI Top 100 for ${year} NCAA Division I women's volleyball, week ${ranking.week}: every team's rank, record and rating, published ${published}.`
  : "The VOLI Top 100: VOLI's weekly ranking of NCAA Division I women's volleyball teams.";
---

<SiteLayout
  title={ranking ? `VOLI Top 100: NCAA Volleyball Rankings, Week ${ranking.week}` : 'VOLI Top 100: NCAA Volleyball Rankings'}
  description={description}
  activePage="rankings"
  ogUrl="https://playvoli.com/rankings"
  schema={schema ?? undefined}
>
    <main class="v-page">
        <div class="v-wrap r-wrap">
            <p class="v-label v-label--sans r-eyebrow">VOLI Rankings</p>
            <h1 class="v-title-plain r-title">VOLI Top 100</h1>

            {ranking ? (
                <>
                    <p class="r-when v-meta">{year} NCAA Division I women's volleyball · Week {ranking.week} · Published {published}</p>
                    <p class="v-lede r-lede">VOLI's own ranking of Division I teams from match results and strength of schedule, published each Monday. Rating is points per set against an average Division I team. <a href="/methods#top-100" class="v-link">How it's computed</a></p>

                    <div class="r-table-wrap v-card v-card--plate">
                        <table class="r-table">
                            <thead>
                                <tr>
                                    <th scope="col" class="c-rank">#</th>
                                    <th scope="col" class="c-team">Team</th>
                                    <th scope="col" class="c-rec">Record</th>
                                    <th scope="col" class="c-rat">Rating</th>
                                    <th scope="col" class="c-move"><span class="sr-only">Change from last week</span><span aria-hidden="true">Move</span></th>
                                </tr>
                            </thead>
                            <tbody>
                                {ranking.teams.map((t) => {
                                    const m = move(t.rank, t.prevRank);
                                    return (
                                        <tr class={t.rank === 25 ? 'is-cut' : undefined}>
                                            <td class="c-rank">{t.rank}</td>
                                            <td class="c-team">
                                                <span class="t-name">{t.name}</span>
                                                {t.conference && <span class="t-conf">{t.conference}</span>}
                                            </td>
                                            <td class="c-rec">{record(t.wins, t.losses)}</td>
                                            <td class="c-rat">{rating(t.rating)}</td>
                                            <td class={`c-move ${m.cls}`}>{m.text}</td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </div>
                </>
            ) : (
                <div class="v-card v-card--plate r-down">
                    <p class="v-body">The rankings couldn't load right now. Try again in a minute, or see them in the VOLI app.</p>
                </div>
            )}

            <div class="r-cta">
                <p class="v-body">Every team's rating, each match's chance to win, and the AVCA Coaches Poll and EVOLLVE ratings beside it, in VOLI. Free on iPhone and Android.</p>
                <div class="v-stores">
                    <a href={STORE.ios} class="v-store">
                        <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                            <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                        </svg>
                        <div>
                            <span class="v-store__small">Download on the</span>
                            <span class="v-store__big">App Store</span>
                        </div>
                    </a>
                    <a href={STORE.android} class="v-store">
                        <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                            <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                        </svg>
                        <div>
                            <span class="v-store__small">Get it on</span>
                            <span class="v-store__big">Google Play</span>
                        </div>
                    </a>
                </div>
            </div>

            <p class="r-related v-meta">
                <a href="/methods" class="v-link">How VOLI's numbers work</a> ·
                <a href="/faq" class="v-link">FAQ</a> ·
                <a href="/app" class="v-link">Everything in VOLI</a>
            </p>
        </div>
    </main>
</SiteLayout>

<style>
    .r-wrap { max-width: 760px; }
    .r-eyebrow { padding: 0; margin: 0 0 10px; }
    .r-title { margin: 0 0 8px; text-align: center; }
    .r-when { margin: 0 0 14px; text-align: center; }
    .r-lede { margin: 0 auto 28px; max-width: 62ch; text-align: center; }

    .r-table-wrap { padding: 8px 4px; overflow-x: auto; }
    .r-table { width: 100%; border-collapse: collapse; font-variant-numeric: tabular-nums; }
    .r-table th {
        padding: 10px 12px;
        font: 600 11px/1.2 var(--font-body);
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--ink-2);
        text-align: left;
        border-bottom: 1px solid var(--line);
    }
    .r-table td {
        padding: 10px 12px;
        border-bottom: 1px solid var(--line);
        font: 400 15px/1.3 var(--font-body);
        color: var(--ink-body);
        vertical-align: middle;
    }
    .r-table tbody tr:last-child td { border-bottom: 0; }
    /* The line under #25: the top 25 most fans look for. */
    .r-table tr.is-cut td { border-bottom: 1px solid var(--outline); box-shadow: 0 1px 0 var(--outline); }

    /* Column widths and alignment apply to the header too; looks only to the body cells. */
    .c-rank { width: 44px; text-align: right; }
    .c-rec, .c-rat, .c-move { text-align: right; white-space: nowrap; }
    .c-move { width: 64px; }
    .r-table th.c-rank, .r-table th.c-rec, .r-table th.c-rat, .r-table th.c-move { text-align: right; }
    .r-table td.c-rank { color: var(--ink); font-weight: 700; }
    .r-table td.c-rat { color: var(--ink); }
    .r-table td.c-move { font-size: 13px; font-weight: 600; }
    .t-name { display: block; font-weight: 600; color: var(--ink); }
    .t-conf { display: block; margin-top: 2px; font-size: 12px; color: var(--ink-2); }
    .r-table td.is-up { color: var(--lemon-lime); }
    .r-table td.is-down { color: var(--rose); }
    .r-table td.is-same { color: var(--ink-3); }
    .r-table td.is-new { color: var(--electric-blue); }

    .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }

    .r-down p { margin: 0; text-align: center; }
    .r-cta { display: flex; flex-direction: column; align-items: center; gap: 14px; margin-top: 40px; text-align: center; }
    .r-cta p { margin: 0; max-width: 56ch; }
    .r-related { margin: 28px 0 0; text-align: center; }

    @media (max-width: 520px) {
        .r-table th, .r-table td { padding: 9px 8px; }
        .r-table td { font-size: 14px; }
        .c-rank { width: 32px; }
        .c-move { width: 48px; }
    }
</style>
