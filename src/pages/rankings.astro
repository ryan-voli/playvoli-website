---
// The VOLI Top 100 (owner, 15 Oct 2026): rendered on each request with the
// newest published week, so it is never stale and crawlers get the full list
// in the HTML. A short CDN cache (60 s) keeps a traffic burst off the database;
// a failed fetch is never cached.
//
// Live data only ever reaches the display face as digits (the week number and
// the ranks): Designer is checked glyph by glyph when the page renders, and a
// team name in a display line could stop the page.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/rankings.css';
import Badge from '../components/pearl/kit/Badge.astro';
import Band from '../components/pearl/kit/Band.astro';
import Btn from '../components/pearl/kit/Btn.astro';
import Cols from '../components/pearl/kit/Cols.astro';
import Copy from '../components/pearl/kit/Copy.astro';
import DataTable from '../components/pearl/kit/DataTable.astro';
import Faq from '../components/pearl/kit/Faq.astro';
import GetApp from '../components/pearl/kit/GetApp.astro';
import Note from '../components/pearl/kit/Note.astro';
import PageHero from '../components/pearl/kit/PageHero.astro';
import Phone from '../components/pearl/kit/Phone.astro';
import Stack from '../components/pearl/kit/Stack.astro';
import Steps from '../components/pearl/kit/Steps.astro';
import Sticker from '../components/pearl/kit/Sticker.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import Tickets from '../components/pearl/kit/Tickets.astro';
import { FAQS, faqSchema, type Faq as FaqItem } from '../lib/voli-facts';
import { SITE_URL, sectionMenu, type SectionMenu } from '../lib/site';
import { currentNcaaRanking, type PublishedRanking } from '../lib/voli-rankings';

export const prerender = false;

let ranking: PublishedRanking | null = null;
try {
  ranking = await currentNcaaRanking();
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60, stale-while-revalidate=300');
} catch (e) {
  console.error('[rankings]', e);
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const year = ranking ? ranking.season.slice(0, 4) : '';
const published = ranking
  ? new Date(`${ranking.publishedAt}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' })
  : '';
const rating = (v: number | null) => (v === null ? '—' : `${v >= 0 ? '+' : '−'}${Math.abs(v).toFixed(1)}`);
const record = (w: number | null, l: number | null) => (w === null || l === null ? '—' : `${w}–${l}`);
const move = (rank: number, prev: number | null) => {
  if (prev === null) return { text: 'New', cls: 'is-new' };
  const d = prev - rank;
  if (d > 0) return { text: `▲${d}`, cls: 'is-up' };
  if (d < 0) return { text: `▼${-d}`, cls: 'is-down' };
  return { text: '–', cls: 'is-same' };
};

const schema = ranking
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      '@id': 'https://playvoli.com/rankings#top-100',
      name: `VOLI Top 100, ${year} NCAA Division I women's volleyball, week ${ranking.week}`,
      description: "VOLI's own ranking of NCAA Division I women's volleyball teams from match results and strength of schedule, published each Monday.",
      url: 'https://playvoli.com/rankings',
      datePublished: ranking.publishedAt,
      numberOfItems: ranking.teams.length,
      itemListOrder: 'https://schema.org/ItemListOrderAscending',
      itemListElement: ranking.teams.map((t) => ({
        '@type': 'ListItem',
        position: t.rank,
        item: { '@type': 'SportsTeam', name: t.name, sport: 'Volleyball' },
      })),
    }
  : null;

const description = ranking
  ? `The VOLI Top 100 for ${year} NCAA Division I women's volleyball, week ${ranking.week}: every team's rank, record and rating, published ${published}.`
  : "The VOLI Top 100: VOLI's weekly ranking of NCAA Division I women's volleyball teams.";

// The lime bar: this page's sections, then the method behind them. /methods
// writes the same menu, with these stops pointing back here.
const MENU: SectionMenu = {
  label: 'VOLI Top 100',
  base: '/rankings',
  sections: [
    { id: 'top-100', label: 'Top 100' },
    { id: 'how', label: 'How it works', short: 'How' },
    { id: 'chances', label: 'Win chances', short: 'Chances' },
    { id: 'faq', label: 'FAQ' },
  ],
  pages: [{ href: '/methods', label: 'Methods' }],
};

// The questions this page answers. "rankings" is the site's own answer (it is
// marked up here and nowhere else); the other three are answered by /methods.
const questions: FaqItem[] = [
  FAQS.find((f) => f.id === 'rankings')!,
  {
    id: 'updates',
    q: 'How often is the VOLI Top 100 updated?',
    a: "Once a week. VOLI's team ratings are recomputed nightly from all completed matches, and the VOLI Top 100 is set each Monday from the latest ratings. It doesn't change afterwards, and it has been published each Monday since September 2026.",
  },
  {
    id: 'rating',
    q: "What does a team's rating in the VOLI Top 100 mean?",
    a: "The rating, AMR (Adjusted Margin Rating), is the number of points per set a team would beat an average Division I team by. A rating of +4.2 means the team beats an average Division I team by about 4 points a set. It starts from each set's point margin and adjusts it for the opponent.",
  },
  {
    id: 'every-team',
    q: 'Does VOLI rate teams outside the Top 100?',
    a: "Yes. VOLI computes a rating for every Division I team, so the list stops at 100 only for display. The ratings, the VOLI Top 100 and each match's chance to win are in the VOLI app, free on iPhone and Android.",
  },
];

// What the VOLI Top 100 is, answer first, under the h1.
const LEDE = "The VOLI Top 100 is VOLI's own ranking of NCAA <span class=\"nb\">Division I</span> women's volleyball teams. VOLI rates every <span class=\"nb\">Division I</span> team from match results and strength of schedule, and publishes the top 100 each Monday.";

// This week's leaders for the hero, and the longest rating for the bars in the table.
const leaders = ranking ? ranking.teams.slice(0, 4) : [];
const best = ranking ? Math.max(0, ...ranking.teams.map((t) => t.rating ?? 0)) : 0;
const bar = (v: number | null) => (v !== null && v > 0 && best > 0 ? Math.round((v / best) * 1000) / 1000 : null);
const CUTS = [25, 50, 75];
---

<Pearl
  title={ranking ? `VOLI Top 100: NCAA Volleyball Rankings, Week ${ranking.week}` : 'VOLI Top 100: NCAA Volleyball Rankings'}
  description={description}
  section="rankings"
  subnav={sectionMenu(MENU, '/rankings')}
  schema={[...(schema ? [schema] : []), faqSchema(questions, `${SITE_URL}/rankings`)]}
>
    {/* Without this week's list the hero has no art, and is drawn as a hero without art. */}
    <PageHero color="rose" label="NCAA volleyball rankings" lines={[['VOLI', 'Top 100']]} em="Top 100">
        <p class="lede" set:html={LEDE} />
        {ranking && <p class="rk-when"><span class="tag">{year} · Week {ranking.week}</span> <span>Published {published}</span></p>}
        <Stores />
        {ranking && (
            <Tickets slot="art" class="rk-lead" label="This week's top four" items={leaders.map((t) => ({
              value: `#${t.rank}`,
              label: `${t.name}, ${record(t.wins, t.losses)}, ${rating(t.rating)}`,
            }))} />
        )}
    </PageHero>

    <Band
      color="ink"
      id="top-100"
      tone="lime"
      lines={[{ text: ranking ? `Week ${ranking.week} rankings` : 'The rankings', size: 'sm' }]}
      stamp={ranking ? `Published ${published}` : undefined}
      pb={6}
    >
        {ranking ? (
            <Cols wide>
                <div>
                    <p class="body rk-key"><strong>Rating</strong> is the number of points per set a team would beat an average <span class="nb">Division I</span> team by. <strong>Move</strong> is the change since last week; <strong>New</strong> means the team was not in last week's Top 100. <a class="link" href="/methods#top-100">How the rating is computed</a></p>
                    <DataTable label={`VOLI Top 100, week ${ranking.week}`}>
                        <table class="tbl tbl--tight rk-tbl">
                            <caption>VOLI Top 100, {year} NCAA <span class="nb">Division I</span> women's volleyball, week {ranking.week}</caption>
                            <thead>
                                <tr>
                                    <th scope="col" class="rk-h-rank"><span aria-hidden="true">#</span> <span class="vh">Rank</span></th>
                                    <th scope="col" class="rk-h-move"><span class="vh">Change from last week</span> <span aria-hidden="true">Move</span></th>
                                    <th scope="col" class="l">Team</th>
                                    <th scope="col" class="rk-h-rec">Record</th>
                                    <th scope="col" class="rk-h-rat">Rating</th>
                                </tr>
                            </thead>
                            <tbody>
                                {ranking.teams.map((t) => {
                                    const m = move(t.rank, t.prevRank);
                                    const v = bar(t.rating);
                                    return (
                                        <tr class={CUTS.includes(t.rank) ? 'cut' : undefined}>
                                            <td class="rank">{t.rank}</td>
                                            <td class={`rk-move ${m.cls}`}>{m.text}</td>
                                            <th scope="row" class="l rk-team"><span class="rk-name">{t.name}</span>{t.conference && <Fragment>{' '}<span class="rk-conf">{t.conference}</span></Fragment>}</th>
                                            <td class="rk-rec">{record(t.wins, t.losses)}</td>
                                            <td class="rk-rat">{v !== null && <span class="rk-bar" style={`--v:${v}`} aria-hidden="true"></span>}{rating(t.rating)}</td>
                                        </tr>
                                    );
                                })}
                            </tbody>
                        </table>
                    </DataTable>
                </div>
            </Cols>
        ) : (
            <Cols max="40rem">
                <Copy>
                    <Note bad>The rankings couldn't load right now. Try again in a minute, or see them in the VOLI app.</Note>
                    <div class="btns">
                        <Btn href="/rankings">Try again</Btn>
                        <Btn href="#get">Get the app</Btn>
                    </div>
                </Copy>
            </Cols>
        )}
    </Band>

    <Band color="lime" id="how" kicker="How the VOLI" title="Top 100" sub="is computed">
        <Cols max="40rem">
            <Copy>
                <p class="lede">The VOLI Top 100 is computed from match results and strength of schedule.</p>
                <p class="body">Each team's rating, <strong>AMR (Adjusted Margin Rating)</strong>, is the number of points per set it would beat an average <span class="nb">Division I</span> team by. A rating of +4.2 means the team beats an average <span class="nb">Division I</span> team by about 4 points a set.</p>
            </Copy>
        </Cols>
        <Steps items={[
          { title: "Every set's margin", text: "The rating starts from the point margin of each set a team plays." },
          { title: 'Adjusted for the opponent', text: 'A close set against a strong team can say more than a lopsided one against a weak team.' },
          { title: 'A preseason start', text: "Early in the season a starting point carries some of the weight: the team's rating last season and how many of its players return. It fades as real results come in." },
          { title: 'Set each Monday', text: "Ratings are recomputed nightly from all completed matches. The Top 100 is set each Monday from the latest ratings, and it doesn't change afterwards." },
        ]} />
        <Cols max="40rem">
            <Copy>
                <p class="body">Ratings are computed for every <span class="nb">Division I</span> team, so the list stops at 100 only for display.</p>
                <Btn href="/methods">How VOLI's numbers work</Btn>
            </Copy>
        </Cols>
    </Band>

    <Band color="blue" id="chances" kicker="Each match's" title={['chance', 'to win']}>
        <Cols ratio="42:50" drop={[0, 3]}>
            <Copy>
                <p class="lede">Before first serve, each upcoming college match in the VOLI app shows each team's chance to win and the most likely set score.</p>
                <p class="body">Both come from the gap between the two teams' ratings: the bigger the gap, the more likely the higher-rated team wins. During the match, the chance to win updates after every set.</p>
                <p class="body">The app also shows the AVCA Coaches Poll and <a class="link" href="/evollve">EVOLLVE's team ratings</a> next to VOLI's own.</p>
                <Btn href="/methods#chance-to-win">How win chances work</Btn>
                <Stack ratio="100/40" class="rk-fig">
                    <Sticker cut="card-game" x={1} y={8} w={92} r={-3.75} shadow="rose" />
                </Stack>
            </Copy>
            <Stack ratio="100/104">
                <Phone screen="gameLive" x={2} y={0} w={44} wm={46} r={-7.5} />
                <Phone screen="rankings" x={54} xm={52} y={9} w={44} wm={46} r={3.75} />
                <Badge value="6" label="possible final scores weighed for each match" x={30} xm={22} y={72} ym={70} z={3} shadow="lime" />
            </Stack>
        </Cols>
    </Band>

    <Band color="ink" id="faq" title="Questions" sub="about the Top 100" tone="lime" em="Top 100">
        <Faq items={questions} fold={false}>
            <Btn slot="more" href="/about#faq">All questions and answers</Btn>
        </Faq>
    </Band>

    <GetApp
      lede="VOLI's ratings, each match's chance to win, and the AVCA Coaches Poll and EVOLLVE's ratings beside them, in the free VOLI app."
      links={[
        { href: '/methods', label: "How VOLI's numbers work" },
        { href: '/evollve', label: 'EVOLLVE on VOLI' },
        { href: '/bracket', label: 'Bracket Challenge' },
        { href: '/', label: 'Everything in VOLI' },
        { href: '/about#faq', label: 'Questions about VOLI' },
      ]}
    />
</Pearl>
