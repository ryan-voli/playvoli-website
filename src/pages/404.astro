---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Service Error - VOLI"
  description="The court you are looking for does not exist."
>
    <main class="v-page v-page--center nf">
      <div class="v-wrap v-wrap--narrow v-center">
        <div class="error-code v-hero">404</div>
        <h1 class="v-h1 nf-title">Service Error</h1>
        <p class="v-body nf-sub">The court you are looking for does not exist.</p>
        <a href="/" class="btn-home v-pill v-pill--cta v-pill--action">Return Home</a>
      </div>
    </main>
</SiteLayout>

<style>
    .nf { padding-bottom: 64px; }
    .error-code { margin: 0 0 16px; color: var(--ink); }
    .nf-title { margin: 0 0 12px; }
    .nf-sub { margin: 0 0 32px; }
</style>
