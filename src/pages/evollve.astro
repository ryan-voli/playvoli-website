---
// EVOLLVE partner page (owner, 15 Oct 2026). EVOLLVE (evollve.net) is a data
// partner, not a podcast, so the lander's one action is their site; the list
// is what VOLI shows from their data. Same v-stub card as the podcast landers.
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Analytics by EVOLLVE - VOLI"
  description="EVOLLVE's college volleyball analytics are built into VOLI: nightly team ratings for every Division I team, player impact numbers like RAPM, and match predictions."
  ogUrl="https://playvoli.com/evollve"
  skipSupabase
  skipNavAuth
>
    <main class="v-page v-page--center">
        <div class="v-stub">
            <h1 class="evollve-lockup">
                <span class="evollve-lockup__by">Analytics by</span>
                <img src="/images/partners/evollve-wordmark.webp" alt="EVOLLVE" class="evollve-wordmark" width="600" height="109">
            </h1>
            <p class="v-body v-stub__sub">EVOLLVE's advanced college volleyball analytics, built right into VOLI.</p>

            <ul class="evollve-list">
                <li><strong>Team ratings</strong> for every Division I team, updated nightly, alongside the AVCA poll and VOLI's own rankings</li>
                <li><strong>Player impact</strong> with RAPM and per-game Impact, Attack, Serve and Defense numbers</li>
                <li><strong>Match predictions</strong> with win chances in game previews</li>
                <li><strong>EVOLLVE sorts</strong> for players and teams on the Stats page</li>
            </ul>

            <div class="v-actions">
                <a href="https://evollve.net" target="_blank" rel="noopener"
                   onclick="plausible('EVOLLVE Visit'); gtag('event', 'click', {'event_category': 'partner', 'event_label': 'evollve_site', 'source': 'evollve'});"
                   class="v-pill v-pill--cta v-pill--action v-pill--block">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    Visit evollve.net
                </a>
            </div>

            <div class="v-rule-label v-stub__divider">
                <span>See it in VOLI</span>
            </div>

            <div class="store-buttons v-stores v-stores--stack">
                <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982"
                   onclick="plausible('EVOLLVE App Store'); gtag('event', 'click', {'event_category': 'download', 'event_label': 'app_store', 'source': 'evollve'});"
                   class="v-store">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                    </svg>
                    <div>
                        <span class="v-store__small">Download on the</span>
                        <span class="v-store__big">App Store</span>
                    </div>
                </a>

                <a href="https://play.google.com/store/apps/details?id=com.playvoli.app"
                   onclick="plausible('EVOLLVE Google Play'); gtag('event', 'click', {'event_category': 'download', 'event_label': 'play_store', 'source': 'evollve'});"
                   class="v-store">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                    </svg>
                    <div>
                        <span class="v-store__small">Get it on</span>
                        <span class="v-store__big">Google Play</span>
                    </div>
                </a>
            </div>
        </div>
    </main>
</SiteLayout>

<style>
    /* "Analytics by" over the wordmark is the heading (owner, 15 Oct 2026):
       no display-face headline on this page. */
    .evollve-lockup {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        margin: 4px 0 20px;
    }

    .evollve-lockup__by {
        font: 600 12px/1 var(--font-body);
        letter-spacing: 0.2em;
        margin-right: -0.2em;
        text-transform: uppercase;
        color: var(--ink-2);
    }

    .evollve-wordmark {
        display: block;
        width: min(220px, 70%);
        height: auto;
    }

    .evollve-list {
        list-style: none;
        margin: 0 0 24px;
        padding: 0;
        display: grid;
        gap: 12px;
        text-align: left;
    }

    .evollve-list li {
        position: relative;
        padding-left: 20px;
        font: 400 var(--fs-body)/1.45 var(--font-body);
        color: var(--ink-body);
    }

    .evollve-list li::before {
        content: '';
        position: absolute;
        left: 2px;
        top: 0.55em;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--lemon-lime);
    }

    .evollve-list strong { color: #fff; font-weight: 600; }
</style>
