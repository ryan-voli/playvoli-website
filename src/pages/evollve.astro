---
// Analytics by EVOLLVE: what EVOLLVE's college volleyball numbers are, where
// they show up in VOLI, and who EVOLLVE is. EVOLLVE (evollve.net) is a data
// partner; its numbers are computed by EVOLLVE and labeled as theirs in the
// app, next to VOLI's own ratings and the AVCA Coaches Poll.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/evollve.css';
import Band from '../components/pearl/kit/Band.astro';
import Btn from '../components/pearl/kit/Btn.astro';
import Card from '../components/pearl/kit/Card.astro';
import Cols from '../components/pearl/kit/Cols.astro';
import Copy from '../components/pearl/kit/Copy.astro';
import GetApp from '../components/pearl/kit/GetApp.astro';
import PageHero from '../components/pearl/kit/PageHero.astro';
import Phone from '../components/pearl/kit/Phone.astro';
import Phones from '../components/pearl/kit/Phones.astro';
import Stack from '../components/pearl/kit/Stack.astro';
import Sticker from '../components/pearl/kit/Sticker.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import { pageSchema } from '../components/products/schema';
import { SCREENS } from '../lib/screens';

const title = 'EVOLLVE Analytics: College Volleyball Ratings and RAPM | VOLI';
const description =
  "EVOLLVE's college volleyball analytics in the free VOLI app for iPhone and Android: nightly ratings for all Division I teams, player RAPM and match predictions.";

const subnav = {
  label: 'Analytics by EVOLLVE',
  items: [
    { href: '#what', label: 'What you get', short: 'You get' },
    { href: '#where', label: 'Where it shows up', short: 'Where' },
    { href: '#about', label: 'About EVOLLVE', short: 'About' },
  ],
};

const schema = pageSchema({
  path: '/evollve',
  name: 'Analytics by EVOLLVE in VOLI',
  description,
  crumbs: [
    { name: 'VOLI', path: '/' },
    { name: 'VOLI Top 100', path: '/rankings' },
    { name: 'Analytics by EVOLLVE', path: '/evollve' },
  ],
});
---

<Pearl title={title} description={description} section="rankings" subnav={subnav} schema={schema}>
    <link rel="preload" as="image" href={SCREENS.playerAnalytics.src} type="image/webp" fetchpriority="high" slot="head" />

    <PageHero
      color="blue"
      label={['College volleyball analytics', 'in the VOLI app']}
      lines={[{ text: 'Analytics by', hollow: true }, 'EVOLLVE']}
    >
        <p class="lede">EVOLLVE's college volleyball analytics are built into VOLI: nightly ratings for every <span class="nb">Division I</span> team, player impact numbers such as RAPM, and match predictions. Free on iPhone and Android.</p>
        <Stores />
        <p class="small">EVOLLVE makes the numbers. See more of their work at <a class="link" href="https://evollve.net" target="_blank" rel="noopener" data-track="partner:evollve_site">evollve.net</a>.</p>
        <Phones slot="art" screens={['playerAnalytics', 'teamAnalytics']} step eager />
    </PageHero>

    <Band color="lime" id="what" pb={4} lines={[{ text: 'What you get', size: 'sm' }]}>
        <Cols max="38rem">
            <p class="lede">Four kinds of EVOLLVE numbers sit inside VOLI, each labeled as EVOLLVE's, next to VOLI's own ratings and the AVCA Coaches Poll.</p>
        </Cols>
        <Cols ratio="1:1:1:1">
            <Card name="Team ratings" kicker="Updated nightly">
                <p>Ratings for every <span class="nb">Division I</span> team, updated each night, alongside the AVCA Coaches Poll and the VOLI Top 100.</p>
            </Card>
            <Card name="Player impact" kicker="RAPM">
                <p>RAPM for each player, with per-game Impact, Attack, Serve and Defense numbers.</p>
            </Card>
            <Card name="Match predictions" kicker="Game previews">
                <p>EVOLLVE's chance to win for each team, in college match previews.</p>
            </Card>
            <Card name="EVOLLVE sorts" kicker="Stats page">
                <p>Sort players and teams by EVOLLVE's numbers on the Stats page.</p>
            </Card>
        </Cols>
    </Band>

    <Band color="ink" id="where" title={['Where it', 'shows up']} tone="blue" em="shows up">
        <Cols ratio="46:46" drop={[0, 2]}>
            <div class="pr-places">
                <p class="lede">EVOLLVE's numbers show up from the Stats page to every team, player and game in VOLI.</p>
                <ul>
                    <li>
                        <h3 class="h3">The Stats page</h3>
                        <p class="body">EVOLLVE sorts for players and teams, and a switch in the Teams view between the AVCA Coaches Poll, the VOLI Top 100 and EVOLLVE's ratings.</p>
                    </li>
                    <li>
                        <h3 class="h3">Team pages</h3>
                        <p class="body">An Analytics tab with the team's AVCA, VOLI and EVOLLVE ranks side by side, its strongest and weakest areas, and where it ranks in attack, serve and block.</p>
                    </li>
                    <li>
                        <h3 class="h3">Player pages</h3>
                        <p class="body">An Analytics tab, analytics by EVOLLVE: the player's RAPM with their rank and percentile at their position, strongest and weakest skills, and attack percentiles.</p>
                    </li>
                    <li>
                        <h3 class="h3">Game previews</h3>
                        <p class="body">EVOLLVE's match prediction, with each team's chance to win, next to VOLI's own.</p>
                    </li>
                </ul>
                <div class="btns">
                    <Btn href="/rankings" tone="blue" shadow="white">The VOLI Top 100</Btn>
                </div>
            </div>
            <Stack ratio="100/104" shadow="blue">
                <Phone screen="rankings" x={2} y={0} w={44} wm={46} r={-7.5} />
                <Phone screen="playerTrends" x={54} xm={52} y={9} w={44} wm={46} r={7.5} />
            </Stack>
        </Cols>
    </Band>

    <Band color="rose" id="about" kicker="About" title="EVOLLVE">
        <Cols ratio="50:42" drop={[0, 2]}>
            <Copy>
                <p class="lede">EVOLLVE builds advanced analytics for college volleyball: ratings for every <span class="nb">Division I</span> team, player impact numbers like RAPM, and match predictions.</p>
                <p class="body">EVOLLVE computes these numbers, and VOLI labels them as EVOLLVE's wherever they appear. VOLI rates teams with a method of its own, published each Monday as the <a class="link" href="/rankings">VOLI Top 100</a>, and makes no player ratings of its own: player impact numbers in VOLI come from EVOLLVE.</p>
                <p class="body">How VOLI's own ratings and predictions work, and where EVOLLVE's fit beside them, is set out in <a class="link" href="/methods">How VOLI's numbers work</a>.</p>
                <div class="btns">
                    <Btn href="https://evollve.net" target="_blank" rel="noopener" track="partner:evollve_site">Visit evollve.net</Btn>
                </div>
            </Copy>
            <div class="pr-evollve-art">
                <div class="pr-logo">
                    <img src="/images/partners/evollve-wordmark-color.webp" width="1200" height="222" alt="EVOLLVE" loading="lazy" decoding="async">
                </div>
                <Stack ratio="100/56">
                    <Sticker cut="float-pct" x={4} y={6} w={90} r={3.75} shadow="white" />
                </Stack>
            </div>
        </Cols>
    </Band>

    <GetApp links={[
      { href: '/rankings', label: 'VOLI Top 100' },
      { href: '/methods', label: "How VOLI's numbers work" },
      { href: '/fantasy', label: 'Fantasy volleyball' },
      { href: '/', label: 'Everything in VOLI' },
    ]} />
</Pearl>
