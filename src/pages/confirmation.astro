---
import SiteLayout from '../layouts/SiteLayout.astro';
// Styles: styles/pearl/pages/account.css (loaded by SiteLayout).
---

<SiteLayout
  title="Email Confirmed - VOLI"
  description="Your email has been confirmed. You can now sign in to VOLI."
>
    <main class="acct">
        <div class="acct-card acct-card--center acct-stub">
            <div class="acct-badge-icon success-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                    <polyline points="22 4 12 14.01 9 11.01"/>
                </svg>
            </div>
            <h1 class="acct-title">Email <em>Confirmed!</em></h1>
            <p class="acct-sub">Thanks for confirming your email. You can now sign in on VOLI.</p>

            <div class="acct-actions">
                <a href="voli://" class="btn btn--primary acct-wide">Open VOLI App</a>
                <a href="/" class="btn btn--secondary acct-wide">Return Home</a>
            </div>
        </div>
    </main>
</SiteLayout>
