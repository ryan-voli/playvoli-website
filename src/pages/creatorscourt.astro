---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Creators Court - VOLI"
  description="The all-in-one platform for volleyball content creators. Analytics, fan engagement tools, game prep dashboards, article publishing, and live data APIs."
  ogUrl="https://playvoli.com/creatorscourt"
  skipSupabase
  skipNavAuth
>
    <main class="v-page">
        <div class="v-wrap v-wrap--read cc-stack">

        <!-- Hero -->
        <section class="cc-hero v-center">
            <div class="v-tile cc-hero-icon">
                <img src="/images/icons/creatorscourt.png" alt="" class="cc-hero-img">
            </div>
            <h1 class="v-h1 cc-title">Creators Court</h1>
            <p class="v-lede cc-subtitle">The all-in-one platform for volleyball podcasters, bloggers, and content creators.</p>
            <div class="v-chip v-chip--verdict is-blue">In Development</div>
        </section>

        <!-- What is it -->
        <section class="cc-section v-plate is-labelled">
            <div class="v-label v-label--sans">What Is It?</div>
            <p class="v-body cc-section-text">Creators Court is where volleyball content creators get the tools they need to grow their audience and make better content. Whether you're running a podcast, writing a blog, or building a YouTube channel — Creators Court gives you analytics, fan engagement features, game prep tools, and access to the most reliable volleyball data available.</p>
        </section>

        <!-- Analytics -->
        <section class="cc-section v-card v-card--plate is-labelled">
            <div class="v-label v-label--sans">Creator Analytics</div>
            <p class="v-body cc-section-text">A media-kit-ready analytics dashboard built for volleyball creators.</p>
            <div class="cc-features">
                <div class="v-tile cc-feature">
                    <img src="/images/icons/analytics.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Audience Insights</strong>
                        <span class="v-meta">Track plays, unique listeners, completions, favorites, loves, and shares across all your content.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/content_opt.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Episode Breakdown</strong>
                        <span class="v-meta">Per-episode analytics showing exactly what's resonating with your audience and what's not.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/leaderboard.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Data Dashboard</strong>
                        <span class="v-meta">Scores, standings, schedules, and detailed volleyball data organized and ready for your content.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Engagement Tools -->
        <section class="cc-section v-card v-card--plate is-labelled">
            <div class="v-label v-label--sans">Fan Engagement Tools</div>
            <p class="v-body cc-section-text">Build a loyal fanbase with interactive features that keep your audience coming back.</p>
            <div class="cc-features">
                <div class="v-tile cc-feature">
                    <img src="/images/icons/fantasy_opt.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Official Fantasy Leagues</strong>
                        <span class="v-meta">Create branded fantasy leagues tied to your show. Give your audience a reason to stay engaged all season.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/chat.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Ask Me Anything</strong>
                        <span class="v-meta">Host live AMA sessions where fans submit questions for athletes and guests on your show.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/thisorthat.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">This or That</strong>
                        <span class="v-meta">Run fan polls where your audience picks between players, teams, and scenarios — then discuss the results on air.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Game Prep & Data -->
        <section class="cc-section v-card v-card--plate is-labelled">
            <div class="v-label v-label--sans">Game Prep & Data</div>
            <p class="v-body cc-section-text">Never scramble for stats again. Everything you need to prepare for game coverage, all in one place.</p>
            <div class="cc-features">
                <div class="v-tile cc-feature">
                    <img src="/images/icons/games_opt.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Game Details Dashboard</strong>
                        <span class="v-meta">Schedules, lineups, head-to-head records, and matchup history — ready before tip-off.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/statistics_opt.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Reliable Statistics</strong>
                        <span class="v-meta">Access the same detailed stats that power the Voli app — attack efficiency, serve percentages, rotation data, and more.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/profile.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Player & Team Profiles</strong>
                        <span class="v-meta">Quick-reference profiles with season stats, transaction history, and performance trends.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Publishing & APIs -->
        <section class="cc-section v-card v-card--plate is-labelled">
            <div class="v-label v-label--sans">Publishing & APIs</div>
            <p class="v-body cc-section-text">Bring Voli's data to your own platform, or publish directly to ours.</p>
            <div class="cc-features">
                <div class="v-tile cc-feature">
                    <img src="/images/icons/edit.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Interactive Articles</strong>
                        <span class="v-meta">Write and publish articles on Voli with embedded live stats, player cards, and interactive elements.</span>
                    </div>
                </div>
                <div class="v-tile cc-feature">
                    <img src="/images/icons/share.png" alt="" class="cc-feature-icon">
                    <div>
                        <strong class="v-h3-plain">Voli Data APIs</strong>
                        <span class="v-meta">Pull live scores, stats, standings, and player data directly into your own blog or website with our API.</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Who is it for -->
        <section class="cc-section v-card v-card--plate is-labelled">
            <div class="v-label v-label--sans">Who Is It For?</div>
            <div class="v-grid v-grid--2">
                <div class="v-tile cc-audience-card">
                    <strong class="v-h3-plain">Podcasters</strong>
                    <span class="v-meta">Analytics, AMA sessions, fan engagement tools, and game prep data to elevate your show.</span>
                </div>
                <div class="v-tile cc-audience-card">
                    <strong class="v-h3-plain">Bloggers & Writers</strong>
                    <span class="v-meta">Publish interactive articles on Voli or use our APIs to bring live data to your own site.</span>
                </div>
                <div class="v-tile cc-audience-card">
                    <strong class="v-h3-plain">YouTubers & Streamers</strong>
                    <span class="v-meta">Reliable stats and game details for pre-show research and on-air reference.</span>
                </div>
                <div class="v-tile cc-audience-card">
                    <strong class="v-h3-plain">Community Builders</strong>
                    <span class="v-meta">Fantasy leagues, polls, and AMAs to keep your community active and engaged all season.</span>
                </div>
            </div>
        </section>

        <!-- CTA -->
        <section class="cc-cta v-center">
            <p class="v-q">Interested in joining Creators Court?</p>
            <a href="/contact" class="v-pill v-pill--cta v-pill--action">Get in Touch</a>
        </section>

        </div>
    </main>
</SiteLayout>

<style>
    /* Hero */
    .cc-stack > * + * { margin-top: var(--sp-4); }
    .cc-hero { margin-bottom: var(--sp-6); }
    .cc-hero-icon {
        width: 72px;
        height: 72px;
        border-radius: 20px;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 20px;
    }
    .cc-hero-img { width: 40px; height: 40px; object-fit: contain; }
    .cc-title { margin: 0 0 12px; }
    .cc-subtitle { max-width: 520px; margin: 0 auto 16px; }

    /* Sections */
    .cc-section-text { text-align: center; margin: 0 auto 16px; max-width: 60ch; }
    .cc-section > .cc-section-text:last-child { margin-bottom: 0; }

    /* Feature rows */
    .cc-features { display: flex; flex-direction: column; gap: 8px; }
    .cc-feature { display: flex; align-items: center; gap: 14px; padding: 12px 14px; }
    .cc-feature-icon { width: 28px; height: 28px; object-fit: contain; flex-shrink: 0; }
    .cc-feature strong, .cc-audience-card strong { display: block; margin-bottom: 2px; }
    .cc-audience-card { padding: 12px 14px; }
    .cc-audience-card strong { margin-bottom: 4px; }

    /* CTA */
    .cc-cta { padding-top: var(--sp-6); }
    .cc-cta .v-q { margin: 0 0 16px; }
</style>
