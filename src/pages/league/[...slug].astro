---
import SiteLayout from '../../layouts/SiteLayout.astro';

// STATIC ROUTE, DYNAMIC PATH. Only /league is emitted at build time; the
// rewrite in vercel.json ({ "source": "/league/:path*", "destination":
// "/league" }) serves this same page for /league/<leagueId>/<joinCode>.
// That means the invite path is NOT available to the server — it has to be
// read from location.pathname on the client, which is what the script below
// does. Do not "fix" this by adding params to getStaticPaths: league ids are
// not enumerable at build time.
export function getStaticPaths() {
  return [{ params: { slug: undefined } }];
}
---

<SiteLayout
  title="League Invite - VOLI"
  description="Join a fantasy volleyball league on VOLI."
  ogUrl="https://playvoli.com/league"
>
    <main class="v-page v-page--center">
      <div class="v-stub">
        <!-- Shown while we try to hand off to the app. Starts visible so a
             recipient whose app opens instantly never sees the fallback. -->
        <div id="opening">
            <div class="v-spinner league-spinner" aria-hidden="true"></div>
            <h1 class="v-q league-opening">Opening VOLI…</h1>
            <p class="v-meta">Taking you to this league in the app.</p>
        </div>

        <!-- Fallback: app not installed, or the handoff did not take. -->
        <div id="fallback" hidden>
            <h1 class="v-title-plain v-stub__title" id="fallback-title">Join this league</h1>
            <p class="v-body v-stub__sub" id="fallback-sub">
                You've been invited to a fantasy volleyball league on VOLI.
            </p>

            <div class="actions">
                <a href="#" id="retry" class="v-pill v-pill--cta v-pill--action v-pill--block">Open in the app</a>
            </div>
            <p class="v-path league-note" id="retry-note" hidden></p>

            <div class="v-rule-label v-stub__divider"><span>Don't have the app?</span></div>

            <div class="v-stores v-stores--stack">
                <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982" class="v-store">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                    </svg>
                    <span>
                        <span class="v-store__small">Download on the</span>
                        <span class="v-store__big">App Store</span>
                    </span>
                </a>

                <a href="https://play.google.com/store/apps/details?id=com.playvoli.app" class="v-store">
                    <svg viewBox="0 0 24 24" fill="white">
                        <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                    </svg>
                    <span>
                        <span class="v-store__small">Get it on</span>
                        <span class="v-store__big">Google Play</span>
                    </span>
                </a>
            </div>
        </div>

        <!-- No invite in the URL: someone browsed to /league directly. -->
        <div id="plain" hidden>
            <h1 class="v-h1 v-stub__title">Fantasy League</h1>
            <p class="v-body v-stub__sub">Coming soon to the web. Join leagues on the VOLI app.</p>
            <div class="actions">
                <a href="/" class="v-path v-stub__back">Return Home</a>
            </div>
        </div>
      </div>
    </main>
</SiteLayout>

<script is:inline>
(function () {
    var opening  = document.getElementById('opening');
    var fallback = document.getElementById('fallback');
    var plain    = document.getElementById('plain');

    function show(el) {
        opening.hidden = true; fallback.hidden = true; plain.hidden = true;
        el.hidden = false;
    }

    // /league/<leagueId>/<joinCode>. Both segments are required: the app's
    // handler (app_link_service.dart) needs pathSegments.length >= 3 and
    // passes [1] and [2] straight to LeagueInviteModal.
    var parts = window.location.pathname.split('/').filter(Boolean);
    if (parts.length < 3 || parts[0] !== 'league') {
        show(plain);
        return;
    }

    var leagueId = parts[1];
    var joinCode = parts[2];

    // Reject anything that isn't shaped like the real thing rather than
    // handing junk to the app or echoing it back into the page.
    var UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    var CODE = /^[A-Za-z0-9_-]{1,32}$/;
    if (!UUID.test(leagueId) || !CODE.test(joinCode)) {
        show(plain);
        return;
    }

    // Custom scheme, NOT the https universal link. If we are running at all,
    // the universal link has already failed to intercept — re-navigating to
    // the same https URL would just reload this page. voli:// still fires in
    // the in-app browsers (Instagram, Facebook, Discord) where universal
    // links are the thing that does not work, which is the main failure case.
    var appUrl = 'voli://league/' + encodeURIComponent(leagueId) + '/' + encodeURIComponent(joinCode);

    // DELIBERATELY NOT set as the button's href, and never handed to
    // window.location. Navigating straight to an unregistered scheme makes iOS
    // put up "Safari cannot open the page because the address is invalid" —
    // an OS-level alert that fires before any JS can intercept it, so it
    // cannot be caught or styled. An <a href="voli://..."> click does the same.
    //
    // A hidden iframe attempt fails SILENTLY instead: no alert anywhere, and
    // it still launches the app inside the WKWebView in-app browsers
    // (Instagram, Facebook, Discord) that are the main reason this page is
    // reached at all. The cost is that Safari proper blocks iframe scheme
    // navigation outright — but someone in Safari WITH the app installed
    // would have been taken by the universal link before ever landing here.
    function tryOpenApp() {
        try {
            var f = document.createElement('iframe');
            f.style.display = 'none';
            f.src = appUrl;
            document.body.appendChild(f);
            setTimeout(function () {
                if (f.parentNode) f.parentNode.removeChild(f);
            }, 1500);
        } catch (e) { /* nothing further to try */ }
    }

    // Name the league in the fallback copy. Fired in PARALLEL with the app
    // handoff below and never awaited before it — a recipient who has the app
    // must not wait on a network round trip to be handed over.
    //
    // validate-join-code is service-role server side and callable with the
    // anon key (verified: 200 + league for a real code, 404 for a bogus one).
    // It returns the WHOLE row; only .name is read here.
    //
    // The id check mirrors league_invite_modal.dart:106 — a link whose
    // leagueId does not match the league the join code actually resolves to is
    // treated as bad rather than silently showing the real league's name.
    (function lookupName() {
        if (!window.supabase) return;
        try {
            var sb = window.supabase.createClient(
                'https://api.playvoli.com',
                'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhjaG9sa3JqcHV6YWhxdW1hamVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDQ0MDcwMzQsImV4cCI6MjA1OTk4MzAzNH0.RVhKzZkLxwwtbow3i3tUSVVnG_hMl-q0bwuvmqNuDq0'
            );
            sb.functions
                .invoke('validate-join-code', { body: { join_code: joinCode } })
                .then(function (res) {
                    var lg = res && res.data && res.data.league;
                    if (!lg || !lg.name) return;
                    if (lg.f_league_id !== leagueId) return;
                    // textContent, never innerHTML — league names are
                    // user-supplied and must not be able to inject markup.
                    document.getElementById('fallback-title').textContent =
                        'Join ' + lg.name;
                    document.getElementById('fallback-sub').textContent =
                        "You've been invited to " + lg.name + ' on VOLI.';
                })
                .catch(function () { /* keep the generic copy */ });
        } catch (e) { /* keep the generic copy */ }
    })();

    var handedOff = false;

    // If the app takes over, the page is backgrounded. Both signals fire on
    // the platforms we care about; either one means stop.
    function markHandedOff() { handedOff = true; }
    document.addEventListener('visibilitychange', function () {
        if (document.hidden) markHandedOff();
    });
    window.addEventListener('pagehide', markHandedOff);
    window.addEventListener('blur', markHandedOff);

    // Try the handoff, then reveal the fallback if we are still here. 1200ms
    // is long enough for the OS sheet to appear and short enough that a
    // recipient without the app is not staring at "Opening…".
    tryOpenApp();

    setTimeout(function () {
        if (!handedOff && !document.hidden) show(fallback);
    }, 1200);

    var APP_STORE  = 'https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982';
    var PLAY_STORE = 'https://play.google.com/store/apps/details?id=com.playvoli.app';

    var ua = navigator.userAgent || '';
    // iPadOS 13+ reports itself as MacIntel, so touch points are what actually
    // separate an iPad from a Mac.
    var isIOS = /iPad|iPhone|iPod/.test(ua) ||
                (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    var isAndroid = /Android/.test(ua);

    // Manual retry: try the app, and if we are still sitting here afterwards
    // send them straight to their store rather than leaving the button looking
    // broken. They asked to open the app; not having it is the only reason
    // this path runs, so the store IS the answer.
    //
    // Only on the explicit click, never on page load — a Safari user who DOES
    // have the app (iframe schemes are blocked there) must not get bounced to
    // the App Store uninvited.
    //
    // preventDefault matters: without it the href would navigate and bring
    // back the very alert this whole approach exists to avoid.
    document.getElementById('retry').addEventListener('click', function (ev) {
        ev.preventDefault();
        var note = document.getElementById('retry-note');
        note.hidden = true;

        // If the tab is already hidden the timer cannot be trusted, so do not
        // arm the redirect at all.
        if (document.hidden) return;

        tryOpenApp();

        setTimeout(function () {
            if (handedOff || document.hidden) return;   // the app took over
            var store = isIOS ? APP_STORE : (isAndroid ? PLAY_STORE : null);
            if (store) {
                window.location.href = store;
            } else {
                // Desktop: no store to send them to that would help.
                note.textContent =
                    'VOLI is a mobile app — open this link on your phone, or scan it from the app store.';
                note.hidden = false;
            }
        }, 1500);
    });
})();
</script>

<style>
    .league-spinner { margin: 0 auto 16px; }
    .league-opening { margin: 0 0 8px; }
    .league-note { margin: 12px 0 0; }
    .v-stub__back { margin-top: 0; text-decoration: none; }
    @media (hover: hover) { .v-stub__back:hover { color: var(--ink-2); } }

    @media (prefers-reduced-motion: reduce) {
        /* the spinner keeps turning on purpose (site.css); only stop tweens */
        .v-pill, .v-store { transition: none; }
    }
</style>
