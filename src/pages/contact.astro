---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Contact - VOLI"
  description="Get in touch with the VOLI team for business inquiries, support, or partnerships."
  activePage="contact"
>
    <main class="v-page">
      <div class="v-wrap v-wrap--form">
      <div class="v-card v-card--plate contact-card">
        <h1 class="v-h1 v-center contact-title">Contact Us</h1>
        <p class="v-lede v-center contact-sub">Get in touch with questions, feedback, or partnership opportunities.</p>

        <div class="success-message v-tile" id="success-message">
            Thanks for reaching out! We'll get back to you soon.
        </div>

        <form class="contact-form" id="contact-form">
            <input type="text" name="name" class="v-input" placeholder="Your Name" required>
            <input type="email" name="email" class="v-input" placeholder="Your Email" required>
            <select name="subject" class="v-input v-select" required>
                <option value="">Select Subject</option>
                <option value="General Inquiry">General Inquiry</option>
                <option value="Business Partnership">Business Partnership</option>
                <option value="Investor Inquiry">Investor Inquiry</option>
                <option value="Press Inquiry">Press Inquiry</option>
                <option value="App Support">App Support</option>
                <option value="Feature Request">Feature Request</option>
            </select>
            <div class="textarea-container">
                <textarea name="message" class="v-textarea" placeholder="Your Message" required maxlength="1000" id="message-textarea"></textarea>
                <div class="character-counter v-path" id="character-counter">0/1000</div>
            </div>
            <button type="submit" class="btn-submit v-pill v-pill--cta v-pill--action v-pill--block">Send Message</button>
        </form>

        <p class="email-text v-path">Or email us at <a class="v-link" href="mailto:support@playvoli.com">support@playvoli.com</a></p>
      </div>
      </div>
    </main>
</SiteLayout>

<script is:inline>
    // Character counter
    var textarea = document.getElementById('message-textarea');
    var counter = document.getElementById('character-counter');
    textarea.addEventListener('input', function() {
        counter.textContent = this.value.length + '/1000';
    });

    // Form submission
    document.getElementById('contact-form').addEventListener('submit', function(e) {
        e.preventDefault();
        document.getElementById('success-message').style.display = 'block';
        this.reset();
        counter.textContent = '0/1000';
        setTimeout(function() {
            document.getElementById('success-message').style.display = 'none';
        }, 5000);
    });
</script>

<style>
    .contact-title { margin: 0 0 12px; }
    .contact-sub { margin: 0 0 24px; }

    .contact-form {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }
    .v-select { cursor: pointer; }
    .v-select:invalid { color: var(--ink-3); }
    .character-counter { text-align: right; margin-top: 4px; padding-right: 4px; }
    .btn-submit { margin-top: 4px; }

    .email-text { text-align: center; margin: 20px 0 0; }

    /* the script toggles inline display:block / none */
    .success-message {
        display: none;
        text-align: center;
        color: var(--lemon-lime);
        font: 500 15px/1.45 var(--font-body);
        margin-bottom: 16px;
    }
</style>
