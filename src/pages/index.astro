---
import Layout from '../layouts/Layout.astro';

const faqs = [
  {
    "q": "What can I do with VOLI?",
    "a": "Play fantasy volleyball with your friends, follow college and pro volleyball live with scores, box scores and play-by-play, and look up any team or player. VOLI also publishes the VOLI Top 100 each Monday, holds the Volleyball Encyclopedia with more than 18,000 honors back to 1979, brings together volleyball news and podcasts, and has match chat and a daily trivia grid. It's free on iPhone and Android."
  },
  {
    "q": "Does VOLI have fantasy volleyball?",
    "a": "Yes. Build a team from real college or pro players and play the season against your friends in a public or private league. Leagues use a salary cap and multi-round contracts, and the NCAA season runs in ten rounds, Wednesday to Sunday. Several volleyball podcasts run their own public leagues on VOLI."
  },
  {
    "q": "Where can I find NCAA volleyball box scores and player stats?",
    "a": "In the VOLI app. It has box scores for 99.8% of completed Division I women's matches since 2023 (nearly 480,000 player lines), including all 189 NCAA Tournament matches of 2023 to 2025. Leaderboards sort by season, conference, position and class. More at playvoli.com/ncaa-volleyball."
  },
  {
    "q": "Does VOLI have live play-by-play for college volleyball?",
    "a": "Yes. Nearly every Division I women's match in the 2026 season has play-by-play in VOLI, with each rally, substitution and rotation: more than 360,000 rallies so far. All 445 MLV and LOVB matches since 2024 have play-by-play too."
  },
  {
    "q": "Does VOLI rank teams or say who's likely to win?",
    "a": "Yes. VOLI rates all Division I teams from match results and strength of schedule, and publishes the VOLI Top 100 each Monday. Before first serve, each upcoming college match in the app shows each team's chance to win and the most likely set score. How it works: playvoli.com/methods."
  },
  {
    "q": "Where can I look up AVCA All-Americans, AVCA poll history or past NCAA champions?",
    "a": "In the Volleyball Encyclopedia, in the VOLI app and at playvoli.com/encyclopedia. It covers 3,000+ AVCA All-America selections since 1981, AVCA Players and Coaches of the Year, the AVCA Coaches Poll since 1982, all 45 NCAA champions, ACC, Big 12, Big Ten and SEC honors, record books and the MLV Draft."
  },
  {
    "q": "Which leagues does VOLI cover, and is it affiliated with them?",
    "a": "NCAA Division I women's volleyball, Major League Volleyball and LOVB, with Athletes Unlimited in the history archive. VOLI is independent and not affiliated with or endorsed by the NCAA, MLV, LOVB, the AVCA or any conference."
  },
  {
    "q": "Is VOLI free?",
    "a": "Yes. VOLI is free on iPhone and Android."
  }
];

// The app entity (featureList, store links) is emitted sitewide by Layout
// under @id https://playvoli.com/#app; this page adds only its FAQ.
const homeSchema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": faqs.map((f) => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }
];
---

<Layout
  title="VOLI: Fantasy Volleyball, Live Scores, Stats & History"
  description="Fantasy volleyball plus live NCAA Division I women's, MLV and LOVB scores, box scores, play-by-play, the VOLI Top 100, history back to 1979, news and podcasts."
  activePage="home"
  ogUrl="https://playvoli.com/"
  schema={homeSchema}
>
    <section class="hero">
        <a href="/mobileapp" id="hero-announcement-dl" class="hero-announcement" aria-label="Announcement: NCAA Women's Fantasy Volleyball is live now — get the app">
