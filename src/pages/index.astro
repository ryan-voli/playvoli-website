---
// The home page: the app, feature by feature, with the way to get it first
// and last. Every number and sentence comes from lib/voli-facts and
// lib/bracket-facts; every phone is a current capture from lib/screens.
// VOLI light system (Pearl).
import Pearl from '../layouts/Pearl.astro';
import Faq from '../components/pearl/Faq.astro';
import FanStrip from '../components/pearl/FanStrip.astro';
import GetApp from '../components/pearl/GetApp.astro';
import Head from '../components/pearl/Head.astro';
import Phone from '../components/pearl/Phone.astro';
import Pop from '../components/pearl/Pop.astro';
import Stores from '../components/pearl/Stores.astro';
import { APP_SCHEMA, DOWNLOADS, FACTS, FACTS_AS_OF, FAQS, NEWS_OUTLETS, PODCASTS, FAN_QUOTES, faqSchema } from '../lib/voli-facts';
import { HOME_MENU, INDEPENDENCE, SITE_URL, sectionMenu } from '../lib/site';
import { SCREENS } from '../lib/screens';

// The questions this page answers in full, and marks up as its FAQ.
const questions = ['what', 'box-scores', 'play-by-play', 'history', 'news', 'free'].map((id) => FAQS.find((f) => f.id === id)!);
const schema = [APP_SCHEMA, faqSchema(questions, `${SITE_URL}/`)];

// A figure's unit (+, %, &) in italic navy; the digits stay ink.
const fig = (v: string) => v.replace(/[+%&]/g, (m) => `<em>${m === '&' ? '&amp;' : m}</em>`);

const LEAGUES = [
  { key: 'ncaa', name: 'NCAA', full: "Women's Division I", href: 'https://www.ncaa.com/sports/volleyball-women' },
  { key: 'mlv', name: 'MLV', full: 'Major League Volleyball', href: 'https://provolleyball.com' },
  { key: 'lovb', name: 'LOVB', full: 'League One Volleyball', href: 'https://lovb.com' },
];
---

<Pearl
  title="VOLI: The Volleyball Hub App for Fantasy, Scores and Stats"
  description="Free volleyball app for NCAA women's volleyball, MLV and LOVB: fantasy leagues, live scores and box scores, stats, the VOLI Top 100, history, news and podcasts."
  section="home"
  subnav={sectionMenu(HOME_MENU, '/')}
  schema={schema}
  promo
>
    <link rel="preload" as="image" href={SCREENS.fantasy.src} type="image/webp" fetchpriority="high" slot="head" />

    {/* The slogan has no search words, so the same h1 names the app as the
        stores do, and says what it is. */}
    <section class="hero" aria-labelledby="hero-h">
        <div class="wrap hero__grid">
            <div class="hero__copy">
                <h1 id="hero-h">
                    <span class="kicker">VOLI: The Volleyball Hub <span aria-hidden="true">·</span> A free volleyball app</span>
                    <span class="display">You asked. We <em>built it.</em></span>
                </h1>
                <p class="lede">Fantasy volleyball, live games, stats, rankings and volleyball history for NCAA <span class="nb">Division I</span> women's volleyball, MLV and LOVB, with volleyball news and podcasts in one feed. Free on iPhone and Android.</p>
                <Stores />
                <p class="hero__proof"><strong>{DOWNLOADS}</strong> downloads <span class="meta" aria-hidden="true">·</span> <span class="dot dot--ncaa"></span>NCAA <span class="dot dot--mlv"></span>MLV <span class="dot dot--lovb"></span>LOVB</p>
            </div>
            <div class="stage" style="--ratio:100/98">
                <Phone screen="games" x={0} y={9} w={36} eager />
                <Phone screen="playerAnalytics" x={64} y={9} w={36} eager />
                <Phone screen="fantasy" x={27} y={0} w={46} z={3} priority />
            </div>
        </div>
    </section>

    <section class="sec sec--tight" id="numbers" aria-labelledby="numbers-h">
        <div class="wrap">
            <div class="head">
                <span class="kicker">As of {FACTS_AS_OF}</span>
                <h2 class="h2" id="numbers-h">What's in <em>VOLI</em></h2>
            </div>
            <ul class="stats stats--plain">
                {FACTS.map((f) => (
                    <li class="stat"><span class="stat__n" set:html={fig(f.value)} /><span class="stat__l">{f.label}</span></li>
                ))}
            </ul>
        </div>
    </section>

    {/* The feature set. Fantasy is first, wherever features are listed. */}
    <section class="sec" id="fantasy" aria-labelledby="fantasy-h">
        <div class="wrap split">
            <div class="copy">
                <span class="kicker">Fantasy</span>
                <h2 class="h2" id="fantasy-h">Fantasy <em>leagues</em></h2>
                <p class="lede">Build a team from real college and pro players and play the season against your friends.</p>
                <p class="body">Leagues use a salary cap and multi-round contracts, for NCAA <span class="nb">Division I</span> women's volleyball and MLV, with LOVB joining in January 2027. The NCAA season runs in ten rounds, Wednesday to Sunday. Join a public league run by a volleyball podcast, or start a private one.</p>
                <div class="minis">
                    <div class="stat"><span class="stat__n">10</span><span class="stat__l">college rounds, Wednesday to Sunday</span></div>
                </div>
                <div class="actions"><a class="btn btn--secondary" href="/fantasy">Fantasy volleyball on VOLI</a></div>
            </div>
            <div class="stage" style="--ratio:100/104">
                <Phone screen="fantasy" x={2} y={0} w={44} />
                <Phone screen="fantasyCard" x={54} y={9} w={44} />
                <Pop cut="card-fantasy" x={18} y={56} w={58} z={3} xm={14} wm={64} />
            </div>
        </div>
    </section>

    <section class="sec" id="live" aria-labelledby="live-h">
        <div class="wrap split split--flip">
            <div class="copy">
                <span class="kicker"><span class="dot dot--live"></span>Live games</span>
                <h2 class="h2" id="live-h">Every match, <em>live</em></h2>
                <p class="lede">Scores and box scores for college and pro matches as they happen, with a lead chart for each set, and play-by-play with the rotation on court for MLV and LOVB matches.</p>
                <p class="body">On iPhone, keep the score on your lock screen with Live Activities.</p>
                <div class="minis">
                    <div class="stat"><span class="stat__n">445</span><span class="stat__l">MLV and LOVB matches with play-by-play</span></div>
                </div>
            </div>
            <div class="stage" style="--ratio:100/104">
                <Phone screen="gameLive" x={2} y={0} w={44} />
                <Phone screen="gameBox" x={54} y={9} w={44} />
                <Pop cut="card-game" x={10} y={70} w={76} z={3} xm={6} wm={84} />
            </div>
        </div>
    </section>

    <section class="sec" id="stats" aria-labelledby="stats-h">
        <div class="wrap split">
            <div class="copy">
                <span class="kicker">Stats</span>
                <h2 class="h2" id="stats-h">Stats and <em>box scores</em></h2>
                <p class="lede">Nearly 500,000 NCAA player box-score lines since 2023, covering 99.8% of completed <span class="nb">Division I</span> matches, and set-by-set player stats for all 445 MLV and LOVB matches.</p>
                <p class="body">Leaderboards sort by season, conference, position and class, in totals or per set.</p>
                <div class="minis">
                    <div class="stat"><span class="stat__n">99.8<em>%</em></span><span class="stat__l">of completed Division I matches</span></div>
                </div>
            </div>
            <div class="stage" style="--ratio:100/104">
                <Phone screen="playerStats" x={2} y={0} w={44} />
                <Phone screen="teamAnalytics" x={54} y={9} w={44} />
                <Pop cut="card-stats" x={12} y={66} w={72} z={3} xm={8} wm={80} />
            </div>
        </div>
    </section>

    <section class="sec" aria-label="Rankings and the Volleyball Encyclopedia">
        <div class="wrap grid2">
            <article class="card card--big copy" id="rankings" aria-labelledby="rankings-h">
                <span class="kicker">Rankings</span>
                <h2 class="h2" id="rankings-h">Rankings and <em>predictions</em></h2>
                <p class="lede">The VOLI Top 100, VOLI's own ranking of <span class="nb">Division I</span> teams from match results and strength of schedule, published each Monday.</p>
                <p class="body">Before first serve, each upcoming college match shows each team's chance to win and the most likely set score, and the chance to win updates after every set. All next to the AVCA Coaches Poll and EVOLLVE's ratings.</p>
                <Pop cut="float-rank" class="card__pop" />
                <div class="actions">
                    <a class="btn btn--secondary" href="/rankings">The VOLI Top 100</a>
                    <a class="go" href="/methods">How it works</a>
                </div>
            </article>
            <article class="card card--big copy" id="encyclopedia" aria-labelledby="encyclopedia-h">
                <span class="kicker">The Volleyball Encyclopedia</span>
                <h2 class="h2" id="encyclopedia-h">Volleyball <em>history</em></h2>
                <p class="lede">More than 18,000 honors back to 1979: 3,000+ AVCA All-America selections since 1981, the AVCA Coaches Poll since 1982, all 45 NCAA champions, ACC, Big 12, Big Ten and SEC honors, record books, the MLV Draft and pro league honors.</p>
                <div class="minis">
                    <div class="stat"><span class="stat__n">18,000<em>+</em></span><span class="stat__l">honors, back to 1979</span></div>
                    <div class="stat"><span class="stat__n">3,000<em>+</em></span><span class="stat__l">AVCA All-America selections since 1981</span></div>
                    <div class="stat"><span class="stat__n">45</span><span class="stat__l">NCAA champions</span></div>
                </div>
            </article>
        </div>
    </section>

    <section class="sec" id="news" aria-labelledby="news-h">
        <div class="wrap split split--top">
            <div class="copy">
                <span class="kicker">News and podcasts</span>
                <h2 class="h2" id="news-h">News and <em>podcasts</em></h2>
                <p class="lede">Volleyball news from 20 outlets, from league, conference and team sites to independent writers: more than 1,800 stories so far, each linked to its source.</p>
                <p class="body">And 13 volleyball podcasts with more than 900 episodes to stream or download, with your place saved across devices.</p>
                <h3 class="h3" style="margin-top:12px">Where the news comes from</h3>
                <ul class="chips">{NEWS_OUTLETS.map((o) => <li>{o}</li>)}</ul>
                <p class="small">Coverage spans NCAA women's volleyball, MLV and LOVB: results, previews, transfers, rankings and awards. Every story opens on its publisher's site.</p>
            </div>
            <div class="card card--big">
                <h3 class="h3" style="margin-bottom:16px">Volleyball podcasts on VOLI</h3>
                <ul class="rows">
                    {PODCASTS.map((p) => (
                        <li>
                            <span class="rows__t">{p.name}{p.partner && <Fragment> <span class="badge badge--navy">Partner</span></Fragment>}</span>
                            <span class="rows__m">{p.by} · {p.episodes} {p.episodes === 1 ? 'episode' : 'episodes'}</span>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
    </section>

    <section class="sec" aria-label="Community and analytics">
        <div class="wrap grid2">
            <article class="card card--big copy" id="community" aria-labelledby="community-h">
                <span class="kicker">Community</span>
                <h2 class="h2" id="community-h">A room for <em>every match</em></h2>
                <p class="lede">A chat room for every match, rooms for NCAA, MLV and LOVB fans, and a private chat for each fantasy league.</p>
                <p class="body">Partner podcasts host AMAs with players and creators right in the app.</p>
                <Pop cut="float-chat" class="card__pop" />
                <ul class="chips" aria-label="Chat rooms in VOLI">
                    <li><span class="dot dot--ncaa"></span> NCAA fan room</li>
                    <li><span class="dot dot--mlv"></span> MLV fan room</li>
                    <li><span class="dot dot--lovb"></span> LOVB fan room</li>
                    <li>AMA sessions with players and creators</li>
                </ul>
            </article>
            <article class="card card--big copy" id="evollve" aria-labelledby="evollve-h">
                <span class="kicker"><span class="dot dot--evollve"></span>Analytics by EVOLLVE</span>
                <h2 class="h2" id="evollve-h">Analytics, <em>built in</em></h2>
                <p class="lede">EVOLLVE's college volleyball analytics are built in: nightly team ratings for every <span class="nb">Division I</span> team, player impact numbers like RAPM, and match predictions.</p>
                <Pop cut="float-pct" class="card__pop" />
                <div class="actions"><a class="btn btn--secondary" href="/evollve">EVOLLVE on VOLI</a></div>
            </article>
        </div>
    </section>

    <section class="sec" id="fans" aria-labelledby="fans-h">
        <div class="wrap">
            <Head title="From the *fans*" kicker="What fans say" id="fans-h" />
        </div>
        <FanStrip quotes={FAN_QUOTES} label="What fans say about VOLI" />
    </section>

    <section class="sec" id="questions" aria-labelledby="questions-h">
        <div class="wrap">
            <Head title="Questions about *VOLI*" kicker="Questions" id="questions-h" />
            <Faq items={questions}>
                <a slot="more" class="go" href="/about#faq">All questions and answers</a>
            </Faq>
        </div>
    </section>

    <section class="sec sec--tight" id="leagues" aria-labelledby="leagues-h">
        <div class="wrap">
            <div class="head"><span class="kicker" id="leagues-h">Leagues we cover</span></div>
            <ul class="grid3 leagues">
                {LEAGUES.map((l) => (
                    <li><a class="card card--flat league" href={l.href} target="_blank" rel="noopener">
                        <span class={`dot dot--${l.key}`}></span><strong class="h3">{l.name}</strong><span class="meta">{l.full}</span>
                    </a></li>
                ))}
            </ul>
            <p class="small" style="margin-top:20px;max-width:44rem">{INDEPENDENCE}</p>
        </div>
    </section>

    <GetApp links={[
      { href: '/fantasy', label: 'Fantasy volleyball' },
      { href: '/rankings', label: 'VOLI Top 100' },
      { href: '/methods', label: "How VOLI's numbers work" },
      { href: '/about#faq', label: 'Questions about VOLI' },
      { href: '/about', label: 'About VOLI' },
    ]} />
</Pearl>

<style>
    .card__pop { width: min(100%, 440px); margin-block: 8px; }
    .leagues .league { display: flex; align-items: center; gap: 12px; color: var(--ink); }
    .leagues .league:hover { text-decoration: none; background: #fff; }
    .leagues .meta { margin-left: auto; font-size: 14px; }
    .chips .dot { margin-right: 4px; vertical-align: 1px; }
    .hero__proof .dot { margin: 0 2px 0 8px; }
</style>
