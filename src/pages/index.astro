---
// The home splash (owner, 6 Oct 2026): no nav, no footer — the lockup, a
// phone with three feature cards popping off it, more pieces of the app
// drifting across the whole screen, and one way in. Everything the old home
// page carried now lives at /app. Every piece is cut from real app
// screenshots. The phone is a real 3D model (Ryan's iphone-17-pro-max.glb,
// Games screen baked in) rendered with three.js; the flat mockup is only the
// no-WebGL fallback.
import SiteLayout from '../layouts/SiteLayout.astro';
import { APP_SCHEMA } from '../lib/voli-facts';

// The splash is one screen and nothing else (owner, 15 Oct 2026: the
// below-the-fold text came back out). Only the app's structured data rides
// along, invisibly; the readable detail lives on /app, /faq and /methods.
const homeSchema = [APP_SCHEMA];
---

<SiteLayout
  title="VOLI - The Volleyball Hub"
  description="Free volleyball app for NCAA women's volleyball, MLV and LOVB: fantasy leagues, live scores and box scores, stats, the VOLI Top 100, history, news and podcasts."
  activePage="home"
  ogUrl="https://playvoli.com/"
  chrome={false}
  schema={homeSchema}
  skipSupabase
  skipNavAuth
>
    <link rel="preload" href="/models/iphone-17-pro-max.glb" as="fetch" type="model/gltf-binary" crossorigin="anonymous" slot="head" />
    <link rel="prefetch" href="/app" slot="head" />
    <main class="splash">
        <div class="drift" aria-hidden="true">
            <div class="drift-item drift--mid  drift--rank"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-rank.webp" alt="" width="760" height="132"></div></div></div>
            <div class="drift-item drift--far  drift--oregon"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-oregon.webp" alt="" width="760" height="337"></div></div></div>
            <div class="drift-item drift--near drift--tile"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-tile.webp" alt="" width="585" height="703"></div></div></div>
            <div class="drift-item drift--far  drift--chat"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-chat.webp" alt="" width="760" height="117"></div></div></div>
            <div class="drift-item drift--near drift--article"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-article.webp" alt="" width="760" height="468"></div></div></div>
            <div class="drift-item drift--far  drift--final"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-final.webp" alt="" width="760" height="397"></div></div></div>
            <div class="drift-item drift--mid  drift--pct"><div class="drift-bob"><div class="drift-face"><img src="/images/splash/float-pct.webp" alt="" width="760" height="392"></div></div></div>
        </div>
        <div class="splash-lockup">
            <img src="/images/splash/logo-mark.webp" alt="" class="splash-logo" width="253" height="240">
            <h1 class="hero-title">
                <span class="hero-title-mark">VOLI</span>
                <span class="hero-title-hub">The Volleyball Hub</span>
            </h1>
            <div class="splash-stores v-stores v-stores--stack">
                <a href="https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982" class="v-store">
                    <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                        <path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09l.01-.01zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/>
                    </svg>
                    <div>
                        <span class="v-store__small">Download on the</span>
                        <span class="v-store__big">App Store</span>
                    </div>
                </a>
                <a href="https://play.google.com/store/apps/details?id=com.playvoli.app" class="v-store">
                    <svg viewBox="0 0 24 24" fill="white" width="22" height="22" aria-hidden="true">
                        <path d="M3.609 1.814L13.792 12 3.61 22.186a.996.996 0 01-.61-.92V2.734a1 1 0 01.609-.92zm10.89 10.893l2.302 2.302-10.937 6.333 8.635-8.635zm3.199-3.198l2.807 1.626a1 1 0 010 1.73l-2.808 1.626L15.206 12l2.492-2.491zM5.864 2.658L16.802 8.99l-2.303 2.303-8.635-8.635z"/>
                    </svg>
                    <div>
                        <span class="v-store__small">Get it on</span>
                        <span class="v-store__big">Google Play</span>
                    </div>
                </a>
            </div>
        </div>
        <div class="pop" aria-hidden="true">
            <div class="pop-scene">
                <canvas class="pop-gl"></canvas>
                <div class="pop-tilt">
                    <img class="pop-phone" src="/images/splash/phone-games.webp" alt="" width="1000" height="2000">
                    <div class="pop-card pop-card--stats"><div class="pop-bob"><img src="/images/splash/card-stats.webp" alt="" width="900" height="399"></div></div>
                    <div class="pop-card pop-card--game"><div class="pop-bob"><img src="/images/splash/card-game.webp" alt="" width="900" height="296"></div></div>
                    <div class="pop-card pop-card--fantasy"><div class="pop-bob"><img src="/images/splash/card-fantasy.webp" alt="" width="900" height="756"></div></div>
                </div>
            </div>
        </div>
        <script is:inline>
            /* Decide before first paint: with WebGL the flat mockup never shows. */
            (function () {
                try {
                    var c = document.createElement('canvas');
                    if (c.getContext('webgl2') || c.getContext('webgl')) document.querySelector('.pop').classList.add('has-gl');
                } catch (e) {}
            })();
        </script>
        <a href="/app" class="splash-go v-pill v-pill--cta">
            Continue to site
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="5" y1="12" x2="19" y2="12"/>
                <polyline points="12 5 19 12 12 19"/>
            </svg>
        </a>
        <a href="/app" class="splash-swipe">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polyline points="6 15 12 9 18 15"/>
            </svg>
            <span>Swipe up to enter site</span>
        </a>
    </main>
</SiteLayout>

<style>
    .splash {
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: calc(32px + env(safe-area-inset-top)) var(--gutter) calc(32px + env(safe-area-inset-bottom));
        text-align: center;
    }

    /* THE LOCKUP (owner, 15 Oct 2026): the VOLI mark, then VOLI stacked over
       THE VOLLEYBALL HUB, then the two store buttons stacked, all in one row.
       On a phone the store buttons drop to their own row underneath. */
    .splash-lockup {
        --hub: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 20px 28px;
        margin-bottom: 0.5rem;
    }

    .splash-logo {
        width: 92px;
        height: auto;
        flex: none;
    }

    /* SAME WIDTH, BOTH LINES (owner, 15 Oct 2026). Measured ink widths at
       100px: VOLI in Designer (0.01em tracking) 262.90, THE VOLLEYBALL HUB in
       Inter 500 (0.2em tracking) 1434.61, so VOLI is 5.457x the descriptor's
       size. Their left side bearings agree to 0.1px, so both edges line up.
       Breakpoints set --hub (on .splash-lockup) only; everything follows. */
    .hero-title {
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: calc(var(--hub) * 1.24);
        margin: 0;
        text-align: left;
    }

    /* EACH LINE'S BOX IS ITS CAPS, cap top to baseline, so the title is
       exactly as tall as the ink and the store buttons can match it.
       text-box trims to the caps wherever it's supported. The fallback
       (Firefox) does it with line-height at the cap height: Designer's
       0.70em box sits 0.074em above its caps on macOS metrics, so the
       glyphs are nudged down by that much; Inter's 0.727 line box already
       lands on its caps. */
    .hero-title-mark {
        font-family: 'Designer', sans-serif;
        font-size: calc(var(--hub) * 5.457);
        line-height: 0.7;
        position: relative;
        top: 0.074em;
        letter-spacing: 0.01em;
        color: #ffffff;
    }

    .hero-title-hub {
        font-size: var(--hub);
        line-height: 0.727;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #ffffff;
        white-space: nowrap;
    }

    @supports (text-box: trim-both cap alphabetic) {
        .hero-title-mark, .hero-title-hub { line-height: 1; top: 0; text-box: trim-both cap alphabetic; }
    }

    /* THE TWO STORE BUTTONS ARE AS TALL AS THE TITLE (owner, 15 Oct 2026).
       Title = VOLI caps (0.70 x 5.457 = 3.82) + gap 1.24 + descriptor caps
       0.7275 = 5.787 x --hub, so with a 0.5 gap each pill is
       (5.787 - 0.5) / 2 = 2.64 x --hub: 42px tall at 16px, 92.6px together.
       A little wider than the stock pill too: 11.5 x --hub = 184px. */
    .splash-stores {
        flex: none;
        width: calc(var(--hub) * 11.5);
        gap: calc(var(--hub) * 0.5);
    }
    .splash-stores .v-store { height: calc(var(--hub) * 2.64); border-radius: 10px; }

    /* THE PHONE STAGE. One tilted 3D plane holds the phone and the cards, so
       the cards hover at real depths above its screen (translateZ) instead of
       being pasted beside it. Every size is in cqw of the stage, so the whole
       composition scales as one object from phone to desktop, and the stage
       shrinks on short screens so the button never falls below the fold. */
    .pop {
        container-type: inline-size;
        width: min(600px, 100%, calc((100svh - 320px) * 8 / 7));
        aspect-ratio: 8 / 7;
        margin-top: 24px;
    }
    .pop-scene { position: relative; width: 100%; height: 100%; perspective: 300cqw; }
    /* The 3D phone's canvas: flat (no CSS transform of its own), centred on the
       stage and 10% taller each way so the tilted phone never clips. The
       script reads .pop-tilt's live transform every frame and turns the phone
       to match, so it and the CSS cards share one tilt and one perspective. */
    .pop-gl {
        position: absolute;
        left: 0;
        top: -10%;
        width: 100%;
        height: 120%;
        opacity: 0;
        pointer-events: none;
    }
    .pop.has-gl .pop-phone { display: none; }
    .pop.is-3d .pop-gl { opacity: 1; animation: gl-in 800ms cubic-bezier(.2, .8, .2, 1) both; }
    @keyframes gl-in {
        from { opacity: 0; transform: translateY(4cqw); }
        to   { opacity: 1; transform: none; }
    }
    .pop-tilt {
        position: relative;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transform:
            rotateX(calc(12deg - var(--py, 0) * 4deg))
            rotateY(calc(-20deg + var(--px, 0) * 6deg))
            rotateZ(5deg);
        transition: transform 900ms cubic-bezier(.2, .8, .2, 1);
    }
    .pop-phone {
        position: absolute;
        left: 50%;
        top: 0;
        height: 100%;
        width: auto;
        transform: translateX(-50%);
        filter: drop-shadow(0 6cqw 8cqw rgba(0, 0, 0, .55));
        animation: phone-in 800ms cubic-bezier(.2, .8, .2, 1) both;
    }
    .pop-card {
        position: absolute;
        left: var(--x);
        top: var(--y);
        width: var(--w);
        transform: translateZ(var(--z));
        animation: card-pop 900ms cubic-bezier(.34, 1.56, .64, 1) var(--d) both;
    }
    .pop-bob {
        border-radius: var(--r);
        overflow: hidden;
        box-shadow: 0 5cqw 9cqw -2cqw rgba(0, 0, 0, .65), 0 0 0 1px rgba(255, 255, 255, .12);
        animation: card-bob 6s ease-in-out var(--b) infinite alternate;
    }
    .pop-bob { position: relative; }
    .pop-bob img { display: block; width: 100%; height: auto; }

    /* GLARE (owner, 6 Oct 2026): every floating piece catches the same soft
       reflection the 3D phone's glass does, a broad diagonal sheen that slides
       across it as the pointer leans the scene. The sheet is twice the card's
       size and travels against the pointer; --g staggers where each card's
       band rests so they don't all flash in step. */
    .pop-bob::after,
    .drift-face::after {
        content: '';
        position: absolute;
        inset: -50%;
        pointer-events: none;
        background:
            linear-gradient(115deg,
                rgba(255, 255, 255, 0) 36%,
                rgba(255, 255, 255, .16) 45%,
                rgba(255, 255, 255, .05) 52%,
                rgba(255, 255, 255, 0) 60%),
            linear-gradient(160deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, 0) 45%);
        transform: translate(calc((var(--g, 0) - var(--px, 0)) * 22%), calc(var(--py, 0) * -12%));
        transition: transform 900ms cubic-bezier(.2, .8, .2, 1);
    }
    .pop-card--stats   { --g: -.4; }
    .pop-card--game    { --g: .3; }
    .pop-card--fantasy { --g: -.1; }
    .drift--rank   { --g: .5; }
    .drift--oregon { --g: -.3; }
    .drift--tile   { --g: .2; }
    .drift--chat    { --g: -.6; }
    .drift--article { --g: .1; }
    .drift--final   { --g: -.5; }
    .drift--pct    { --g: .4; }
    /* Games pops straight out of its own card on the phone's screen; Stats
       off the top-left; Fantasy off the bottom-left. */
    .pop-card--stats   { --x: 3%;  --y: 9%;  --w: 48%; --z: 20cqw; --r: 5.45% / 12.31%; --d: 350ms; --b: 0s; }
    .pop-card--game    { --x: 50%; --y: 31%; --w: 44%; --z: 15cqw; --r: 5.31% / 16.17%; --d: 500ms; --b: -2s; }
    .pop-card--fantasy { --x: 6%;  --y: 57%; --w: 38%; --z: 11cqw; --r: 4.32% / 5.15%;  --d: 650ms; --b: -4s; }

    @keyframes phone-in {
        from { opacity: 0; transform: translateX(-50%) translateY(4cqw); }
        to   { opacity: 1; transform: translateX(-50%); }
    }
    @keyframes card-pop {
        from { opacity: 0; transform: translateZ(0) scale(.9); }
        to   { opacity: 1; transform: translateZ(var(--z)); }
    }
    @keyframes card-bob {
        from { transform: translateY(0); }
        to   { transform: translateY(-1.6cqw); }
    }
    @media (prefers-reduced-motion: reduce) {
        .pop-tilt { transition: none; }
        .pop-phone, .pop-card, .pop-bob, .pop.is-3d .pop-gl { animation: none; }
    }

    .splash-go { margin-top: 24px; }

    /* PHONES SWIPE IN (owner, 15 Oct 2026): on touch screens the button
       gives way to a "Swipe up to enter site" hint. The hint is still a link,
       so a tap (or VoiceOver) gets in too. */
    .splash-swipe {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 2px;
        margin-top: 20px;
        padding: 6px 16px;
        color: var(--ink-2);
        text-decoration: none;
        font: 600 14px/1.2 var(--font-body);
        letter-spacing: .02em;
        -webkit-tap-highlight-color: transparent;
    }
    .splash-swipe svg { width: 22px; height: 22px; animation: swipe-bob 1.6s ease-in-out infinite; }
    @keyframes swipe-bob {
        0%, 100% { transform: translateY(2px); opacity: .6; }
        50% { transform: translateY(-4px); opacity: 1; }
    }
    @media (hover: none) and (pointer: coarse) {
        .splash-go { display: none; }
        .splash-swipe { display: flex; }
        /* The page doesn't scroll, so the swipe never fights it. */
        :global(html), :global(body) { overscroll-behavior-y: none; }
    }
    @media (prefers-reduced-motion: reduce) {
        .splash-swipe svg { animation: none; }
    }


    /* THE DRIFT. More of the app floating across the whole screen, behind the
       lockup / phone / button. Three depths: near is sharp with a strong
       shadow, far is small, soft and dim, and on a mouse each depth slides a
       different distance against the pointer (--k px at full deflection). */
    .splash > :not(.drift) { position: relative; z-index: 1; }
    .drift {
        position: fixed;
        inset: 0;
        overflow: hidden;
        pointer-events: none;
        z-index: 0;
    }
    .drift-item {
        position: absolute;
        left: var(--l, auto);
        right: var(--rt, auto);
        top: var(--t);
        width: calc(var(--w) * var(--ds, 1));
        transform: translate3d(calc(var(--px, 0) * var(--k) * -1px), calc(var(--py, 0) * var(--k) * -1px), 0);
        transition: transform 1200ms cubic-bezier(.2, .8, .2, 1);
        animation: drift-in 1000ms ease-out var(--d) both;
    }
    .drift-bob { animation: drift-bob var(--s) ease-in-out var(--b) infinite alternate; }
    .drift-face {
        position: relative;
        overflow: hidden;
        border-radius: var(--rad, 14px);
        transform: perspective(1400px) rotateX(8deg) rotateY(var(--ry)) rotateZ(var(--rz));
        box-shadow: 0 24px 48px -12px rgba(0, 0, 0, .6), 0 0 0 1px rgba(255, 255, 255, .10);
    }
    .drift-face img { display: block; width: 100%; height: auto; }
    .drift--near { --k: 24; }
    .drift--mid  { --k: 14; }
    .drift--mid  .drift-face { filter: blur(.6px); opacity: .8; }
    .drift--far  { --k: 7; }
    .drift--far  .drift-face { filter: blur(2px); opacity: .5; }
    /* With a cursor, focus follows it (owner, 6 Oct 2026): each piece is sharp
       when the pointer is on or near it and softens as the pointer moves away.
       --f is set per piece by the script below, 1 on it to 0 far off. Touch
       screens never get .is-aware and keep the depth blur above. */
    .drift-face { transition: filter 350ms ease, opacity 350ms ease; }
    .splash.is-aware .drift-face {
        filter: blur(calc((1 - var(--f, 0)) * 3px));
        opacity: calc(.45 + var(--f, 0) * .55);
    }

    /* --rad is each card's own measured corner, as % of the card. */
    .drift--rank    { --l: 4%;  --t: 10%; --w: 290px; --ry: 14deg;  --rz: -4deg; --d: 900ms;  --s: 9s;  --b: 0s;  --rad: 4.41% / 25.46%; }
    .drift--chat    { --l: 9%;  --t: 25%; --w: 250px; --ry: 14deg;  --rz: 2deg;  --d: 1300ms; --s: 10s; --b: -2s; --rad: 4.41% / 28.65%; }
    .drift--oregon  { --l: 2%;  --t: 40%; --w: 310px; --ry: 16deg;  --rz: 3deg;  --d: 1100ms; --s: 11s; --b: -3s; --rad: 5.45% / 12.31%; }
    .drift--tile    { --l: 15%; --t: 66%; --w: 160px; --ry: 12deg;  --rz: -6deg; --d: 1000ms; --s: 8s;  --b: -5s; --rad: 7.52% / 6.26%; }
    .drift--article { --rt: 4%; --t: 9%;  --w: 300px; --ry: -14deg; --rz: 5deg;  --d: 950ms;  --s: 10s; --b: -4s; --rad: 4.33% / 7.03%; }
    .drift--final   { --rt: 2%; --t: 38%; --w: 290px; --ry: -16deg; --rz: -3deg; --d: 1150ms; --s: 9s;  --b: -6s; --rad: 5.45% / 10.43%; }
    .drift--pct     { --rt: 7%; --t: 69%; --w: 300px; --ry: -12deg; --rz: 4deg;  --d: 1050ms; --s: 12s; --b: -1s; --rad: 4.32% / 8.38%; }

    @keyframes drift-in {
        from { opacity: 0; }
        to   { opacity: 1; }
    }
    @keyframes drift-bob {
        from { transform: translateY(0); }
        to   { transform: translateY(-14px); }
    }
    @media (prefers-reduced-motion: reduce) {
        .drift-item { transition: none; animation: none; }
        .pop-bob::after, .drift-face::after { transition: none; }
        .drift-bob { animation: none; }
    }

    /* Narrower desktops: same layout, smaller pieces so they clear the phone. */
    @media (max-width: 1280px) {
        .drift { --ds: .8; }
    }
    /* Tablets and phones: no side room, so four far pieces peek in from the
       corners, above the lockup and below the button. */
    @media (max-width: 1100px) {
        .drift { --ds: 1; }
        .drift--oregon, .drift--tile, .drift--chat { display: none; }
        .drift--rank, .drift--article, .drift--final, .drift--pct { --k: 7; }
        .drift--rank  .drift-face, .drift--article .drift-face,
        .drift--final .drift-face, .drift--pct     .drift-face { filter: blur(1.5px); opacity: .5; }
        .drift--rank    { --l: -60px; --rt: auto; --t: 2.5%; --w: 200px; }
        .drift--article { --l: auto; --rt: -50px; --t: 4%;   --w: 170px; }
        .drift--final   { --l: -40px; --rt: auto; --t: 90%;  --w: 180px; }
        .drift--pct     { --l: auto; --rt: -60px; --t: 92%;  --w: 200px; }
    }

    @media (max-width: 600px) {
        .splash-lockup { gap: 16px 18px; }
        .splash-stores { flex-basis: 100%; width: auto; flex-direction: row; justify-content: center; gap: 10px; }
        .splash-stores .v-store { width: auto; height: 52px; }
        .pop { width: min(100%, calc((100svh - 360px) * 8 / 7)); }
    }

    @media (max-width: 480px) {
        .splash-logo { width: 62px; }
        .splash-lockup { --hub: 0.68rem; }
    }
</style>

<script is:inline>
    /* Swipe up to enter (touch screens only). Only the hint follows the
       finger and the page fades: the splash itself never moves, because a
       transform on it would re-anchor the fixed drift pieces inside it. */
    (function () {
        if (!matchMedia('(hover: none) and (pointer: coarse)').matches) return;
        var splash = document.querySelector('.splash');
        var hint = document.querySelector('.splash-swipe');
        if (!splash || !hint) return;
        var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var startX = 0, startY = null, startT = 0, dy = 0, leaving = false;

        function show(lift) {
            hint.style.transform = lift ? 'translateY(' + lift + 'px)' : '';
            splash.style.opacity = lift ? String(Math.max(0.35, 1 + lift / 320)) : '';
        }
        function settle(ms) {
            hint.style.transition = 'transform ' + ms + 'ms ease';
            splash.style.transition = 'opacity ' + ms + 'ms ease';
        }

        document.addEventListener('touchstart', function (e) {
            if (leaving || e.touches.length !== 1) return;
            startX = e.touches[0].clientX;
            startY = e.touches[0].clientY;
            startT = Date.now();
            dy = 0;
            settle(0);
        }, { passive: true });

        document.addEventListener('touchmove', function (e) {
            if (startY === null) return;
            var dx = e.touches[0].clientX - startX;
            dy = e.touches[0].clientY - startY;
            if (dy < 0 && Math.abs(dy) > Math.abs(dx)) {
                e.preventDefault();
                if (!reduce) show(Math.max(dy * 0.6, -160));
            }
        }, { passive: false });

        document.addEventListener('touchend', function () {
            if (startY === null) return;
            var quick = Date.now() - startT < 300;
            var go = dy < -90 || (quick && dy < -40);
            startY = null;
            if (!go) { settle(220); show(0); return; }
            leaving = true;
            settle(reduce ? 0 : 200);
            if (!reduce) { hint.style.transform = 'translateY(-200px)'; splash.style.opacity = '0'; }
            setTimeout(function () { location.href = '/app'; }, reduce ? 0 : 180);
        });

        // Back from /app restores this page from the cache mid-exit: reset it.
        window.addEventListener('pageshow', function () {
            leaving = false;
            settle(0);
            show(0);
        });
    })();
</script>

<script is:inline>
    /* Mouse and trackpad only. The stage leans a few degrees toward the
       pointer and the drift slides against it by depth (skipped under reduced
       motion); each drifting piece also comes into focus as the pointer nears
       it. The parallax vars sit on the splash so the stage and drift share them. */
    (function () {
        var splash = document.querySelector('.splash');
        if (!splash || !matchMedia('(hover: hover) and (pointer: fine)').matches) return;
        var still = matchMedia('(prefers-reduced-motion: reduce)').matches;
        var items = [].slice.call(document.querySelectorAll('.drift-item'));
        var raf = 0, cx = 0, cy = 0;
        function frame() {
            raf = 0;
            if (!still) {
                splash.style.setProperty('--px', ((cx / innerWidth) * 2 - 1).toFixed(3));
                splash.style.setProperty('--py', ((cy / innerHeight) * 2 - 1).toFixed(3));
            }
            items.forEach(function (el) {
                // Distance from the pointer to the piece's edge: 0 when on it.
                var r = el.getBoundingClientRect();
                var dx = Math.max(r.left - cx, 0, cx - r.right);
                var dy = Math.max(r.top - cy, 0, cy - r.bottom);
                var t = Math.min(Math.max((Math.sqrt(dx * dx + dy * dy) - 40) / 480, 0), 1);
                el.style.setProperty('--f', (1 - t * t * (3 - 2 * t)).toFixed(3));
            });
        }
        addEventListener('pointermove', function (e) {
            cx = e.clientX;
            cy = e.clientY;
            splash.classList.add('is-aware');
            if (!raf) raf = requestAnimationFrame(frame);
        });
        document.documentElement.addEventListener('mouseleave', function () {
            splash.classList.remove('is-aware');
        });
    })();
</script>

<script>
    /* THE 3D PHONE. The CSS stage owns the tilt (base angle + pointer lean);
       this renders the model in exactly that pose. World units are CSS px, the
       camera sits where CSS's perspective puts the viewer (300cqw = 3x the
       stage width), and every frame .pop-tilt's computed matrix is copied onto
       the phone with the y axis flipped (CSS y runs down, three's runs up). */
    import * as THREE from 'three';
    import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
    import { MeshoptDecoder } from 'three/examples/jsm/libs/meshopt_decoder.module.js';
    import { RoomEnvironment } from 'three/examples/jsm/environments/RoomEnvironment.js';

    const pop = document.querySelector('.pop');
    const stage = pop?.querySelector('.pop-scene');
    const tilt = pop?.querySelector('.pop-tilt');
    const canvas = pop?.querySelector('.pop-gl');

    function fallBack() {
        pop?.classList.remove('has-gl', 'is-3d');
    }

    function start() {
        let renderer;
        try {
            renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
        } catch (e) {
            fallBack();
            return;
        }
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.outputColorSpace = THREE.SRGBColorSpace;
        renderer.toneMapping = THREE.ACESFilmicToneMapping;

        const world = new THREE.Scene();
        world.environment = new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(), 0.04).texture;
        const key = new THREE.DirectionalLight(0xffffff, 1.4);
        key.position.set(-1, 1.6, 2);
        world.add(key);

        const camera = new THREE.PerspectiveCamera(20, 1, 1, 100000);
        const phone = new THREE.Group();
        world.add(phone);

        const flipY = new THREE.Matrix4().makeScale(1, -1, 1);
        const pose = new THREE.Matrix4();
        let model = null;
        let modelH = 1;
        let lastTransform = '';
        let dirty = true;

        function size() {
            const w = canvas.clientWidth;
            const h = canvas.clientHeight;
            if (!w || !h) return;
            renderer.setSize(w, h, false);
            const d = 3 * stage.clientWidth;
            camera.aspect = w / h;
            camera.fov = (2 * Math.atan(h / 2 / d) * 180) / Math.PI;
            camera.position.set(0, 0, d);
            camera.near = d / 20;
            camera.far = d * 20;
            camera.updateProjectionMatrix();
            // The phone fills the stage height, as the flat mockup did.
            phone.scale.setScalar((stage.clientHeight * 0.96) / modelH);
            dirty = true;
        }

        function frame() {
            requestAnimationFrame(frame);
            const t = getComputedStyle(tilt).transform;
            if (t !== lastTransform) {
                lastTransform = t;
                pose.fromArray(new DOMMatrix(t === 'none' ? undefined : t).toFloat32Array());
                pose.premultiply(flipY).multiply(flipY);
                phone.quaternion.setFromRotationMatrix(pose);
                dirty = true;
            }
            if (dirty) {
                renderer.render(world, camera);
                dirty = false;
            }
        }

        new GLTFLoader().setMeshoptDecoder(MeshoptDecoder).load(
            '/models/iphone-17-pro-max.glb',
            (gltf) => {
                model = gltf.scene;
                const box = new THREE.Box3().setFromObject(model);
                model.position.sub(box.getCenter(new THREE.Vector3()));
                modelH = box.getSize(new THREE.Vector3()).y;
                // The screen shows the screenshot's own colours, untouched by tone mapping.
                model.traverse((o) => {
                    if (o.isMesh && o.material && o.material.name === 'display_panel') o.material.toneMapped = false;
                });
                phone.add(model);
                size();
                new ResizeObserver(size).observe(stage);
                frame();
                requestAnimationFrame(() => pop.classList.add('is-3d'));
            },
            undefined,
            fallBack,
        );
    }

    if (pop && stage && tilt && canvas && pop.classList.contains('has-gl')) start();
</script>
