</Layout>

<script is:inline>
    /* The hero banner's "Get the app" runs the SAME flow as the nav Download
       pill — App Store on iOS, Play Store on Android, QR modal on desktop —
       rather than sending people to /mobileapp to look for a link.

       It clicks the pill instead of calling handleDownload() directly.
       handleDownload lives in QrModal's inline script, which the Layout
       renders AFTER this page's content, so it is not defined yet at parse
       time; the click happens long after, when both exist. Same indirection
       Nav.astro already uses for the mobile download icon.

       The href stays as a no-JS fallback: if the pill is missing for any
       reason the anchor is left alone and still lands on /mobileapp. */
    (function () {
        var a = document.getElementById('hero-announcement-dl');
        if (!a) return;
        a.addEventListener('click', function (e) {
            var pill = document.getElementById('download-pill');
            if (!pill) return;
            e.preventDefault();
            pill.click();
        });
    })();
</script>

<style>
    /* Hero Section */
    .hero {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 6rem 2rem 4rem;
        padding-top: calc(6rem + env(safe-area-inset-top));
        text-align: center;
    }

    .hero-quotes {
        display: flex;
        gap: 2rem;
        max-width: 1100px;
        margin-top: 3rem;
        padding: 0 1rem;
    }

    .hero-quotes p {
        font-size: 0.8rem;
        font-style: italic;
        color: var(--text-muted);
        line-height: 1.5;
        flex: 1;
    }

    .hero-stars {
        display: flex;
        gap: 0.25rem;
        margin-bottom: 1rem;
    }

    .hero-announcement {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.55rem 1.15rem 0.55rem 0.9rem;
        margin-bottom: 2rem;
        background: linear-gradient(135deg, rgba(200, 255, 0, 0.12), rgba(0, 212, 255, 0.08));
        border: 1px solid rgba(200, 255, 0, 0.35);
        border-radius: 100px;
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        box-shadow: 0 0 24px rgba(200, 255, 0, 0.15);
        animation: heroAnnouncementGlow 3s ease-in-out infinite;
        max-width: 100%;
        text-decoration: none;
        cursor: pointer;
        transition: transform 0.2s ease, border-color 0.2s ease;
    }

    .hero-announcement:hover,
    .hero-announcement:focus-visible {
        transform: translateY(-1px);
        border-color: rgba(200, 255, 0, 0.6);
        outline: none;
    }

    .hero-announcement-cta {
        color: var(--accent);
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: -0.01em;
        white-space: nowrap;
        padding-left: 0.55rem;
        margin-left: 0.15rem;
        border-left: 1px solid rgba(200, 255, 0, 0.25);
        transition: padding-right 0.2s ease;
    }

    .hero-announcement:hover .hero-announcement-cta,
    .hero-announcement:focus-visible .hero-announcement-cta {
        padding-right: 0.15rem;
    }

    .hero-announcement-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--accent);
        box-shadow: 0 0 12px var(--accent);
        animation: heroAnnouncementDot 1.6s ease-in-out infinite;
        flex-shrink: 0;
    }

    .hero-announcement strong {
        color: var(--accent);
        font-size: 0.72rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.12em;
        white-space: nowrap;
    }

    .hero-announcement-text {
        color: var(--text-primary);
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: -0.01em;
    }

    @keyframes heroAnnouncementGlow {
        0%, 100% { box-shadow: 0 0 24px rgba(200, 255, 0, 0.15); }
        50% { box-shadow: 0 0 36px rgba(200, 255, 0, 0.32); }
    }

    @keyframes heroAnnouncementDot {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.55; transform: scale(0.8); }
    }

    .hero-logo {
        width: 100px;
        height: auto;
        border-radius: 22px;
        margin-bottom: 1.5rem;
    }

    /* THE LOCKUP, NOT A SENTENCE. The brand wordmark is
       "VOLI | THE VOLLEYBALL HUB" — two faces separated by a rule, not one
       string with a colon in it. VOLI carries the display face; the descriptor
       is a wide-tracked label in the body face, which is what makes the two
       read as different things rather than as one long headline. */
    /* ALIGNED ON THE BASELINE, NOT THE BOX — and that choice is load-bearing.
       align-items:center centres each item's LINE BOX, and a line box is built
       from the font's ascent and descent. Designer's are 752/-200 against a
       700 cap on a 1000 em, so its caps sit well above its box centre and the
       wordmark rode high against the rule and the descriptor.

       Correcting that with a translateY tuned to ascent/descent would have
       been right on macOS and wrong on Windows: Designer does not set
       USE_TYPO_METRICS, so Windows lays it out on usWin (1026/273) instead of
       hhea (752/-200) — a ~0.1em disagreement.

       Baseline alignment depends on NONE of that. Both items sit on their
       shared baseline, and the only numbers used below are CAP HEIGHTS, which
       every platform agrees on. */
    .hero-title {
        display: flex;
        align-items: baseline;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0 1.15rem;
        margin-bottom: 0.5rem;
        line-height: 1;
    }

    .hero-title-mark {
        font-family: 'Designer', sans-serif;
        font-size: 4.25rem;
        line-height: 1;
        letter-spacing: 0.01em;
        color: #ffffff;
    }

    /* PROPORTIONS ARE FROM THE BRAND LOCKUP, not eyeballed. The Claude
       Design "VOLI Brand" template sets the header at VOLI 52px / rule
       1x34px at 18% white / descriptor 19px at 0.2em and 50% white — so
       the wordmark is 2.74x the descriptor and the rule is 0.65x the
       wordmark. Those ratios are kept here at hero scale. */
    /* A flex item with no text baseline aligns its BOTTOM edge to the shared
       baseline, so a rule of exactly Designer's cap height (0.70em) spans
       baseline to cap-top and needs no offset of its own. */
    .hero-title-rule {
        width: 1px;
        height: 2.975rem;  /* 0.70 x 4.25rem = Designer's cap height */
        background: rgba(255, 255, 255, 0.35);
        flex: none;
    }

    /* Lift the descriptor so its cap band centres on the wordmark's:
       -(0.70 x 2.74 - 0.72754) / 2 = -0.5952em, where 0.72754 is Inter's cap
       height and 2.74 the brand size ratio. Because that ratio is fixed, the
       figure is CONSTANT — it holds at every breakpoint without retuning. */
    .hero-title-hub {
        font-size: 1.55rem; /* 4.25rem / 2.74 */
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.2em;
        color: #ffffff;
        white-space: nowrap;
        transform: translateY(-0.5952em);
        /* letter-spacing also pads the LAST glyph, which shifts a centred
           label right by half a space. Pull it back so the lockup is
           optically centred rather than metrically. */
        margin-right: -0.2em;
    }

    .hero-tagline {
        font-size: 1.5rem;
        font-weight: 400;
        color: var(--text-secondary);
        margin-bottom: 1rem;
    }

    .hero-description {
        font-size: 1.1rem;
        color: var(--text-muted);
        max-width: 500px;
        line-height: 1.6;
        margin-bottom: 3rem;
    }

    /* Store buttons */
    .store-buttons {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
        width: 100%;
        max-width: 600px;
    }

    .btn-store {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        padding: 1rem 1.5rem;
        background: var(--bg-card);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--glass-border);
        border-radius: 14px;
        text-decoration: none;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .btn-store:hover {
        background: rgba(255, 255, 255, 0.06);
        border-color: rgba(255, 255, 255, 0.15);
        transform: translateY(-2px);
    }

    .btn-store svg {
