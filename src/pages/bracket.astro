---
// The College Volleyball Bracket Challenge. ONE address does three jobs:
//
// 1. The app's link. iOS (apple-app-site-association) and Android (the
//    manifest's app link) both claim exactly /bracket, so a tap on this
//    address from another app opens VOLI's Bracket tab. Nothing on this page
//    is part of that: keep the address, and the link keeps working.
// 2. The fallback for anyone who lands here without the app, or from a link
//    on this site: the voli://bracket button, the install dialog and the store
//    buttons. A friend-group invite arrives as /bracket?g=CODE (app 1.4.8);
//    the page carries the code into the voli:// link and shows it.
// 3. The page search engines read: the game in full, with every fact from
//    lib/bracket-facts.
//
// The game's name is the College Volleyball Bracket Challenge; "NCAA" only
// describes the tournament. See lib/bracket-facts for the naming rules.
//
// The hero is written by hand (Pearl's hero classes) because
// its headline is swapped by script: by BracketClock once picks lock, and by
// the invite script below for a friend-group link.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/bracket.css';
import Band from '../components/pearl/kit/Band.astro';
import Btn from '../components/pearl/kit/Btn.astro';
import Cell from '../components/pearl/kit/Cell.astro';
import Cols from '../components/pearl/kit/Cols.astro';
import Copy from '../components/pearl/kit/Copy.astro';
import DataTable from '../components/pearl/kit/DataTable.astro';
import Dates from '../components/pearl/kit/Dates.astro';
import Faq from '../components/pearl/kit/Faq.astro';
import GetApp from '../components/pearl/kit/GetApp.astro';
import Mark from '../components/pearl/kit/Mark.astro';
import Note from '../components/pearl/kit/Note.astro';
import Phones from '../components/pearl/kit/Phones.astro';
import Split from '../components/pearl/kit/Split.astro';
import Stack from '../components/pearl/kit/Stack.astro';
import Steps from '../components/pearl/kit/Steps.astro';
import Sticker from '../components/pearl/kit/Sticker.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import Tickets from '../components/pearl/kit/Tickets.astro';
import { faqSchema } from '../lib/voli-facts';
import {
  BRACKET, BRACKET_DATES, BRACKET_FAQS, BRACKET_ROUNDS, BRACKET_STATUS, BRACKET_STEPS, bracketPhase, promoIsLive,
} from '../lib/bracket-facts';
import { INDEPENDENCE, sectionMenu, type SectionMenu } from '../lib/site';

// What search results and link previews say follows the calendar on each
// build: once picks lock nobody can enter, so the title stops offering the
// prize. (BracketClock keeps the on-page lines right between builds.)
const phase = bracketPhase();
const live = promoIsLive(phase);
const title = live
  ? 'College Volleyball Bracket Challenge 2026: Win $500 Cash | VOLI'
  : 'College Volleyball Bracket Challenge 2026 | VOLI';
const description = live
  ? "Pick the 2026 NCAA Division I women's volleyball tournament in VOLI's free bracket game. $500 cash to the top eligible bracket. Opens Nov. 29, locks Dec. 3."
  : phase === 'locked'
    ? "The 2026 College Volleyball Bracket Challenge is under way in the VOLI app. Brackets are locked, and every pick for the NCAA Division I women's volleyball tournament is scored live."
    : "The 2026 College Volleyball Bracket Challenge, VOLI's free bracket game for the NCAA Division I women's volleyball tournament, is complete.";
const ogImage = 'https://playvoli.com/images/bracket/bracket-challenge-2026-og.png';
// The headline once picks lock. Before that it rides in an attribute, not in
// the page text, and BracketClock swaps it in on the day.
const afterHeadline = `Picks are in for ${BRACKET.season}. Follow the leaderboard in the VOLI app.`;

const totalMatches = BRACKET_ROUNDS.reduce((n, r) => n + r.matches, 0);

// The offer: one display line, its last word in italic navy.
const pick = `Pick all ${BRACKET.matches}`;

// The lime bar. /bracket/rules prints the same menu (its sections point back here).
const MENU: SectionMenu = {
  label: 'Bracket Challenge',
  base: BRACKET.path,
  sections: [
    { id: 'how-it-works', label: 'How to play', short: 'Play' },
    { id: 'groups', label: 'Friends' },
    { id: 'scoring', label: 'Scoring' },
    { id: 'dates', label: 'Dates' },
    { id: 'prize', label: 'Prize' },
    { id: 'faq', label: 'FAQ' },
  ],
  pages: [{ href: BRACKET.rulesPath, label: 'Official Rules', short: 'Rules' }],
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${BRACKET.url}#webpage`,
    url: BRACKET.url,
    name: 'College Volleyball Bracket Challenge 2026',
    description,
    inLanguage: 'en-US',
    isPartOf: { '@id': 'https://playvoli.com/#website' },
    publisher: { '@id': 'https://playvoli.com/#organization' },
    about: { '@type': 'Thing', name: "2026 NCAA Division I women's volleyball tournament" },
    mentions: { '@id': 'https://playvoli.com/#app' },
    primaryImageOfPage: { '@type': 'ImageObject', url: ogImage, width: 1200, height: 630 },
    breadcrumb: { '@id': `${BRACKET.url}#breadcrumb` },
    dateModified: new Date().toISOString().slice(0, 10),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${BRACKET.url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VOLI', item: 'https://playvoli.com/' },
      { '@type': 'ListItem', position: 2, name: 'College Volleyball Bracket Challenge', item: BRACKET.url },
    ],
  },
  faqSchema(BRACKET_FAQS, BRACKET.url),
];

const FINE = 'No purchase necessary. 50 U.S. states & D.C., 18+ (19+ AL/NE, 21+ MS).';
---

<Pearl
  title={title}
  description={description}
  ogImage={ogImage}
  section="bracket"
  subnav={sectionMenu(MENU, Astro.url.pathname)}
  schema={schema}
>
    <link rel="preload" as="image" href="/images/bracket/bracket-challenge-2026-logo.webp" type="image/webp" fetchpriority="high" slot="head" />

    <section class="hero khero bk-hero" aria-labelledby="bk-h">
        <div class="wrap hero__grid bk-grid">
            <div class="hero__copy">
                <h1 id="bk-h">
                    <span class="kicker"><span>College Volleyball</span> <span>Bracket Challenge {BRACKET.season}</span></span>
                    {' '}
                    {/* The offer, in one element. Until picks lock the after-lock
                        line rides in the attribute; on the day BracketClock swaps
                        it in and drops the attribute. */}
                    <span class="bk-head" id="bracket-heading" data-bracket-after={live ? afterHeadline : undefined}>{live ? (
                        <Fragment>
                            <span class="display">{pick} <em>matches.</em></span>
                            {' '}
                            <span class="hero__sub">The top eligible bracket wins <span class="hl">{BRACKET.prize} cash</span></span>
                        </Fragment>
                    ) : afterHeadline}</span>
                </h1>
                {/* The invitation, for a /bracket?g=CODE link. Not page text: the script copies it into the headline. */}
                <template id="bk-invite"><span class="display bk-inv">You're <em>invited</em></span> <span class="hero__sub bk-inv-sub">to a Bracket Challenge <span class="hl">group</span></span></template>

                {/* A friend-group invite (?g=CODE): shown by the script, never by default. */}
                <div class="bk-group" id="group-code" hidden>
                    <span class="bk-group__label">Group code</span>
                    <span class="bk-group__value" id="group-code-value"></span>
                    <span class="bk-group__hint">If VOLI doesn't open on its own, enter this under Bracket &rarr; Group in the app.</span>
                </div>

                <p class="lede">A free bracket game for the {BRACKET.season} NCAA <span class="nb">Division I</span> women's volleyball tournament. Fill out your bracket in the VOLI app, then follow every pick on a live leaderboard.</p>

                <Note class="bk-status"><span data-bracket-status="long">{BRACKET_STATUS[phase].long}</span></Note>

                <div class="bk-actions">
                    {/* A phone opens the app. A computer has no app to open: its button goes to the QR code. */}
                    <Btn href="voli://bracket" id="open-bracket-btn" class="bk-open" variant="primary" size="lg">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v16h-6M3 12h12M10 7l5 5-5 5"/></svg>
                        Open the Bracket Challenge
                    </Btn>
                    <Btn href="#get" id="bk-get" class="bk-get" variant="primary" size="lg">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v10M7 10.5l5 5 5-5M5 20h14"/></svg>
                        Get the app to play
                    </Btn>
                    <Stores class="store-buttons" />
                </div>

                <p class="fine">{FINE} <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
            </div>

            <div class="hero__art bk-art">
                {/* The bracket artwork is made for dark grounds: it rides on an ink panel. */}
                <div class="bk-logo">
                    <img src="/images/bracket/bracket-challenge-2026-logo.webp" width="840" height="486" fetchpriority="high"
                         alt="College Volleyball '26 Bracket Challenge, presented by VOLI">
                </div>
                <Tickets label="The Bracket Challenge at a glance" items={[
                  { value: BRACKET.prize, label: 'cash to the top eligible bracket' },
                  { value: 'Free', label: 'to enter, with no purchase necessary' },
                  { value: String(BRACKET.matches), label: 'matches to pick, plus a tiebreaker' },
                  { value: BRACKET_DATES[0].when.replace(/^\w+, /, ''), label: 'brackets open once the field is set' },
                ]} />
            </div>
        </div>
    </section>

    <Band color="lime" id="how-it-works" kicker="How the Bracket" title={['Challenge', 'works']}>
        <Steps items={BRACKET_STEPS} />
    </Band>

    <Band color="blue" id="groups" kicker="Play against" title={['your', 'friends']}>
        <Cols ratio="56:30" gap={6}>
            <Copy>
                <p class="lede">Before picks lock, create a group in the app and share its invite link, and your group gets its own leaderboard. Everyone still plays one bracket, which counts in every group they join and on the main leaderboard. The app also lists open groups that anyone can join without a code. Groups have no prize of their own: the {BRACKET.prize} goes to the top eligible bracket overall.</p>
            </Copy>
            <div class="bk-mark"><Mark on="blue" /></div>
        </Cols>
    </Band>

    <Split ground="rose">
        <Cell color="ink" id="scoring" kicker="How a bracket is" title="scored" tone="lime" cap={11}>
            <p class="body">Every correct pick earns points, and a correct pick is worth more in each later round. Every round adds up to 32 points, so a perfect bracket scores {BRACKET.maxPoints}.</p>
            <DataTable
              class="bk-score"
              caption="Points for each round of the bracket"
              cols={['Round', 'Matches', { label: 'Points per correct pick', class: 'fig' }]}
              rows={BRACKET_ROUNDS.map((r) => [r.round, r.matches, r.points])}
              foot={['Whole bracket', totalMatches, { text: `${BRACKET.maxPoints} points at most`, class: 'pop' }]}
            />
            <p class="body"><strong>Tiebreaker:</strong> with your bracket you predict the total points scored by both teams across all sets of the championship match. The closest prediction ranks higher. No tie is broken by chance.</p>
        </Cell>
        <Cell color="rose" id="dates" title="Key dates" note={`for brackets and the ${BRACKET.season} NCAA volleyball tournament`} wide>
            <Dates items={BRACKET_DATES} />
        </Cell>
    </Split>

    <Band color="lime" id="prize" lines={[{ text: 'The', size: 'sm', hollow: true }, { text: [BRACKET.prize, 'cash prize'], fit: true }]}>
        <Cols ratio="60:30" gap={5}>
            <div class="bk-prize">
                <p class="lede">One prize of {BRACKET.prize} in cash goes to the eligible entrant whose complete bracket finishes highest. VOLI funds the prize itself, and no part of it comes from entrants.</p>
                <ul class="bk-terms">
                    <li><strong>Who can win:</strong> legal residents of the 50 United States and the District of Columbia who are at least 18 and have reached the age of majority where they live (19 in Alabama and Nebraska, 21 in Mississippi).</li>
                    <li><strong>How to be eligible:</strong> before brackets lock, do both. Sign up for the prize in the app with your birthdate and state, and save a complete bracket, all {BRACKET.matches} picks and the tiebreaker. The birthdate and state must match your government-issued photo ID. Your birthdate is used only to confirm eligibility and is deleted on February 1, 2027.</li>
                    <li><strong>Who cannot win:</strong> current NCAA student-athletes; staff of any NCAA school's athletics department, and staff with responsibilities within or over one; staff of any athletic conference office; VOLI's owners, officers, employees and contractors and their immediate family and household members; and anyone paid to promote the contest.</li>
                    <li><strong>The winner:</strong> is notified by email and in the app within 7 days after the championship match, and has 7 days to reply with a government-issued photo ID and a signed declaration of eligibility and liability release. If they do not, the prize passes to the next eligible bracket. Payment is by ACH bank transfer, mailed check or Venmo within 30 days of verification, and goes only to the email address on the winning VOLI account. Venmo is not available for accounts that use Apple's Hide My Email.</li>
                </ul>
                <p class="body bk-prize__rules">Everything is in the <a href={BRACKET.rulesPath} class="link">Official Rules</a>.</p>
            </div>
            {/* The app's Bracket tab, next to the page's own wording of the prize and its small print. */}
            <div class="bk-prize__art">
                <Phones screens={['bracket']} badge={{ value: BRACKET.prize, label: 'cash to the top eligible bracket' }} />
                <p class="fine">{FINE} <a href={BRACKET.rulesPath}>Official Rules</a> apply.</p>
            </div>
        </Cols>
    </Band>

    <Band color="ink" id="faq" kicker="Bracket Challenge" title="questions" tone="lime">
        <Faq items={BRACKET_FAQS} />
    </Band>

    <Band color="blue" id="voli" title={['More', 'volleyball']} sub="in VOLI" em="volleyball">
        <Cols ratio="1:1" gap={6}>
            <Copy>
                <p class="lede">VOLI is a free volleyball app for NCAA <span class="nb">Division I</span> women's volleyball, MLV and LOVB, with fantasy leagues, live scores and box scores, stats, history, news and podcasts. <a href="/" class="link">See everything in the app</a>.</p>
                <p class="small">{INDEPENDENCE}</p>
            </Copy>
            <Copy>
                <p class="lede">Doing your homework before you pick? The <a href="/rankings" class="link">VOLI Top 100</a> ranks <span class="nb">Division I</span> teams from match results and strength of schedule each Monday, and every college match in the app shows each team's chance to win before first serve. <a href="/methods" class="link">How VOLI's numbers work</a>.</p>
                <Stack ratio="100/58" class="bk-fig">
                    <Sticker cut="card-game" x={0} y={6} w={90} r={-3.75} shadow="lime" />
                    <Sticker cut="float-rank" x={14} y={68} w={84} r={3.75} shadow="rose" z={2} />
                </Stack>
            </Copy>
        </Cols>
    </Band>

    <Band color="ink" label="Contest terms" class="bk-terms-band">
        <Cols max="62rem">
            <p class="bk-legal">NO PURCHASE NECESSARY TO ENTER OR WIN. A purchase will not improve your chances of winning. Open only to legal residents of the 50 United States and the District of Columbia who are at least 18 years old and have reached the age of majority in their state of residence. Void in Puerto Rico, all other U.S. territories and possessions, and where prohibited. Brackets lock at the scheduled start of the tournament's first match. One prize: {BRACKET.prize} cash. Subject to the <a href={BRACKET.rulesPath}>Official Rules</a>. Sponsor: VOLI LLC, 200 S 21st St STE 400A, Lincoln, NE 68510. This contest is not sponsored, endorsed or administered by, or associated with, Apple Inc. or Google LLC, and is not affiliated with, sponsored or endorsed by the NCAA.</p>
        </Cols>
    </Band>

    <GetApp
      lines={['Play it', { text: 'in the app', hollow: true }]}
      lede="Fill out your bracket in the free VOLI app, on iPhone and Android."
      links={[
        { href: BRACKET.rulesPath, label: 'Official Rules' },
        { href: '/rankings', label: 'VOLI Top 100' },
        { href: '/methods', label: "How VOLI's numbers work" },
        { href: '/fantasy', label: 'Fantasy volleyball' },
        { href: '/', label: 'Everything in VOLI' },
      ]}
    />

    <script is:inline slot="scripts">
        // The layout's gtag('config') already counts the page view. Nothing
        // here sends a parameter named "source": this is the page search
        // visitors land on, and their traffic source has to stay theirs.
        function bkTrack(category, label) {
            try { gtag('event', 'click', { 'event_category': category, 'event_label': label, 'lander': 'bracket' }); } catch (e) {}
        }

        // A friend-group invite (app 1.4.8, 15 Nov 2026): /bracket?g=CODE.
        // The app opens straight to the join sheet from the universal link;
        // this page is the fallback, so it carries the code into the
        // voli:// link and shows it for anyone who has to install first.
        var groupCode = (function () {
            var raw = new URLSearchParams(window.location.search).get('g') || '';
            raw = raw.toUpperCase().replace(/[^A-Z0-9]/g, '');
            return raw.length >= 4 && raw.length <= 10 ? raw : '';
        })();
        var bracketDeepLink = groupCode ? 'voli://bracket?g=' + groupCode : 'voli://bracket';

        (function () {
            if (!groupCode) return;
            var btn = document.getElementById('open-bracket-btn');
            if (btn) btn.setAttribute('href', bracketDeepLink);
            var block = document.getElementById('group-code');
            var code = document.getElementById('group-code-value');
            if (block && code) {
                code.textContent = groupCode;
                block.hidden = false;
            }
            // Once picks lock a friend group can no longer be joined, so the
            // headline stays as it is; the code still shows and still rides in
            // the link, because an open group can be joined at any time.
            var phase = document.documentElement.getAttribute('data-bracket-phase');
            var heading = document.getElementById('bracket-heading');
            var invite = document.getElementById('bk-invite');
            if (heading && invite && phase !== 'locked' && phase !== 'over') {
                heading.innerHTML = invite.innerHTML;
            }
            try { gtag('event', 'bracket_group_invite', { 'lander': 'bracket' }); } catch (e) {}
        })();

        // Smart deep link handler with a dialog as the fallback
        function handleDeepLink(event, deepLink) {
            event.preventDefault();
            window.location.href = deepLink;

            setTimeout(function () {
                if (!document.hidden) {
                    showAppDownloadPopup();
                }
            }, 2000);
        }

        function showAppDownloadPopup() {
            if (document.querySelector('.bk-popup-overlay')) return;
            var opener = document.activeElement;
            var overlay = document.createElement('div');
            overlay.className = 'dlg bk-popup-overlay';

            var popup = document.createElement('div');
            popup.className = 'dlg__box bk-popup';
            popup.setAttribute('role', 'dialog');
            popup.setAttribute('aria-modal', 'true');
            popup.setAttribute('aria-labelledby', 'bk-popup-title');
            popup.setAttribute('aria-describedby', 'bk-popup-text');
            popup.innerHTML = '\
                <h2 id="bk-popup-title">Get VOLI to play</h2>\
                <p id="bk-popup-text">The Bracket Challenge is played in the free VOLI app. Get it from the App Store or Google Play to fill out your bracket.' +
                (groupCode ? ' Then join your friends with group code <strong>' + groupCode + '</strong>.' : '') + '</p>\
                <button type="button" id="close-popup" class="btn">Got it</button>\
            ';

            overlay.appendChild(popup);
            document.body.appendChild(overlay);

            var closeBtn = document.getElementById('close-popup');
            function close() {
                document.removeEventListener('keydown', onKey);
                if (overlay.parentNode) overlay.parentNode.removeChild(overlay);
                if (opener && opener.focus) opener.focus();
            }
            // Escape closes it; Tab stays on its one control.
            function onKey(e) {
                if (e.key === 'Escape') close();
                else if (e.key === 'Tab') { e.preventDefault(); if (closeBtn) closeBtn.focus(); }
            }
            overlay.addEventListener('click', function (e) {
                if (e.target === overlay || e.target.id === 'close-popup') close();
            });
            document.addEventListener('keydown', onKey);
            if (closeBtn) closeBtn.focus();

            setTimeout(function () {
                var storeButtons = document.querySelector('.store-buttons');
                if (storeButtons) {
                    var still = window.matchMedia && matchMedia('(prefers-reduced-motion: reduce)').matches;
                    storeButtons.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'center' });
                }
            }, 300);
        }

        (function () {
            var open = document.getElementById('open-bracket-btn');
            if (open) open.addEventListener('click', function (event) { handleDeepLink(event, bracketDeepLink); bkTrack('bracket_open', 'bracket_invite'); });
            // A computer has no app to open: the same place sends it to the QR code.
            var get = document.getElementById('bk-get');
            if (get) get.addEventListener('click', function () { bkTrack('download', 'qr'); });
            // The page's other counted clicks (the store buttons) carry the
            // lander too, as they always have here: counted once, by bkTrack.
            document.querySelectorAll('#main [data-track]').forEach(function (el) {
                var t = el.getAttribute('data-track').split(':');
                el.removeAttribute('data-track');
                el.addEventListener('click', function () { bkTrack(t[0], t.slice(1).join(':')); });
            });
        })();
    </script>
</Pearl>
