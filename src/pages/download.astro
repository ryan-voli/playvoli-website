---
// /download — one link that sends every phone to the right store.
//
// Built for links posted OFF the site (Instagram stories, bios, DMs),
// where the visitor arrives inside an in-app browser rather than
// Safari or Chrome.
//
// Rendered on demand rather than prerendered, so the store choice is
// made SERVER-SIDE from the User-Agent header. That matters: in-app
// browsers are the least predictable JS environments there are, and a
// server redirect works before a single script runs. The site is
// output:'static', so this one route opts out.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/download.css';
import GetApp from '../components/pearl/kit/GetApp.astro';
import PageHero from '../components/pearl/kit/PageHero.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import WhatIsVoli from '../components/pearl/kit/WhatIsVoli.astro';
import { qrPath } from '../lib/qr';

export const prerender = false;

const APP_STORE = 'https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982';
const PLAY_STORE = 'https://play.google.com/store/apps/details?id=com.playvoli.app';

const ua = Astro.request.headers.get('user-agent') ?? '';

// iPadOS 13+ reports a desktop Safari UA, so the plain iPad test misses
// modern iPads — they identify as Macintosh WITH touch support.
const isIOS = /iPad|iPhone|iPod/i.test(ua) ||
  (/Macintosh/i.test(ua) && /Mobile|Touch/i.test(ua));
const isAndroid = /android/i.test(ua);

if (isIOS || isAndroid) {
  // 302, not 301: a permanent redirect would be cached by the browser
  // per-URL and could strand a device on the wrong store forever.
  return Astro.redirect(isIOS ? APP_STORE : PLAY_STORE, 302);
}

// Anything else (desktop, bots, unknown) gets a real page with both
// stores and a QR — never a guess.
Astro.response.headers.set('Cache-Control', 'private, no-store');
Astro.response.headers.set('Vary', 'User-Agent');

// The code to scan, drawn here as plain SVG: no outside service. It opens
// this same address, which a phone turns into its own store.
const qr = qrPath('https://playvoli.com/download');

const subnav = {
  label: 'Download VOLI',
  items: [
    { href: '#get', label: 'Get the app' },
    { href: '/', label: 'What is VOLI' },
  ],
};
---

<Pearl
  title="Download VOLI: The Volleyball Hub for iPhone and Android"
  description="Get VOLI: The Volleyball Hub, free on iPhone and Android: fantasy volleyball leagues, live scores, stats, news and podcasts. Scan the code or pick your store."
  subnav={subnav}
  noindex
>
    <Fragment slot="head">
        <!-- Belt and braces: if this page is ever served from a cache to a
             phone, the script still routes it. The server redirect above is
             the primary path. -->
        <script is:inline>
          (function () {
            var ua = navigator.userAgent || navigator.vendor || window.opera || '';
            var ios = /iPad|iPhone|iPod/i.test(ua) ||
              (/Macintosh/i.test(ua) && 'ontouchend' in document);
            if (ios && !window.MSStream) {
              window.location.replace('https://apps.apple.com/us/app/voli-the-volleyball-hub/id6749812982');
            } else if (/android/i.test(ua)) {
              window.location.replace('https://play.google.com/store/apps/details?id=com.playvoli.app');
            }
          })();
        </script>
    </Fragment>

    <PageHero color="lime" label={['VOLI: The Volleyball Hub.', 'Free on iPhone and Android.']} lines={[{ text: 'Download', hollow: true }, 'VOLI']} fit="same" em="Download">
        <p class="lede">Scan the code with your phone's camera, or pick your store below. VOLI is free on iPhone and Android.</p>
        <Stores />
        <p class="body">Fantasy volleyball, live scores and stats for NCAA <span class="nb">Division I</span> women's volleyball, MLV and LOVB, with volleyball news and podcasts. <a class="link" href="/">See everything in VOLI</a> or read <a class="link" href="/about#faq">questions about VOLI</a>.</p>
        <figure slot="art" class="dl-scan">
            <svg viewBox={`0 0 ${qr.size} ${qr.size}`} width="320" height="320" role="img" aria-label="QR code that opens playvoli.com/download" shape-rendering="crispEdges">
                <rect width={qr.size} height={qr.size} fill="#fff" />
                <path d={qr.d} fill="#12141C" />
            </svg>
            <figcaption>
                <span class="dl-scan__t"><span class="ticks" aria-hidden="true"></span>Scan to get VOLI</span>
                <span class="dl-scan__s">Your phone opens its own store.</span>
            </figcaption>
        </figure>
    </PageHero>

    <WhatIsVoli />

    <GetApp color="blue" links={[
      { href: '/', label: 'Everything in VOLI' },
      { href: '/fantasy', label: 'Fantasy volleyball' },
      { href: '/rankings', label: 'VOLI Top 100' },
      { href: '/about#faq', label: 'Questions about VOLI' },
    ]} />
</Pearl>
