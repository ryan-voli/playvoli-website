---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Terms of Use - VOLI"
  description="VOLI's Terms of Use - Rules and guidelines for using our platform."
>
    <main class="v-page">
        <div class="v-wrap v-wrap--read">
            <header class="legal-head">
                <h1 class="v-h1">Terms of Use</h1>
                <p class="v-path" id="terms-effective-date">Effective Date: Loading...</p>
                <p class="v-path" id="terms-last-updated">Last Updated: Loading...</p>
            </header>

            <div class="v-card v-card--plate legal-content" id="terms-content">
                <p>Loading terms of use...</p>
            </div>
        </div>
    </main>

    <script is:inline slot="scripts">
        var SUPABASE_URL = 'https://api.playvoli.com';
        var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhjaG9sa3JqcHV6YWhxdW1hamVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDQ0MDcwMzQsImV4cCI6MjA1OTk4MzAzNH0.RVhKzZkLxwwtbow3i3tUSVVnG_hMl-q0bwuvmqNuDq0';

        (async function() {
            var container = document.getElementById('terms-content');
            if (!container) return;

            try {
                var response = await fetch(SUPABASE_URL + '/rest/v1/global_settings?select=terms_of_use&limit=1', {
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': 'Bearer ' + SUPABASE_ANON_KEY
                    }
                });

                if (!response.ok) throw new Error('Failed to fetch terms of use');

                var data = await response.json();
                if (data && data.length > 0 && data[0].terms_of_use) {
                    renderTermsOfUse(data[0].terms_of_use, container);
                } else {
                    container.innerHTML = '<p class="legal-p">No terms of use available.</p>';
                }
            } catch (error) {
                console.error('[Terms] Error:', error);
                container.innerHTML = '<p class="legal-p">Unable to load terms of use. Please try again later.</p>';
            }
        })();

        function renderTermsOfUse(termsData, container) {
            var header = termsData.header;
            var effectiveDate = termsData.effective_date;
            var lastUpdated = termsData.last_updated;
            var sections = termsData.sections;

            var effectiveDateEl = document.getElementById('terms-effective-date');
            var lastUpdatedEl = document.getElementById('terms-last-updated');
            if (effectiveDateEl) effectiveDateEl.textContent = 'Effective Date: ' + effectiveDate;
            if (lastUpdatedEl) lastUpdatedEl.textContent = 'Last Updated: ' + lastUpdated;

            var html = '<p class="legal-p legal-lead">' + header + '</p>';

            sections.forEach(function(section) {
                html += '<h2 class="legal-h2">' + section.section_number + '. ' + section.section_title + '</h2>';

                section.content.forEach(function(item) {
                    if (item.subsection) {
                        html += '<p><strong>' + item.subsection + ' ' + item.title + '.</strong> ' + item.text + '</p>';
                    } else {
                        html += '<p class="legal-p">' + item.text + '</p>';
                    }
                });
            });

            container.innerHTML = html;
        }
    </script>
</SiteLayout>

<style is:global>
    /* Legal pages: DB-driven copy rendered by the script above into
       .legal-content. Section heads may contain anything, so never Designer. */
    .legal-head { text-align: center; margin-bottom: var(--sp-6); }
    .legal-head .v-h1 { margin: 0 0 12px; }
    .legal-head .v-path { margin: 0; }

    .legal-content { text-align: left; }
    .legal-content .legal-block { margin-bottom: 32px; }
    .legal-content .legal-block:last-child { margin-bottom: 0; }
    .legal-content > p:first-child { margin-top: 0; }

    .legal-content p,
    .legal-content .legal-p {
        font: 400 var(--fs-body)/1.6 var(--font-body);
        color: var(--ink-body);
        margin: 0 0 12px;
    }
    .legal-content .legal-lead { margin-bottom: 24px; }

    .legal-content .legal-h2 {
        font: 700 18px/1.3 var(--font-body);
        color: #fff;
        margin: 32px 0 12px;
    }
    .legal-content .legal-block > .legal-h2:first-child,
    .legal-content > .legal-h2:first-child { margin-top: 0; }

    .legal-content .legal-h3 {
        font: 600 16px/1.35 var(--font-body);
        color: #fff;
        margin: 16px 0 6px;
    }

    .legal-content strong { color: #fff; font-weight: 600; }

    .legal-content .legal-ul {
        list-style: none;
        margin: 0 0 12px;
        padding: 0;
    }
    .legal-content .legal-li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 8px;
        font: 400 var(--fs-body)/1.6 var(--font-body);
        color: var(--ink-body);
    }
    .legal-content .legal-li::before {
        content: "";
        position: absolute;
        left: 2px;
        top: calc(0.8em - 2.5px);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--lemon-lime);
    }

    .legal-content a { color: var(--electric-blue); text-decoration: none; }
    @media (hover: hover) {
        .legal-content a:hover { text-decoration: underline; text-underline-offset: 3px; }
    }
</style>
