---
// VOLI's Terms of Use. Rendered on each request from the database, so it is
// the same document the app shows and is complete in the HTML for anyone
// reading without scripts: search engines, AI crawlers and app-store reviewers
// included. A short CDN cache (60 s) keeps a burst off the database; a failed
// or malformed fetch answers 503, is never cached, and never shows an old copy.
// The fetch and the text-to-HTML conversion live in lib/legal-docs.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/legal.css';
import GetApp from '../components/pearl/kit/GetApp.astro';
import Sheet from '../components/pearl/kit/Sheet.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import { currentLegalDoc, docDate, legalHtml, type LegalDoc } from '../lib/legal-docs';
import { SITE_URL } from '../lib/site';

export const prerender = false;

let doc: LegalDoc | null = null;
try {
  doc = await currentLegalDoc('terms');
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60');
} catch (e) {
  console.error('[terms]', e);
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const url = `${SITE_URL}/terms`;
const isIso = (d?: string) => !!d && /^\d{4}-\d{2}-\d{2}$/.test(d);
// Each date stays whole on one line; a narrow screen breaks between the two.
const meta = [
  doc?.effective_date && `Effective ${docDate(doc.effective_date)}`,
  doc?.last_updated && `Last updated ${docDate(doc.last_updated)}`,
].filter((m): m is string => !!m);

const subnav = {
  label: 'Legal',
  items: [
    { href: '/privacy', label: 'Privacy' },
    { href: '/terms', label: 'Terms', current: true },
    { href: '/bracket/rules', label: 'Bracket rules' },
  ],
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: 'Terms of Use',
    description: 'The Terms of Use of VOLI: The Volleyball Hub, the app, the website and related services.',
    dateModified: isIso(doc?.last_updated) ? doc?.last_updated : undefined,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VOLI', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Terms of Use', item: url },
    ],
  },
];
---

<Pearl
  title="Terms of Use | VOLI"
  description="The Terms of Use for the free VOLI volleyball app for iPhone and Android and this site: eligibility, accounts, fantasy rules, conduct, content and disputes."
  subnav={subnav}
  schema={schema}
>
    <Sheet color="lime" label="VOLI: The Volleyball Hub" title={['Terms', 'of use']} em="Terms" meta={meta} toc>
        <Fragment slot="lede">
            <p>The rules for using the VOLI app, this website and related services: who can use them, your account, fantasy rules, community conduct, your content and how disputes are settled.</p>
            <p class="body">Read them with the <a class="link" href="/privacy">Privacy Policy</a>. The College Volleyball Bracket Challenge has its own <a class="link" href="/bracket/rules">Official Rules</a>.</p>
            <Stores />
        </Fragment>
        {doc ? (
            <Fragment set:html={legalHtml('terms', doc)} />
        ) : (
            <p class="lead">The Terms of Use could not be loaded just now. Try again in a moment, or email <a href="mailto:support@playvoli.com">support@playvoli.com</a> for a copy.</p>
        )}
    </Sheet>

    <GetApp color="blue" links={[
      { href: '/privacy', label: 'Privacy Policy' },
      { href: '/bracket/rules', label: 'Bracket rules' },
      { href: '/fantasy', label: 'Fantasy volleyball' },
      { href: '/about', label: 'About VOLI' },
    ]} />
</Pearl>
