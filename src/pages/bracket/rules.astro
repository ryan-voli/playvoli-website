---
// Official Rules of the College Volleyball Bracket Challenge. The site
// advertises a cash prize, so the full rules have to be one tap away from
// every place that mentions it: the splash, /app and /bracket all link here.
//
// Rendered on each request from the database, like /rankings, so it is the
// same document the app shows and is complete in the HTML for anyone reading
// without scripts. A short CDN cache (60 s, no stale-while-revalidate) keeps a
// burst off the database, so a copy is never more than a minute old; a failed
// or malformed fetch answers 503, is never cached, and never shows an old copy.
//
// This address is NOT claimed by the app (the phones claim exactly /bracket),
// so it always opens in the browser.
import SiteLayout from '../../layouts/SiteLayout.astro';
import { BRACKET } from '../../lib/bracket-facts';
import { currentBracketRules, type BracketRules } from '../../lib/bracket-rules';

export const prerender = false;

let rules: BracketRules | null = null;
try {
  rules = await currentBracketRules();
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60');
} catch (e) {
  console.error('[bracket/rules]', e);
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const heading = rules?.title ?? 'Official Rules: College Volleyball Bracket Challenge';
const stamp = rules
  ? [rules.effective_date && `Effective ${rules.effective_date}`, rules.version && `Version ${rules.version}`].filter(Boolean).join(' · ')
  : '';
const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  '@id': `${BRACKET.rulesUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'VOLI', item: 'https://playvoli.com/' },
    { '@type': 'ListItem', position: 2, name: 'College Volleyball Bracket Challenge', item: BRACKET.url },
    { '@type': 'ListItem', position: 3, name: 'Official Rules', item: BRACKET.rulesUrl },
  ],
};
---

<SiteLayout
  title="Official Rules: College Volleyball Bracket Challenge 2026 | VOLI"
  description="The Official Rules of the College Volleyball Bracket Challenge, presented by VOLI: eligibility, how to enter, scoring, tiebreakers and the $500 cash prize."
  ogUrl={BRACKET.rulesUrl}
  ogImage="https://playvoli.com/images/bracket/bracket-challenge-2026-og.png"
  schema={schema}
  skipSupabase
  skipNavAuth
>
    <main class="v-page">
        <div class="v-wrap v-wrap--read">
            <p class="br-back"><a href={BRACKET.path} class="v-link"><span aria-hidden="true">&larr;</span> College Volleyball Bracket Challenge</a></p>

            <header class="legal-head">
                <h1 class="v-title-plain br-title">{heading}</h1>
                {stamp && <p class="v-path">{stamp}</p>}
            </header>

            {rules ? (
                <div class="v-card v-card--plate legal-content">
                    <p class="legal-p legal-lead">{rules.header}</p>
                    {rules.sections.map((s) => (
                        <section id={`section-${s.section_number}`}>
                            <h2 class="legal-h2">{s.section_number}. {s.section_title}</h2>
                            {s.content.map((item) =>
                                item.subsection ? (
                                    <p><strong>{item.subsection} {item.title}.</strong> {item.text}</p>
                                ) : (
                                    <p class="legal-p">{item.text}</p>
                                )
                            )}
                        </section>
                    ))}
                </div>
            ) : (
                <div class="v-card v-card--plate legal-content">
                    <p class="legal-p">The Official Rules could not be loaded just now. Please try again in a moment. They are also in the VOLI app (open the Bracket page and tap the info button at the top left), or email support@playvoli.com for a copy.</p>
                </div>
            )}

            <p class="br-foot v-meta">Questions about the contest go to <a href="mailto:support@playvoli.com" class="v-link">support@playvoli.com</a>. Back to the <a href={BRACKET.path} class="v-link">Bracket Challenge</a>.</p>
        </div>
    </main>
</SiteLayout>

<style>
    /* The legal-page look (/terms, /privacy), rendered on the server here. */
    .br-back { margin: 0 0 20px; font: 500 14px/1.3 var(--font-body); }
    .legal-head { text-align: center; margin-bottom: var(--sp-6); }
    .br-title { margin: 0 0 12px; text-wrap: balance; }
    .legal-head .v-path { margin: 0; }

    .legal-content { text-align: left; }
    .legal-content p { font: 400 var(--fs-body)/1.6 var(--font-body); color: var(--ink-body); margin: 0 0 12px; }
    .legal-content .legal-lead { margin-bottom: 24px; }
    .legal-content .legal-h2 { font: 700 18px/1.3 var(--font-body); color: #fff; margin: 32px 0 12px; scroll-margin-top: 96px; }
    .legal-content section:first-of-type .legal-h2 { margin-top: 0; }
    .legal-content section:last-child p:last-child { margin-bottom: 0; }
    .legal-content strong { color: #fff; font-weight: 600; }

    .br-foot { margin: 24px 0 0; text-align: center; }
</style>
