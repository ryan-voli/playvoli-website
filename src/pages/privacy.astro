---
import Layout from '../layouts/Layout.astro';

/*
 * READ AT BUILD TIME, so the full text is in the first HTML that crawlers and
 * readers get (it used to arrive by a browser fetch, leaving crawlers an
 * empty placeholder). Same public row, same markup as the old browser
 * renderer. The build fails rather than ship an empty legal page.
 */
const SUPABASE_URL = 'https://api.playvoli.com';
const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhjaG9sa3JqcHV6YWhxdW1hamVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDQ0MDcwMzQsImV4cCI6MjA1OTk4MzAzNH0.RVhKzZkLxwwtbow3i3tUSVVnG_hMl-q0bwuvmqNuDq0';
const res = await fetch(SUPABASE_URL + '/rest/v1/global_settings?select=privacy_policy&limit=1', {
  headers: { apikey: SUPABASE_ANON_KEY, Authorization: 'Bearer ' + SUPABASE_ANON_KEY },
});
if (!res.ok) throw new Error('privacy: global_settings read failed (' + res.status + ')');
const rows = await res.json();
const doc = rows?.[0]?.privacy_policy;
if (!doc?.sections?.length) throw new Error('privacy: no privacy_policy in global_settings');

function render(d: any): string {
  let html = '<div style="margin-bottom: 3rem;"><p>' + d.header + '</p></div>';
  for (const section of d.sections ?? []) {
    html += '<div style="margin-bottom: 3rem;">';
    html += '<div style="color: var(--electric-blue); font-size: 0.8rem; font-weight: 400; margin-bottom: 1rem; text-transform: uppercase; letter-spacing: 0.5px;">' + section.section_number + '. ' + section.section_title + '</div>';
    for (const item of section.content ?? []) {
      if (item.title) html += '<h3 style="margin-bottom: 0.5rem; font-size: 1rem; color: var(--text-primary);">' + item.title + '</h3>';
      const text = String(item.text ?? '');
      if (text.indexOf('•') !== -1) {
        const parts = text.split('•');
        if (parts[0].trim()) html += '<p>' + parts[0].trim() + '</p>';
        if (parts.length > 1) {
          html += '<ul style="margin-bottom: 1rem; padding-left: 1.5rem; color: var(--text-secondary);">';
          for (let i = 1; i < parts.length; i++) html += '<li>' + parts[i].trim() + '</li>';
          html += '</ul>';
        }
      } else {
        html += '<p>' + text + '</p>';
      }
    }
    html += '</div>';
  }
  return html;
}
const contentHtml = render(doc);
---

<Layout
  title="Privacy Policy - VOLI"
  description="VOLI's Privacy Policy - How we collect, use, and protect your information."
>
    <main class="card">
        <h1 class="title">Privacy Policy</h1>
        <p class="subtitle" id="privacy-last-updated">Last updated: {doc.last_updated}</p>

        <div class="content" id="privacy-content" set:html={contentHtml} />
    </main>
</Layout>

<style>
    body {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 5rem 2rem 2rem;
        padding-top: calc(5rem + env(safe-area-inset-top));
    }

    .card {
        width: 100%;
        max-width: 800px;
        background: var(--bg-card);
        backdrop-filter: blur(40px);
        -webkit-backdrop-filter: blur(40px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 3rem 2rem;
        position: relative;
        overflow: hidden;
        margin-top: 1rem;
    }

    .card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 1px;
        background: linear-gradient(90deg, transparent, var(--glass-highlight), transparent);
    }

    .title {
        font-size: 1.75rem;
        font-weight: 700;
        text-align: center;
        margin-bottom: 0.5rem;
        letter-spacing: -0.02em;
    }

    .subtitle {
        font-size: 0.95rem;
        font-weight: 400;
        text-align: center;
        color: var(--text-secondary);
        margin-bottom: 2rem;
    }

    .content {
        text-align: left;
        line-height: 1.8;
        color: var(--text-secondary);
    }

    .content :global(h2), .content :global(h3) {
        color: var(--text-primary);
        margin-top: 2rem;
        margin-bottom: 1rem;
        font-weight: 600;
    }

    .content :global(h2) { font-size: 1.25rem; }
    .content :global(h3) { font-size: 1.1rem; }
    .content :global(p) { margin-bottom: 1rem; }

    .content :global(ul), .content :global(ol) {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
    }

    .content :global(li) { margin-bottom: 0.5rem; }

    .content :global(a) {
        color: var(--accent);
        text-decoration: none;
    }

    .content :global(a:hover) { text-decoration: underline; }

    @media (max-width: 480px) {
        body { padding: 6rem 1rem 1rem; }
        .card { padding: 2rem 1.5rem; border-radius: 20px; }
        .title { font-size: 1.5rem; }
    }
</style>
