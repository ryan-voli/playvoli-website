---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Privacy Policy - VOLI"
  description="VOLI's Privacy Policy - How we collect, use, and protect your information."
>
    <main class="v-page">
        <div class="v-wrap v-wrap--read">
            <header class="legal-head">
                <h1 class="v-h1">Privacy Policy</h1>
                <p class="v-path" id="privacy-last-updated">Last updated: Loading...</p>
            </header>

            <div class="v-card v-card--plate legal-content" id="privacy-content">
                <p>Loading privacy policy...</p>
            </div>
        </div>
    </main>

    <script is:inline slot="scripts">
        var SUPABASE_URL = 'https://api.playvoli.com';
        var SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhjaG9sa3JqcHV6YWhxdW1hamVyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDQ0MDcwMzQsImV4cCI6MjA1OTk4MzAzNH0.RVhKzZkLxwwtbow3i3tUSVVnG_hMl-q0bwuvmqNuDq0';

        (async function() {
            var container = document.getElementById('privacy-content');
            if (!container) return;

            try {
                var response = await fetch(SUPABASE_URL + '/rest/v1/global_settings?select=privacy_policy&limit=1', {
                    headers: {
                        'apikey': SUPABASE_ANON_KEY,
                        'Authorization': 'Bearer ' + SUPABASE_ANON_KEY
                    }
                });

                if (!response.ok) throw new Error('Failed to fetch privacy policy');

                var data = await response.json();
                if (data && data.length > 0 && data[0].privacy_policy) {
                    renderPrivacyPolicy(data[0].privacy_policy, container);
                } else {
                    container.innerHTML = '<p class="legal-p">No privacy policy available.</p>';
                }
            } catch (error) {
                console.error('[Privacy] Error:', error);
                container.innerHTML = '<p class="legal-p">Unable to load privacy policy. Please try again later.</p>';
            }
        })();

        function renderPrivacyPolicy(privacyData, container) {
            var header = privacyData.header;
            var lastUpdated = privacyData.last_updated;
            var sections = privacyData.sections;

            var lastUpdatedEl = document.getElementById('privacy-last-updated');
            if (lastUpdatedEl) lastUpdatedEl.textContent = 'Last updated: ' + lastUpdated;

            var html = '<div class="legal-block"><p class="legal-p">' + header + '</p></div>';

            sections.forEach(function(section) {
                html += '<div class="legal-block">';
                html += '<div class="legal-h2">' + section.section_number + '. ' + section.section_title + '</div>';

                section.content.forEach(function(item) {
                    if (item.title) {
                        html += '<h3 class="legal-h3">' + item.title + '</h3>';
                    }

                    if (item.text.indexOf('\u2022') !== -1) {
                        var parts = item.text.split('\u2022');
                        if (parts[0].trim()) {
                            html += '<p class="legal-p">' + parts[0].trim() + '</p>';
                        }
                        if (parts.length > 1) {
                            html += '<ul class="legal-ul">';
                            for (var i = 1; i < parts.length; i++) {
                                html += '<li class="legal-li">' + parts[i].trim() + '</li>';
                            }
                            html += '</ul>';
                        }
                    } else {
                        html += '<p class="legal-p">' + item.text + '</p>';
                    }
                });

                html += '</div>';
            });

            container.innerHTML = html;
        }
    </script>
</SiteLayout>

<style is:global>
    /* Legal pages: DB-driven copy rendered by the script above into
       .legal-content. Section heads may contain anything, so never Designer. */
    .legal-head { text-align: center; margin-bottom: var(--sp-6); }
    .legal-head .v-h1 { margin: 0 0 12px; }
    .legal-head .v-path { margin: 0; }

    .legal-content { text-align: left; }
    .legal-content .legal-block { margin-bottom: 32px; }
    .legal-content .legal-block:last-child { margin-bottom: 0; }
    .legal-content > p:first-child { margin-top: 0; }

    .legal-content p,
    .legal-content .legal-p {
        font: 400 var(--fs-body)/1.6 var(--font-body);
        color: var(--ink-body);
        margin: 0 0 12px;
    }
    .legal-content .legal-lead { margin-bottom: 24px; }

    .legal-content .legal-h2 {
        font: 700 18px/1.3 var(--font-body);
        color: #fff;
        margin: 32px 0 12px;
    }
    .legal-content .legal-block > .legal-h2:first-child,
    .legal-content > .legal-h2:first-child { margin-top: 0; }

    .legal-content .legal-h3 {
        font: 600 16px/1.35 var(--font-body);
        color: #fff;
        margin: 16px 0 6px;
    }

    .legal-content strong { color: #fff; font-weight: 600; }

    .legal-content .legal-ul {
        list-style: none;
        margin: 0 0 12px;
        padding: 0;
    }
    .legal-content .legal-li {
        position: relative;
        padding-left: 18px;
        margin-bottom: 8px;
        font: 400 var(--fs-body)/1.6 var(--font-body);
        color: var(--ink-body);
    }
    .legal-content .legal-li::before {
        content: "";
        position: absolute;
        left: 2px;
        top: calc(0.8em - 2.5px);
        width: 5px;
        height: 5px;
        border-radius: 50%;
        background: var(--lemon-lime);
    }

    .legal-content a { color: var(--electric-blue); text-decoration: none; }
    @media (hover: hover) {
        .legal-content a:hover { text-decoration: underline; text-underline-offset: 3px; }
    }
</style>
