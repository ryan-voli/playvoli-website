---
// VOLI's privacy policy. Rendered on each request from the database, so it is
// the same document the app shows and is complete in the HTML for anyone
// reading without scripts: search engines, AI crawlers and app-store reviewers
// included. A short CDN cache (60 s) keeps a burst off the database; a failed
// or malformed fetch answers 503, is never cached, and never shows an old copy.
// The fetch and the text-to-HTML conversion live in lib/legal-docs.
import Pearl from '../layouts/Pearl.astro';
import '../styles/pearl/pages/legal.css';
import GetApp from '../components/pearl/kit/GetApp.astro';
import Sheet from '../components/pearl/kit/Sheet.astro';
import Stores from '../components/pearl/kit/Stores.astro';
import { currentLegalDoc, docDate, legalHtml, type LegalDoc } from '../lib/legal-docs';
import { SITE_URL } from '../lib/site';

export const prerender = false;

let doc: LegalDoc | null = null;
try {
  doc = await currentLegalDoc('privacy');
  Astro.response.headers.set('Cache-Control', 'public, max-age=0, s-maxage=60');
} catch (e) {
  console.error('[privacy]', e);
  Astro.response.status = 503;
  Astro.response.headers.set('Cache-Control', 'no-store');
}

const url = `${SITE_URL}/privacy`;
const updated = doc?.last_updated;
const iso = updated && /^\d{4}-\d{2}-\d{2}$/.test(updated) ? updated : undefined;

const subnav = {
  label: 'Legal',
  items: [
    { href: '/privacy', label: 'Privacy', current: true },
    { href: '/terms', label: 'Terms' },
    { href: '/bracket/rules', label: 'Bracket rules' },
  ],
};

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${url}#webpage`,
    url,
    name: 'Privacy Policy',
    description: 'The privacy policy of VOLI: The Volleyball Hub, the app, the website and related services.',
    dateModified: iso,
    isPartOf: { '@id': `${SITE_URL}/#website` },
    publisher: { '@id': `${SITE_URL}/#organization` },
    inLanguage: 'en-US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    '@id': `${url}#breadcrumb`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'VOLI', item: `${SITE_URL}/` },
      { '@type': 'ListItem', position: 2, name: 'Privacy Policy', item: url },
    ],
  },
];
---

<Pearl
  title="Privacy Policy | VOLI"
  description="How VOLI collects, uses, shares and protects your information in the free VOLI volleyball app for iPhone and Android and on this site, and your rights."
  subnav={subnav}
  schema={schema}
>
    <Sheet color="blue" label="VOLI: The Volleyball Hub" title={['Privacy', 'policy']} meta={updated ? `Last updated ${docDate(updated)}` : undefined} toc>
        <Fragment slot="lede">
            <p>How VOLI collects, uses, shares and protects your information when you use the VOLI app, this website and related services, and the rights you have over it.</p>
            <p class="body">Read it with the <a class="link" href="/terms">Terms of Use</a>. Questions go to <a class="link" href="mailto:support@playvoli.com">support@playvoli.com</a> or see the other ways to <a class="link" href="/about#contact">contact the VOLI team</a>.</p>
            <Stores />
        </Fragment>
        {doc ? (
            <Fragment set:html={legalHtml('privacy', doc)} />
        ) : (
            <p class="lead">The privacy policy could not be loaded just now. Try again in a moment, or email <a href="mailto:support@playvoli.com">support@playvoli.com</a> for a copy.</p>
        )}
    </Sheet>

    <GetApp links={[
      { href: '/terms', label: 'Terms of Use' },
      { href: '/bracket/rules', label: 'Bracket rules' },
      { href: '/about', label: 'About VOLI' },
      { href: '/about#contact', label: 'Contact VOLI' },
    ]} />
</Pearl>
