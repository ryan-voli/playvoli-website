---
// DESIGN OPTION B, "DAYLIGHT". A complete document of its own: it shares
// nothing with Layout / SiteLayout, the site nav or footer, or site.css.
// A pale ground, a light aurora of blue, pink and purple ribbons, white glass
// cards and near-black ink. All of its CSS is styles/design/option-b.css.
//
// PREVIEW ONLY. Every page carries noindex, and the canonical points at the
// real address the page would take over (https://playvoli.com/ and /bracket).
// Analytics are left out of the preview on purpose; they go back in at launch.
import '../../styles/design/option-b.css';

interface Props {
  title: string;
  description: string;
  /** The real address this page would live at. */
  canonical: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Page-specific JSON-LD nodes, added after the sitewide Organization + WebSite. */
  schema?: Record<string, any>[];
  page: 'home' | 'bracket';
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://playvoli.com/images/og/voli-share.jpg',
  ogImageAlt = 'VOLI, the volleyball hub',
  schema = [],
  page,
} = Astro.props;

// Inside the preview, "home" and the Bracket Challenge are this direction's
// own two pages. At launch these become '/' and '/bracket'.
const HOME = '/design/b/';

// The same sitewide nodes the live layout sends, so every @id the page
// schema points at (#organization, #website) still resolves.
const siteSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': 'https://playvoli.com/#organization',
    name: 'VOLI LLC',
    alternateName: 'VOLI',
    url: 'https://playvoli.com',
    logo: 'https://playvoli.com/images/official_logo_dark_bg.webp',
    description:
      "VOLI is the comprehensive volleyball hub for professional and college volleyball fans in the United States — fantasy leagues, real-time stats, live game tracking, player profiles, podcasts, and community features for MLV, LOVB, and NCAA women's volleyball. Independent, built by volleyball fans for volleyball fans.",
    founder: [
      { '@type': 'Person', name: 'Ryan', jobTitle: 'Founder' },
      { '@type': 'Person', name: 'Max', jobTitle: 'Co-Founder' },
    ],
    knowsAbout: ['Volleyball', 'Professional Volleyball', "NCAA Women's Volleyball", 'Fantasy Sports', 'Sports Analytics', 'Live Sports Statistics', 'MLV', 'LOVB', 'Major League Volleyball', 'League One Volleyball'],
    areaServed: 'US',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': 'https://playvoli.com/#website',
    url: 'https://playvoli.com',
    name: 'VOLI - The Volleyball Hub',
    description: 'The comprehensive volleyball hub: fantasy leagues, live stats, player profiles, and community for MLV, LOVB, and NCAA volleyball.',
    publisher: { '@id': 'https://playvoli.com/#organization' },
    inLanguage: 'en-US',
  },
];
const allSchema = [...siteSchema, ...schema];

// Every link in components/SiteFooter.astro, at its real address, with one
// change: "App" was /app, the overview this home page replaces, so it points
// home (HOME here, '/' at launch) instead of at an address due to redirect.
const footer = [
  {
    title: 'VOLI',
    links: [
      ['/about', 'About'], [HOME, 'App'], ['/bracket', 'Bracket Challenge'], ['/rankings', 'VOLI Top 100'],
      ['/faq', 'FAQ'], ['/methods', 'How It Works'], ['/contact', 'Contact'], ['/whats-next', "What's Next"],
    ],
  },
  {
    title: 'Products',
    links: [['/discordbot', 'Discord Bot'], ['/creatorscourt', 'Creators Court'], ['/dailygrid', 'Daily Grid'], ['/redditdailygrid', 'Reddit Daily Grid']],
  },
  {
    title: 'Partners',
    href: '/partners',
    links: [['/volleytalk', 'Volley Talk'], ['/mlm', 'Major League Minute'], ['/evollve', 'EVOLLVE'], ['/cvt', 'College Volleyball Transfers']],
  },
  { title: 'Legal', links: [['/privacy', 'Privacy'], ['/terms', 'Terms']] },
];
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <title>{title}</title>
    <meta name="description" content={description}>
    {/* A design preview: keep it out of search. The canonical is the real page. */}
    <meta name="robots" content="noindex">
    <link rel="canonical" href={canonical}>

    <meta property="og:type" content="website">
    <meta property="og:site_name" content="VOLI">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content={ogImageAlt}>

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>
    <meta name="twitter:image:alt" content={ogImageAlt}>

    <meta name="theme-color" content="#F1F2F6">
    <meta name="color-scheme" content="light">
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png">
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/Designer.otf" as="font" type="font/otf" crossorigin>

    <script type="application/ld+json" set:html={JSON.stringify(allSchema)} />
    <slot name="head" />
</head>
<body class={`b-page b-page--${page}`}>
    <a class="b-skip" href="#main">Skip to content</a>

    {/* The aurora: ribbons painted with CSS gradients, one scene per block,
        scrolling with the page. No filters, no images but a 96px grain tile.
        Twenty scenes reach the foot of the longest page on the narrowest
        phone (a scene is 930px tall there); the page clips any it has no use for. */}
    <div class="b-aurora" aria-hidden="true">{Array.from({ length: 20 }, () => <i></i>)}</div>

    <header class="b-header">
        <div class="b-nav b-glass">
            <a class="b-nav__logo" href={HOME} aria-label="VOLI home">
                <img src="/images/official_logo_light_text.webp" alt="" width="88" height="44" decoding="async">
            </a>
            <nav class="b-nav__links" aria-label="Main">
                <a href="/about">About</a>
                <a href="/rankings">Top 100</a>
                <a href="/contact">Contact</a>
            </nav>
            <a class="b-btn b-btn--lime b-nav__dl" href="/download" aria-label="Download the VOLI app">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12"/><path d="m7 10 5 5 5-5"/><path d="M5 20h14"/></svg>
                <span>Download</span>
            </a>
        </div>
    </header>

    <main id="main">
        <slot />
    </main>

    <footer class="b-footer">
        <div class="b-wrap">
            <div class="b-footer__top">
                <div class="b-footer__brand">
                    <a href={HOME} aria-label="VOLI home"><img src="/images/official_logo_light_text.webp" alt="" width="120" height="60" loading="lazy" decoding="async"></a>
                    <p>The volleyball app. Fantasy, live games, stats, rankings, history, news and podcasts. Free on iPhone and Android.</p>
                </div>
                <nav class="b-footer__cols" aria-label="Site">
                    {footer.map((col) => (
                        <div class="b-footer__col">
                            {col.href
                                ? <p class="b-footer__title"><a href={col.href}>{col.title}</a></p>
                                : <p class="b-footer__title">{col.title}</p>}
                            <ul role="list">
                                {col.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}
                            </ul>
                        </div>
                    ))}
                </nav>
            </div>
            <div class="b-footer__base">
                <p>&copy; 2026 VOLI LLC. All rights reserved.</p>
                <ul class="b-social" role="list">
                    <li><a href="https://instagram.com/playvoli" target="_blank" rel="noopener" aria-label="VOLI on Instagram">
