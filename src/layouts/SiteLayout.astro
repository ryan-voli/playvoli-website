---
// The account and Daily Grid pages' layout, in the VOLI light system (Pearl).
// It still WRAPS the frozen Layout.astro, which oauth-callback uses directly
// and must keep byte-for-byte: Layout keeps the head these pages have always
// had (title, description, OG, schema, analytics), the Supabase SDK, NavAuth
// and the scripts slot. On top of it this layout paints the Pearl ground and
// renders the Pearl menu, the closing Get the app block and the Pearl footer.
// Do not fork or edit Layout: any change to its import graph changes the
// built oauth-callback page. Layout's frozen Nav still renders (hidden here,
// see account.css); its #nav-auth stays the slot NavAuth and the Daily Grid
// write into.
import Layout from './Layout.astro';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import '../styles/pearl/system.css';
import '../styles/pearl/kit.css';
import '../styles/pearl/motion.css';
import '../styles/pearl/pages/account.css';
import Menu from '../components/pearl/Menu.astro';
import GetApp from '../components/pearl/GetApp.astro';
import Footer from '../components/pearl/Footer.astro';
import { STORE } from '../lib/voli-facts';
import type { Subnav } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogUrl?: string;
  activePage?: string;
  showFooter?: boolean;
  bodyClass?: string;
  /** Set to true for pages that load Supabase SDK themselves */
  skipSupabase?: boolean;
  /** Set to true for pages that don't need the nav auth slot */
  skipNavAuth?: boolean;
  /** Page-specific Schema.org JSON-LD; merged with sitewide Organization + WebSite schema */
  schema?: Record<string, any> | Record<string, any>[];
  /** false = no menu, no Get the app block and no footer */
  chrome?: boolean;
  /** The menu's second row. Default: the main pages, as on the 404 page. */
  subnav?: Subnav;
  /** Keep the page out of search (sign-in, account pages). */
  noindex?: boolean;
}

// The link-preview image for every site page (owner, 24 Oct 2026). Set here,
// not in the frozen Layout, so oauth-callback's built output never changes.
const SHARE_IMAGE = 'https://playvoli.com/images/og/voli-share.jpg';

const MAIN_PAGES_SUBNAV: Subnav = {
  label: 'Main pages',
  items: [
    { href: '/', label: 'Home' },
    { href: '/fantasy', label: 'Fantasy' },
    { href: '/rankings', label: 'Top 100' },
  ],
};

const {
  bodyClass = '',
  chrome = true,
  showFooter = true,
  activePage = '',
  ogImage = SHARE_IMAGE,
  subnav = MAIN_PAGES_SUBNAV,
  noindex = false,
  ...rest
} = Astro.props;

// One canonical address per page (playvoli.com, no trailing slash), so a
// preview copy, a trailing slash or a ?query never splits a page in search.
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = canonicalPath === '/404' ? null : `https://playvoli.com${canonicalPath}`;
---

<Layout {...rest} ogImage={ogImage} activePage={activePage} showFooter={false} bodyClass={('site pearl ' + bodyClass).trim()}>
  <link rel="preload" href="/fonts/Designer.otf" as="font" type="font/otf" crossorigin slot="head" />
  {canonical && !noindex && <link rel="canonical" href={canonical} slot="head" />}
  {noindex && <meta name="robots" content="noindex, follow" slot="head" />}
  <meta name="theme-color" content="#F1F2F6" slot="head" />
  <meta name="color-scheme" content="light" slot="head" />
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap" slot="head" />
  <slot name="head" slot="head" />

  <a class="skip" href="#main">Skip to content</a>
  {chrome && <Menu subnav={subnav} path={canonicalPath} />}

  <div id="main" class="acct-main">
    <slot />
  </div>

  {chrome && showFooter && <GetApp />}
  {chrome && showFooter && <Footer />}

  {/* The Get the app links jump to the store buttons in the closing block. On
      a phone they go straight to that phone's store instead. */}
  <script is:inline define:vars={{ ios: STORE.ios, android: STORE.android }}>
    (function () {
      var ua = navigator.userAgent || '';
      var to = /iPhone|iPad|iPod/.test(ua) ? ios : /Android/.test(ua) ? android : '';
      if (to) document.querySelectorAll('[data-get]').forEach(function (a) { a.setAttribute('href', to); });
    })();
  </script>
  {/* One click counter: data-track="category:label" on a link or a button. */}
  <script is:inline>
    document.addEventListener('click', function (e) {
      var el = e.target && e.target.closest ? e.target.closest('[data-track]') : null;
      if (!el) return;
      var t = el.getAttribute('data-track').split(':');
      try { gtag('event', 'click', { event_category: t[0], event_label: t.slice(1).join(':') }); } catch (err) {}
    });
  </script>

  {/* Vercel Web Analytics and Speed Insights. Here, not in the frozen Layout,
      so oauth-callback's built page never changes. */}
  <Analytics />
  <SpeedInsights />

  <slot name="scripts" slot="scripts" />
</Layout>
